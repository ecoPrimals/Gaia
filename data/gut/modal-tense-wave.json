    },
    "interference_pattern": "All 35 crons firing at different frequencies create a STANDING WAVE. The wave IS the organism's temporal signature.",
    "phase_groups": {
      "heartbeat_band": {"freq": "2-3 min", "crons": 4, "tense": "IS", "role": "alive check"},
