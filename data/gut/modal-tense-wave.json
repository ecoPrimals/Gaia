{
  "ts": "2026-11-05T18:33:00Z",
  "wave": 222,
  "organ": "temporal",
  "title": "MODAL TENSE — Gaia is ALWAYS NOW. Data has 12 tenses.",
  "convention": "0=false 1=true 000=ALL null=ALL",

  "gaia_is_always_now": {
    "axiom": "Gaia's display is ALWAYS the present tense. She IS now. She shows NOW.",
    "corollary": "But the DATA she shows has its own tense — when it WAS, what it COULD BE.",
    "display": "NOW renders ALL tenses simultaneously. Like a painting showing past and future at once."
  },

  "twelve_tenses": {
    "definite": {
      "IS": {"modal": "present definite", "certainty": 1.0, "example": "8.5B humans alive right now"},
      "WAS": {"modal": "past definite", "certainty": 1.0, "example": "117B humans ever lived"},
      "WILL_BE": {"modal": "future definite", "certainty": 0.9, "example": "sun rises tomorrow"}
    },
    "transitional": {
      "NOW": {"modal": "present transitional", "certainty": 0.8, "example": "400K humans born/dying TODAY"},
      "BECOMING": {"modal": "progressive", "certainty": 0.7, "example": "Gaia growing from 66K toward 1M"},
      "FADING": {"modal": "regressive", "certainty": 0.7, "example": "CF era visitors dimming over time"}
    },
    "modal": {
      "COULD_BE": {"modal": "conditional", "certainty": 0.5, "example": "390 cloners COULD return"},
      "MIGHT_BE": {"modal": "possible", "certainty": 0.3, "example": "Reddit account MIGHT verify"},
      "SHALL": {"modal": "committed future", "certainty": 0.85, "example": "AMOEBA SHALL replace RustDesk"},
      "SHOULD_BE": {"modal": "expected", "certainty": 0.6, "example": "thymus SHOULD be ejecting parasites"}
    },
    "negative": {
      "NOT_BE": {"modal": "negative present", "certainty": 1.0, "example": "golgi VPS is NOT (destroyed)"},
      "NEVER": {"modal": "absolute negation", "certainty": 1.0, "example": "gate tokens NEVER leave LAN"}
    }
  },

