[node name="Screenshotter" type="Node" parent="." node_paths=PackedStringArray("controlsToHide")]
script = ExtResource("141")
controlsToHide = [NodePath("../ScreenSpaceUI/DebugButtons")]

[connection signal="pressed" from="ScreenSpaceUI/GameHUD/PopupManager/PopupDebugTestButtons/DebugToggleTitle" to="ScreenSpaceUI/GameHUD/PopupManager" method="DebugToggleTitlePopup"]
[connection signal="pressed" from="ScreenSpaceUI/GameHUD/PopupManager/PopupDebugTestButtons/DebugToggleIntercom" to="ScreenSpaceUI/GameHUD/PopupManager" method="DebugToggleIntercomPopup"]
[connection signal="pressed" from="ScreenSpaceUI/GameHUD/PopupManager/PopupDebugTestButtons/DebugToggleNotebook" to="ScreenSpaceUI/GameHUD/PopupManager" method="DebugToggleNotebookPopup"]
[connection signal="pressed" from="ScreenSpaceUI/DebugButtons/DebugLightsToggleButton" to="Room3D/LightsController" method="DebugToggleLights"]
[connection signal="pressed" from="ScreenSpaceUI/DebugButtons/DebugScreenToggleButton" to="Room3D/Machine" method="DebugToggleScreen"]
[connection signal="pressed" from="ScreenSpaceUI/DebugButtons/DebugUnredactButton" to="StoryController" method="DebugUnredactCard"]
[connection signal="pressed" from="ScreenSpaceUI/DebugButtons/DebugShowSplash" to="ScreenSpaceUI/TitleSplashScreen" method="ShowSplash"]
[connection signal="pressed" from="ScreenSpaceUI/DebugButtons/DebugShowCredits" to="ScreenSpaceUI/Credits" method="DebugShowCredits"]
[connection signal="pressed" from="ScreenSpaceUI/DebugButtons/DebugShowScreenRipple" to="Room3D/Machine" method="RippleScreen"]
[connection signal="value_changed" from="ScreenSpaceUI/DebugButtons/DebugCameraPos/VBoxContainer/HSlider" to="Room3D/Camera3D" method="SetDebugPosition"]

