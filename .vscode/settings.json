{
  "git.autoRepositoryDetection": false,
  "git.scanRepositories": [],
  "git.enabled": false,
  "search.followSymlinks": false,
  "files.maxMemoryForLargeFilesMB": 128,
  "extensions.autoUpdate": false,
  "files.watcherExclude": {
    "**/.git/**": true,
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/data/**": true,
    "primals/**": true,
    "springs/**": true,
    "gardens/**": true,
    "protists/**": true,
    "infra/**": true
  },
  "files.exclude": {
    "primals/**": true,
    "springs/**": true,
    "gardens/**": true,
    "protists/**": true,
    "infra/agentReagents/**": true,
    "infra/sporePrint/**": true,
    "infra/fossilRecord/**": true,
    "infra/whitePaper/**": true,
    "infra/plasmidBin/**": true,
    "infra/benchScale/**": true,
    "infra/wateringHole/**": true,
    "infra/detroit/**": true,
    "**/target": true,
    "**/node_modules": true,
    "**/.git": true
  },
  "search.exclude": {
    "**/.git/**": true,
    "**/target/**": true,
    "**/node_modules/**": true,
    "**/data/**": true,
    "primals/**": true,
    "springs/**": true,
    "gardens/**": true,
    "protists/**": true,
    "infra/**": true
  }
}
