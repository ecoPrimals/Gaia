<p>TALOS patrols. scyBorg bites. tuebor illuminates. lub-DUB 🧬</p>
</div>
</body></html>"""
        self._text(html, "text/html")
    
    def _json(self, obj):
        data = json.dumps(obj, indent=2, default=str).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("X-Guardian", "TALOS")
        self.end_headers()
        self.wfile.write(data)
    
    def _text(self, content, ct):
        data = content.encode() if isinstance(content, str) else content
        self.send_response(200)
        self.send_header("Content-Type", ct + "; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("X-Guardian", "TALOS")
        self.end_headers()
        self.wfile.write(data)
    
    def log_message(self, fmt, *args):
        pass


# ═══ Patrol Timer — three patrols, circling the island ═══

def patrol_loop(talos):
    """TALOS circles the island three times daily.
    For dev: patrol every 5 minutes in rotation.
    """
    patrols = [talos.patrol_shore, talos.patrol_harbor, talos.patrol_citadel]
    idx = 0
    while True:
        time.sleep(300)  # 5 minutes
        patrol = patrols[idx % 3]
        result = patrol()
        print(f"  🛡️ TALOS patrol: {result.get('patrol', '?')} — depth={talos.minotaur.maze_depth}", flush=True)
        idx += 1


# ═══ webpi launcher — serve all sites ═══

def start_webpi():
    """Start webpi.pi in a subprocess."""
    import subprocess
    webpi = GAIA_ROOT / "runtime" / "webpi.pi"
    proc = subprocess.Popen(
        ["python", str(webpi)],
        cwd=str(GAIA_ROOT),
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )
    print(f"  📡 webpi.pi started (pid {proc.pid}) — serving all subdomains on :8080", flush=True)
    return proc


def main():
    import argparse
    p = argparse.ArgumentParser(description="TALOS — Convergence Guardian + Minotaur Labyrinth")
    p.add_argument("--webpi", action="store_true", help="Also start webpi.pi for full serving")
    p.add_argument("--port", type=int, default=8443, help="TALOS patrol API port")
    args = p.parse_args()
    
    minotaur = Minotaur()
    talos = TALOS(minotaur)
    
    TALOSHandler.minotaur = minotaur
    TALOSHandler.talos = talos
    
    print(f"\n═══ TALOS — Convergence Guardian ═══", flush=True)
    print(f"  🛡️ TALOS: patrolling on :{args.port}", flush=True)
    print(f"  🐂 Minotaur: labyrinth active", flush=True)
    print(f"  🎲 bingoMaze: structural proximity online", flush=True)
    print(f"  📖 Thesis: 'Stomachs With No Eyes' — 16 chapters", flush=True)
    
    if args.webpi:
        webpi_proc = start_webpi()
        print(f"  📡 webpi: all subdomains on :8080", flush=True)
    
    # Start patrol loop in background
    patrol_thread = threading.Thread(target=patrol_loop, args=(talos,), daemon=True)
    patrol_thread.start()
    print(f"  ⏱️ Patrols: every 5 minutes (shore → harbor → citadel)", flush=True)
    
    # Initial patrols
    talos.patrol_shore()
    talos.patrol_citadel()
    print(f"  ✅ Initial patrols complete. TALOS is live.", flush=True)
    print(f"\n  The shore is guarded. The maze awaits. lub-DUB. 🧬\n", flush=True)
    
    server = http.server.HTTPServer(("0.0.0.0", args.port), TALOSHandler)
    server.serve_forever()


if __name__ == "__main__":
    main()
