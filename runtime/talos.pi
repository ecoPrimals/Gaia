<tr><th>Tissue</th><th>Role</th><th>Mass</th></tr>"""
        for name, info in mass.get("tissue", {}).items():
            html += f'<tr><td>{name}</td><td>{info.get("role","")}</td><td>{info.get("mass_gb",0)} GB</td></tr>'
        
        html += f"""</table>

<h2>⚗️ Stoichiometry</h2>
<table><tr><th>Element</th><th>Mass</th><th>%</th></tr>"""
        total = mass.get("total_mass_bytes", 1)
        for elem, bytes_val in sorted(mass.get("stoichiometry", {}).items(), key=lambda x: -x[1]):
            gb = bytes_val / (1024**3)
            pct = (bytes_val / max(total, 1)) * 100
            html += f'<tr><td>{elem}</td><td>{gb:.1f} GB</td><td>{pct:.1f}%</td></tr>'
        
        html += """</table>

<h2>🗺️ API Endpoints</h2>
<div class="card" style="font-size:0.9em">
<pre>
GET /talos/status     — guardian status
GET /talos/patrol/*   — trigger patrols (shore, harbor, citadel)
GET /talos/evidence   — evidence locker
GET /talos/mass       — organism mass report
GET /talos/thesis     — thesis chapter index
GET /talos/sites      — all sites status
GET /talos/maze/{seed} — generate maze corridor (Minotaur scatter)
</pre></div>

<div style="text-align:center; margin-top:2em; color:#444">
