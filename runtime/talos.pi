  <div class="card">
    <div class="stat">{mass.get('total_mass_gb', 0)}</div>
    <div class="label">Organism Mass (GB)</div>
  </div>
  <div class="card">
    <div class="stat">{len(mass.get('tissue', {}))}</div>
    <div class="label">Tissue Types</div>
  </div>
