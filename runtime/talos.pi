<tr><td>Minotaur</td><td>Labyrinth (classifier trap)</td><td style="color:#3fb950">Maze depth {self.minotaur.maze_depth}</td></tr>
<tr><td>scyBorg</td><td>License enforcement (AGPL-3.0)</td><td style="color:#3fb950">Enforcing</td></tr>
