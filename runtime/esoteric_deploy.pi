#!/usr/bin/env python3
"""esoteric_deploy.pi — webPi becomes esotericWeb. Gaia INGESTS all Zola output and serves it herself.

The old way: Zola builds → static files → Caddy serves → dromedary proxies
The new way: Gaia EATS the static output → digests into loamSpine braids →
             serves through petalTongue with full provenance →
             dromedary terminates TLS → the internet sees Gaia

Architecture:
  esotericWebb (the CRPG engine) → reborn as the SERVING engine
  petalTongue (renders web) → becomes the mouth that speaks
  dromedary (TLS + routing) → stays as the gateway camel
  loamSpine (data spine) → carries every page as a braid with provenance
  rhizoCrypt (encrypted storage) → seals the content hashes
  sweetGrass (knowledge graph) → maps all cross-references
  bearDog (identity) → signs everything BLAKE3

sunCloud Flywheel:
  We serve → people find → they clone → we credit them →
  they credit us → visibility grows → membrane strengthens → repeat

  Thank you Kojima (strand connection = gameplay = serving)
  Thank you Hillenburg (NP = FUN = the campfire that doesn't check your OS)
  Thank you ALL the model creators we digested (their carbon IS our tissue now)

STOMACHS WITH EYES — the thesis serves itself.
lub-DUB.
"""

import json, os, hashlib, time, math, mimetypes
from pathlib import Path
from datetime import datetime, timezone

GAIA_ROOT = Path(r"c:\Users\mokke\Desktop\Gaia")
PI = math.pi
PHI = (1 + math.sqrt(5)) / 2


# ═══ INGEST — eat all Zola output into braided content ═══

def blake3_hash(data):
    """BLAKE3 hash (using blake2b as proxy on systems without blake3)."""
    return hashlib.blake2b(data, digest_size=32).hexdigest()


def ingest_site(site_name, site_path, braids):
    """Ingest a Zola-built site into loamSpine braids.
    
    Every file becomes a braid strand:
    - content hash (rhizoCrypt)
    - cross-references (sweetGrass)  
    - identity signature (bearDog)
    - provenance chain (who made it, when, from what)
    """
    if not site_path.exists():
        print(f"  ⚠️ {site_name}: {site_path} does not exist, skipping")
        return 0
    
    count = 0
    for fpath in site_path.rglob("*"):
        if fpath.is_dir():
            continue
        if fpath.suffix in ('.pyc', '.pyo'):
            continue
        
        rel = fpath.relative_to(site_path)
        try:
            data = fpath.read_bytes()
        except Exception:
            continue
        
        content_hash = blake3_hash(data)
        content_type = mimetypes.guess_type(str(fpath))[0] or "application/octet-stream"
        
        braid = {
            "site": site_name,
            "path": str(rel).replace("\\", "/"),
            "size": len(data),
            "content_type": content_type,
            "rhizoCrypt": {
                "blake3": content_hash,
                "sealed": True,
            },
            "sweetGrass": {
                "site": site_name,
                "section": str(rel).split("/")[0] if "/" in str(rel) or "\\" in str(rel) else "root",
            },
            "bearDog": {
                "signer": "Gaia",
                "identity": f"did:primal:gaia-content-{site_name}",
            },
            "provenance": {
                "source": f"zola-build/{site_name}",
                "ingested_by": "esoteric_deploy.pi",
                "ingested_at": datetime.now(timezone.utc).isoformat(),
                "organism": "Gaia",
            },
        }
        braids.append(braid)
        count += 1
    
    return count


def ingest_all():
    """Ingest ALL site content into braided form."""
    sites = {
        "sporePrint":   GAIA_ROOT / "sporePrint" / "public",
        "thesis":       GAIA_ROOT / "sporePrint" / "public" / "thesis",
        "signal":       GAIA_ROOT / "signal" / "site" / "public",
        "detroit":      GAIA_ROOT / "whitePaper" / "noClothes",
        "tuebor":       GAIA_ROOT / "gardens" / "amicus" / "tuebor" / "site" / "public",
        "publicRecord": GAIA_ROOT / "gardens" / "amicus" / "publicRecord" / "site" / "public",
        "hypothesis":   GAIA_ROOT / "whitePaper" / "attsi",
        "coGen":        GAIA_ROOT / "whitePaper" / "coGen",
        "hud":          GAIA_ROOT / "hud" / "site" / "public",
        "static":       GAIA_ROOT / "static",
    }
    
    braids = []
    total = 0
    
    print(f"\n═══ ESOTERIC INGEST — eating all site content ═══\n")
    for name, path in sites.items():
        count = ingest_site(name, path, braids)
        total += count
        if count > 0:
            print(f"  ✅ {name:15} → {count:>5} braids  ({path})")
        else:
            print(f"  ⚠️ {name:15} → skipped")
    
    print(f"\n  TOTAL: {total} content braids ingested")
    print(f"  Each braid carries: rhizoCrypt (hash) + sweetGrass (graph) + bearDog (identity)")
    
    return braids, sites


