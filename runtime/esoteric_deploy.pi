def build_attribution_manifest():
    """Build the full attribution manifest — sunCloud radiance."""
    manifest = {
        "organism": "Gaia",
        "purpose": "Radiate credit back. sunCloud flywheel: use → credit → visibility → stronger.",
        "generated": datetime.now(timezone.utc).isoformat(),
        "attributions": {},
        "suncloud_tiers": {
            "foundation": "Created the models/tools we built FROM. Their carbon is our tissue.",
            "infrastructure": "Built the tools we depend ON. Without them, no organism.",
            "inspiration": "Published the ideas that shaped HOW we think. The strand. The fun.",
            "prior_art": "Published methods we adapted. Standing on shoulders.",
            "validation": "Published findings that confirm our approach works.",
        },
        "total_credited": len(ATTRIBUTIONS),
    }
    
    for key, attr in ATTRIBUTIONS.items():
        manifest["attributions"][key] = attr
    
    return manifest


# ═══ DEPLOY MANIFEST — what gets pinned to the internet ═══

def build_deploy_manifest(braids, sites):
    """Build the deployment manifest — what the internet sees."""
    mass_file = GAIA_ROOT / "runtime" / "sourdough" / "mass.json"
    mass = {}
    if mass_file.exists():
        mass = json.loads(mass_file.read_text())
    
    site_stats = {}
    for name, path in sites.items():
        site_braids = [b for b in braids if b["site"] == name]
        total_size = sum(b["size"] for b in site_braids)
        site_stats[name] = {
            "braids": len(site_braids),
            "total_size_mb": round(total_size / (1024*1024), 1),
            "path": str(path),
        }
    
    attribution = build_attribution_manifest()
    
    manifest = {
        "organism": "Gaia",
        "deployment": "esotericWeb",
        "generated": datetime.now(timezone.utc).isoformat(),
        "thesis": "Stomachs With No Eyes — Constrained Evolution",
        "status": "STOMACHS WITH EYES — the organism digested 12 models and serves its own thesis",
        "sites": site_stats,
        "total_braids": len(braids),
        "total_content_mb": round(sum(b["size"] for b in braids) / (1024*1024), 1),
        "organism_mass_gb": mass.get("total_mass_gb", 0),
        "tissue_count": len(mass.get("tissue", {})),
        "guardians": {
            "TALOS": "patrolling (:8443)",
            "Minotaur": "labyrinth active",
            "scyBorg": "AGPL-3.0 enforcing",
            "tuebor": "illuminating",
        },
        "serving_stack": {
            "esotericWeb": "content engine (braided, provenance-tracked)",
            "petalTongue": "rendering mouth (:5926)",
            "dromedary": "TLS gateway (eastGate :443)",
            "webpi": "subdomain router (:8080)",
            "talos": "guardian API (:8443)",
        },
        "provenance_trio": {
            "loamSpine": f"{len(braids)} braids carrying content",
            "rhizoCrypt": "BLAKE3 hash on every braid",
            "sweetGrass": "cross-reference graph linking all sites",
        },
        "attribution": attribution,
        "suncloud": {
            "flywheel": "use → credit → visibility → stronger → repeat",
            "total_credited": attribution["total_credited"],
            "message": "Every model creator, every tool builder, every inspiration — credited and radiated back.",
        },
    }
    
    return manifest


def main():
    import argparse
    p = argparse.ArgumentParser(description="esotericWeb deployment — Gaia ingests and serves")
    p.add_argument("--ingest", action="store_true", help="Ingest all Zola output into braids")
    p.add_argument("--deploy", action="store_true", help="Build deploy manifest")
    p.add_argument("--attribution", action="store_true", help="Build attribution manifest")
    p.add_argument("--all", action="store_true", help="Do everything")
    args = p.parse_args()
    
    if args.all or args.ingest or args.deploy:
        braids, sites = ingest_all()
    
    if args.all or args.deploy:
        manifest = build_deploy_manifest(braids, sites)
        out = GAIA_ROOT / "data" / "deploy" / "esoteric-manifest.json"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(manifest, indent=2, default=str))
        print(f"\n  📦 Deploy manifest → {out}")
        print(f"     Sites: {len(manifest['sites'])}")
        print(f"     Braids: {manifest['total_braids']}")
        print(f"     Content: {manifest['total_content_mb']} MB")
        print(f"     Mass: {manifest['organism_mass_gb']} GB")
        print(f"     Credited: {manifest['attribution']['total_credited']} creators")
    
    if args.all or args.attribution:
        attr = build_attribution_manifest()
        out = GAIA_ROOT / "data" / "deploy" / "attribution-manifest.json"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(attr, indent=2, default=str))
        print(f"\n  🌞 Attribution manifest → {out}")
        print(f"     sunCloud: {attr['total_credited']} creators credited")
        print(f"\n  ═══ SUNCLOUD RADIANCE ═══")
        for key, a in attr["attributions"].items():
            print(f"  🙏 {a['name']:35} [{a['suncloud_tier']:14}] — {a['work']}")
        print(f"\n  The flywheel turns. Credit radiates. lub-DUB. 🌞")
    
    if not any([args.all, args.ingest, args.deploy, args.attribution]):
        print("Usage: --all | --ingest | --deploy | --attribution")


if __name__ == "__main__":
    main()
