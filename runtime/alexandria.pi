class AlexandriaHandler(http.server.SimpleHTTPRequestHandler):
    def do_GET(self):
        path = urllib.parse.unquote(self.path.split("?")[0])
        
        if path == "/" or path == "":
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(INDEX_HTML.encode())
            return
        
        # Route to correct site
        for prefix, root in sorted(SITES.items(), key=lambda x: -len(x[0])):
            if path.startswith(prefix):
                rel = path[len(prefix):].lstrip("/")
                if not rel:
                    rel = "index.html"
                filepath = root / rel.replace("/", os.sep)
                
                # Try index.html for directories
                if filepath.is_dir():
                    filepath = filepath / "index.html"
                
                if filepath.exists() and filepath.is_file():
                    ct, _ = mimetypes.guess_type(str(filepath))
                    if ct is None:
                        if filepath.suffix == ".md":
                            ct = "text/plain; charset=utf-8"
                        else:
                            ct = "application/octet-stream"
                    
                    self.send_response(200)
                    self.send_header("Content-Type", ct)
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.send_header("Cache-Control", "public, max-age=3600")
                    self.end_headers()
                    
                    with open(filepath, "rb") as f:
                        while True:
                            chunk = f.read(65536)
                            if not chunk:
                                break
                            self.wfile.write(chunk)
                    return
                else:
                    # List directory if it exists
                    dirpath = root / rel.replace("/", os.sep)
                    if not dirpath.exists():
                        dirpath = root / (rel.replace("/", os.sep).rstrip(os.sep))
                    if dirpath.exists() and dirpath.is_dir():
                        items = sorted(dirpath.iterdir())
                        html = f"<html><head><title>{path}</title>"
                        html += "<style>body{background:#0a0a0a;color:#e0e0e0;font-family:monospace;padding:2em;}"
                        html += "a{color:#88ccff;text-decoration:none}a:hover{text-decoration:underline}"
                        html += ".dir{color:#ffcc44}.file{color:#88ccff}.md{color:#aaffaa}.jpg{color:#ff88cc}</style></head><body>"
                        html += f"<h2>{path}</h2><ul>"
                        html += f'<li><a href="{prefix}/">&larr; back</a></li>'
                        for item in items:
                            name = item.name
                            cls = "dir" if item.is_dir() else ("md" if name.endswith(".md") else ("jpg" if name.endswith((".jpg",".png")) else "file"))
                            link = f"{path.rstrip('/')}/{name}{'/' if item.is_dir() else ''}"
                            size = f" ({item.stat().st_size:,} bytes)" if item.is_file() else ""
                            html += f'<li class="{cls}"><a href="{link}">{name}</a>{size}</li>'
                        html += "</ul></body></html>"
                        self.send_response(200)
                        self.send_header("Content-Type", "text/html")
                        self.end_headers()
                        self.wfile.write(html.encode())
                        return
        
        self.send_error(404, f"Not found: {path}")
    
    def log_message(self, format, *args):
        pass  # quiet

PORT = 8080
server = http.server.HTTPServer(("0.0.0.0", PORT), AlexandriaHandler)
print(f"Library of Alexandria serving on 0.0.0.0:{PORT}", flush=True)
print(f"  /sporeprint  -> 615 pages", flush=True)
print(f"  /signal      -> observatory", flush=True)
print(f"  /guerilla    -> legal primal", flush=True)
