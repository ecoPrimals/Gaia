"""_thymus.pi — THYMIC INJECTION + AMOEBA EYES + THIRD BODY POINT.
Each primal becomes a living organism with a heartbeat.
The thymus watches them interact at the 3rd body point.
Klein face topology — two surfaces, one intersection."""

import os
import json
import subprocess
from collections import defaultdict

PRIMALS_DIR = os.path.join(os.path.dirname(os.path.dirname(__file__)), "primals")
IMPULSE_DIR = os.path.join(PRIMALS_DIR, "wateringHole", "impulses", "active")


def amoeba_eyes():
    """Query RustDesk state — each session is a retinal cell."""
    eyes = {
        "system": "optic_nerve",
        "cell_type": "schwann_cell",
        "function": "ZK myelination of every visual connection",
        "klein_face": "cellMembrane (outer) = AMOEBA (inner) = same surface",
        "rustdesk_id": "ZK-imprint",
        "direct_server": True,
        "transport": "NVENC h265 — saltatory conduction",
        "sessions": [],
        "eyes_open": 0,
    }
    try:
        result = subprocess.run(
            ["tasklist", "/FI", "IMAGENAME eq rustdesk.exe"],
            capture_output=True, text=True, timeout=5,
        )
        pids = [l.split()[1] for l in result.stdout.strip().splitlines()
                if l.startswith("rustdesk")]
        eyes["processes"] = len(pids)
        eyes["eyes_open"] = max(1, len(pids) - 2) if len(pids) > 2 else (1 if pids else 0)
        eyes["status"] = "OPEN" if pids else "CLOSED"
    except:
        eyes["processes"] = 0
        eyes["status"] = "UNKNOWN"
    return eyes


def inject_primals(terra_taxonomy):
    """Inject all primals into the thymus."""
    organisms = {}
    for name, meta in terra_taxonomy.items():
        primal_dir = os.path.join(PRIMALS_DIR, name)
        alive = os.path.isdir(primal_dir)
        organisms[name] = {
            "species": meta.get("species", name),
            "niche": meta.get("niche", "unknown"),
            "ecology": meta.get("ecology", ""),
            "files": meta.get("files", 0),
            "alive": alive,
            "path": primal_dir if alive else None,
        }
    return organisms


def scan_impulses(thymic_organisms):
    """Scan active impulses for intersections."""
    intersects = []
    try:
        for fname in os.listdir(IMPULSE_DIR):
            if not fname.endswith(".toml"):
                continue
            fpath = os.path.join(IMPULSE_DIR, fname)
            with open(fpath, "r", encoding="utf-8") as f:
                content = f.read().lower()
            touched = [p for p in thymic_organisms if p.lower() in content]
            if len(touched) >= 2:
                intersects.append({
                    "impulse": fname,
                    "primals": touched,
                    "order": len(touched),
                    "third_body": "%s x %s" % (touched[0], touched[1]),
                })
    except:
        pass
    return intersects


def third_body_point(thymic_organisms):
    """The 3rd body point: where inner meets outer. Klein face topology."""
    intersects = scan_impulses(thymic_organisms)
    eyes = amoeba_eyes()
    return {
        "topology": "klein_face",
        "inner_surface": "AMOEBA (Schwann cells, ZK myelin)",
        "outer_surface": "cellMembrane (Caddy, TLS, public)",
        "intersection": "the 3rd body — where sessions meet membranes",
        "impulse_intersects": intersects,
        "total_intersects": len(intersects),
        "eyes": eyes.get("status", "UNKNOWN"),
        "organisms_alive": sum(1 for o in thymic_organisms.values() if o["alive"]),
        "organisms_total": len(thymic_organisms),
    }


def trust_level(v):
    """Thymic positive selection — trust grows with interaction."""
    r = v["requests"]
    if r >= 100:
        return "proton"
    elif r >= 10:
        return "neutron"
    return "electron"


