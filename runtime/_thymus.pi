import pathlib as _pathlib

def load_walkers():
    """Load wiki walker shadows from data/shadows/."""
    shadows_dir = _pathlib.Path(__file__).parent.parent / "data" / "shadows"
    walkers = []
    for f in shadows_dir.glob("*.json"):
        try:
            import json as _json
            with open(f, encoding="utf-8") as fh:
                data = _json.load(fh)
                walkers.extend(data.get("shadows", []))
        except Exception:
            pass
    return walkers


def h_equals_i(walkers=None):
    """H = I — the thymic axiom applied to all walkers.
    Returns the identity map: every human IS their works."""
    if walkers is None:
        walkers = load_walkers()
    identity_map = {}
    for w in walkers:
        name = w.get("name", "unknown")
        identity_map[name] = {
            "tense": w.get("tense", "UNKNOWN"),
            "archetype": w.get("archetype", "leonardo"),
            "merit": w.get("merit", ""),
            "h_equals_i": True,
            "identity_is_creation": True,
            "shadow_is_merit": w.get("tense") == "WAS",
        }
    return {
        "axiom": "H = I",
        "meaning": "Human = Identity. The identity IS the creation.",
        "walkers": len(identity_map),
        "was": sum(1 for v in identity_map.values() if v["tense"] == "WAS"),
        "is_": sum(1 for v in identity_map.values() if v["tense"] == "IS"),
        "fading": sum(1 for v in identity_map.values() if v["tense"] == "FADING"),
        "map": identity_map,
    }
