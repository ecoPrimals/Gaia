import time as _seo_time, os as _seo_os, json as _seo_json

_REPO_SEO = _seo_os.path.dirname(_seo_os.path.dirname(_seo_os.path.abspath(__file__)))

def _live_reedit_count():
    """Count REEDit posts live — no cache, always fresh."""
    rd = _seo_os.path.join(_REPO_SEO, "data", "reedit")
    total = 0
    if _seo_os.path.isdir(rd):
        for f in _seo_os.listdir(rd):
            if f.endswith(".jsonl"):
                try:
                    with open(_seo_os.path.join(rd, f)) as fh: total += sum(1 for _ in fh)
                except: pass
    return total

def _live_route_count():
    return len(DESK_PAGES) + len(GUT_DATA)

def _live_bestiary():
    """Load tool bestiary live from JSON."""
    bf = _seo_os.path.join(_REPO_SEO, "data", "body", "tool-bestiary.json")
    try:
        with open(bf) as f: b = _seo_json.load(f)
        return b.get("total_deck", 48), b.get("total_animals", 31)
    except: return 48, 31

def _now(): return _seo_time.strftime("%Y-%m-%dT%H:%M:%SZ", _seo_time.gmtime())

def seo_robots():
    """🐑 robots.txt — LIVE. Every read = a fresh bleat."""
