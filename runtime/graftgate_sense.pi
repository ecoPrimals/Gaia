#!/usr/bin/env python3
"""graftGate Remote Sensor — eastGate reaches into graftGate to read its senses"""
import json, subprocess, hashlib, sys
from datetime import datetime, timezone

GRAFTGATE = "graftgate@192.168.4.107"

def ssh(cmd, timeout=15):
    try:
        r = subprocess.run(
            ["ssh", "-o", "StrictHostKeyChecking=no", "-o", "ConnectTimeout=5", GRAFTGATE, cmd],
            capture_output=True, text=True, timeout=timeout
        )
        return r.stdout.strip()
    except Exception as e:
        return f"ERROR: {e}"

def read_ble():
    raw = ssh("system_profiler SPBluetoothDataType 2>/dev/null")
    devices = []
    current = {}
    for line in raw.split("\n"):
        s = line.strip()
        if s.endswith(":") and "Address" not in s and "Controller" not in s:
            if current:
                devices.append(current)
            current = {"name": s.rstrip(":")}
        elif "Address:" in s:
            current["address"] = s.split("Address:")[1].strip()
        elif "Minor Type:" in s:
            current["type"] = s.split("Minor Type:")[1].strip()
    if current and "address" in current:
        devices.append(current)
    return devices

def read_arp():
    raw = ssh("arp -a 2>/dev/null")
    neighbors = []
    for line in raw.split("\n"):
        if "(" in line and ")" in line:
            ip = line.split("(")[1].split(")")[0]
            parts = line.split()
            mac = parts[3] if len(parts) > 3 else "unknown"
            neighbors.append({"ip": ip, "mac": mac})
    return neighbors

def read_bonjour():
    raw = ssh("dns-sd -B _services._dns-sd._udp local 2>/dev/null & sleep 3; kill %1 2>/dev/null; wait 2>/dev/null", timeout=10)
    services = [l.strip() for l in raw.split("\n") if l.strip() and "Add" in l]
    return services[:20]

def read_system():
    uptime = ssh("uptime")
    disk = ssh("df -h / | tail -1")
    load = ssh("sysctl -n vm.loadavg 2>/dev/null")
    temp_raw = ssh("sudo powermetrics --samplers smc -i 1 -n 1 2>/dev/null | grep -i temp | head -5")
    return {"uptime": uptime, "disk": disk, "load": load, "thermal": temp_raw}

def sense():
    ts = datetime.now(timezone.utc).isoformat()
    
    ble = read_ble()
    arp = read_arp()
    sys_info = read_system()
    
    state = {
        "ts": ts,
        "gate": "graftGate",
        "ip": "192.168.4.107",
        "hw": "Mac Mini M4, 10-core, 16GB",
        "ble_devices": ble,
        "ble_count": len(ble),
        "arp_neighbors": arp,
        "arp_count": len(arp),
        "system": sys_info,
        "fingerprint": hashlib.blake2b(f"graftGate|{ts}".encode(), digest_size=16).hexdigest(),
    }
    return state

if __name__ == "__main__":
    state = sense()
    
    out_path = "/opt/Gaia/data/gut/graftgate-sense.json"
    with open(out_path, "w") as f:
        json.dump(state, f, indent=2)
    
    log_path = "/opt/Gaia/data/neutron/graftgate-sense.jsonl"
    with open(log_path, "a") as f:
        f.write(json.dumps({"ts": state["ts"], "ble": state["ble_count"], "arp": state["arp_count"]}) + "\n")
    
    if "--quiet" not in sys.argv:
        print(json.dumps(state, indent=2))
