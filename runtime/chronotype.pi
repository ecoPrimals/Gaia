def analyze_arena():
    """Analyze arena battles and classify AI chronotypes."""
    if not ARENA_LOG.exists():
        print("  No arena battles yet. Run arena.py first.")
        return
    
    battles = []
    with open(ARENA_LOG, "r") as f:
        for line in f:
            if line.strip():
                battles.append(json.loads(line))
    
    print(f"\n  AI CHRONOTYPE ANALYSIS — {len(battles)} battles")
    print(f"  {'─' * 50}")
    
    # Aggregate stats per model
    model_stats = {}
    for battle in battles:
        for result in battle.get("results", []):
            model = result["model"]
            if result["status"] != "ok":
                continue
            if model not in model_stats:
                model_stats[model] = {"tok_per_sec": [], "elapsed": [], "tokens": []}
            model_stats[model]["tok_per_sec"].append(result["tok_per_sec"])
            model_stats[model]["elapsed"].append(result["elapsed"])
            model_stats[model]["tokens"].append(result["tokens"])
    
    for model, stats in sorted(model_stats.items()):
        avg_tps = sum(stats["tok_per_sec"]) / len(stats["tok_per_sec"])
        avg_time = sum(stats["elapsed"]) / len(stats["elapsed"])
        avg_tokens = sum(stats["tokens"]) / len(stats["tokens"])
        
        # Classify chronotype using MULTIPLE dimensions:
        # - tok/s alone is misleading on fast GPUs
        # - elapsed time = how long they THINK
        # - tokens = how VERBOSE they are
        # - time * tokens = total effort invested
        think_effort = avg_time * avg_tokens  # higher = more deliberate
        verbosity = avg_tokens  # how much they say
        
        if avg_time < 3.0 and avg_tokens < 400:
            chronotype = "sprinter"
        elif avg_time > 12.0 and avg_tokens > 500:
            chronotype = "oracle"
        elif avg_time > 8.0 and verbosity > 600:
            chronotype = "scholar"
        elif "code" in model or "coder" in model or "starcoder" in model:
            chronotype = "specialist"
        elif "dream" in model or "chroma" in model or "dolphin" in model:
            chronotype = "artisan"
        elif avg_time > 5.0:
            chronotype = "scholar"
        else:
            chronotype = "sprinter"
        
        icon = {"sprinter": "⚡", "scholar": "📚", "artisan": "🎨", "specialist": "🔧", "oracle": "🔮"}.get(chronotype, "?")
        print(f"  {icon} {model:33s} {avg_tps:6.1f} tok/s  {avg_time:5.1f}s  {avg_tokens:5.0f}tok → {chronotype}")
    
    print(f"\n  AI CHRONOTYPE LEGEND:")
    for ctype, cdata in AI_CHRONOTYPES.items():
        lo, hi = cdata["tok_per_sec_range"]
        print(f"    {ctype:12s}: {lo}-{hi} tok/s — {cdata['description']}")


def show_human_framework():
    """Show the human chronotype framework."""
    print(f"\n  HUMAN CHRONOTYPES — Timing IS Identity")
    print(f"  {'═' * 55}")
    print(f"  No passwords. No accounts. No login.")
    print(f"  The CADENCE of your interaction IS your fingerprint.")
    print(f"  {'═' * 55}")
    
    for ctype, cdata in HUMAN_CHRONOTYPES.items():
        print(f"\n  {ctype.upper()}")
        print(f"    {cdata['description']}")
        print(f"    Cadence:   {cdata['typing_cadence']}")
        print(f"    Pauses:    {cdata['pause_pattern']}")
        print(f"    Rhythm:    {cdata['session_rhythm']}")
        print(f"    Output:    {cdata['output_style']}")
        print(f"    Epitopes:  {', '.join(cdata['epitope_affinity'])}")
        print(f"    Energy:    {cdata['energy_level']}")
        print(f"    Example:   {cdata['examples']}")
    
    print(f"\n  {'═' * 55}")
    print(f"  HOW THIS MAPS TO BINGOCUBE:")
    print(f"  {'─' * 55}")
    print(f"  1. The membrane observes TIMING, not content")
    print(f"     (squirrel/chipmunk — neutrino observation)")
    print(f"  2. Timing patterns → chronotype classification")
    print(f"  3. Chronotype → epitope shape affinity")
    print(f"     shape = [PHYSICS, TOPOLOGY, PHILOSOPHY, METHOD,")
    print(f"              INVESTIGATION, IMMUNE, SCIENCE, SIGNAL]")
    print(f"  4. Shape → BingoCube progressive trust protocol")
    print(f"     Round 0: shape exists (private, localStorage)")
    print(f"     Round 1: commit BLAKE3(shape || nonce)")
    print(f"     Round 2: reveal top 2 categories")
    print(f"     Round 3: compare ratios")
    print(f"     Round N: full shape exchange → collaborative braids")
    print(f"  {'─' * 55}")
    print(f"  THE TIMING IS THE IDENTITY.")
    print(f"  THE IDENTITY IS THE TRUST.")
    print(f"  THE TRUST IS ZK.")
    print(f"  {'═' * 55}")


