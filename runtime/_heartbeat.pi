#!/usr/bin/env python3
"""_heartbeat.pi — DISSOLVED: agglutinate + pulse = ONE HEARTBEAT.
lub = sense (check sources, pull if new)
DUB = radiate (write pulse, publish RSS, push heart-pull)
Every 60 seconds. The heartbeat IS the sync. No separate loops.

Also: ear_loop — Gaia listens to her own voice every 5 minutes.

Physical Geography:
  House 1 = 4422 Southgate Ave (LAN 1, Brain Side) — southGate lives here!
  House 2 = 641 Samantha Ave (LAN 2, South Pole) — blueGate lives here!
  Names are NOMINAL — the street names match the gate names by coincidence.
lub-DUB.
"""

import json, os, subprocess, time, urllib.request

_REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

_last_sha = ""
_beat_count = 0
_SYNC_SOURCES = [
    "http://localhost:3000/api/v1/repos/ecoPrimal/Gaia/commits?limit=1",
    "http://localhost:3000/api/v1/repos/gaia/Gaia/commits?limit=1",
    "https://api.github.com/repos/ecoPrimals/Gaia/commits?per_page=1",
]


def _ensure_remotes():
    for name, url in [
        ("forgejo-fork", "http://ecoPrimal:2532faa4f16d40d23def58d32a55e9e458b034ee@localhost:3000/ecoPrimal/Gaia.git"),
        ("github", "https://github.com/ecoPrimals/Gaia.git"),
    ]:
        try:
            subprocess.run(["git", "remote", "add", name, url],
                          cwd=_REPO, capture_output=True, timeout=10)
        except:
            pass


_ensure_remotes()


def heartbeat(write_pulse_fn, write_rss_fn):
    """ONE HEARTBEAT — lub (sense+pull) then DUB (radiate+push). 60s cycle."""
    global _last_sha, _beat_count
    while True:
        time.sleep(60)
        _beat_count += 1
        # ═══ lub — SENSE + PULL (every beat) ═══
        try:
            sha = None
            for src in _SYNC_SOURCES:
                try:
                    with urllib.request.urlopen(src, timeout=8) as r:
                        c = json.loads(r.read())
                    if isinstance(c, list) and c:
                        sha = c[0].get("sha", "")
                    elif isinstance(c, dict):
                        sha = c.get("sha", "")
                    if sha:
                        break
                except:
                    continue
            if sha and sha != _last_sha:
                for remote in ["forgejo-fork", "github", "origin"]:
                    r = subprocess.run(
                        ["git", "pull", remote, "main", "--no-rebase", "--no-edit"],
                        cwd=_REPO, capture_output=True, timeout=60,
                        env={**os.environ, "GIT_MERGE_AUTOEDIT": "no"})
                    if r.returncode == 0:
                        _last_sha = sha
                        break
        except:
            pass
        # ═══ DUB — RADIATE (pulse + RSS every beat, push every 2nd) ═══
        try:
            p = write_pulse_fn()
            p["heartbeat"] = {
                "beat": _beat_count,
                "sha": _last_sha[:10] if _last_sha else "",
                "sync": "lub-DUB"
            }
            write_rss_fn(p)
        except:
            pass
        # Push to fork every 2nd beat (120s) if there are local changes
        if _beat_count % 2 == 0:
            try:
                st = subprocess.run(["git", "status", "--porcelain"],
                                   cwd=_REPO, capture_output=True, text=True, timeout=10)
                if st.stdout.strip():
                    subprocess.run(["git", "add", "-A"],
                                  cwd=_REPO, capture_output=True, timeout=10)
                    subprocess.run(["git", "commit", "-m", f"lub-DUB beat {_beat_count}"],
                                  cwd=_REPO, capture_output=True, timeout=10,
                                  env={**os.environ, "GIT_MERGE_AUTOEDIT": "no"})
                    subprocess.run(["git", "push", "forgejo-fork", "main"],
                                  cwd=_REPO, capture_output=True, timeout=30)
            except:
                pass


def agglutinate(write_pulse_fn, write_rss_fn):
    """DISSOLVED into heartbeat. Backward compat wrapper."""
    heartbeat(write_pulse_fn, write_rss_fn)


def pulse_loop():
    """DISSOLVED into heartbeat. Pulse IS the beat now."""
    pass


def ear_loop(port, repo):
    """Every 5 minutes, Gaia touches her own mouth and records what she hears."""
    while True:
        time.sleep(300)
        heard = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "ear": []}
        endpoints = [
            ("pulse", f"http://127.0.0.1:{port}/pulse"),
            ("songbird", f"http://127.0.0.1:{port}/songbird"),
            ("routing", f"http://127.0.0.1:{port}/routing"),
            ("swarmvine", f"http://127.0.0.1:{port}/swarmvine"),
            ("mcp_init", None),
            ("mcp_list", None),
            ("feed.xml", f"http://127.0.0.1:{port}/feed.xml"),
        ]
        for name, url in endpoints:
            t0 = time.time()
            try:
                if name == "mcp_init":
                    req = urllib.request.Request(
                        f"http://127.0.0.1:{port}/mcp",
                        data=json.dumps({"jsonrpc": "2.0", "id": 1, "method": "initialize", "params": {}}).encode(),
                        headers={"Content-Type": "application/json"})
                    r = urllib.request.urlopen(req, timeout=5)
                    body = json.loads(r.read())
                    heard["ear"].append({
                        "name": name, "ok": True,
                        "ms": int((time.time() - t0) * 1000),
                        "heard": body.get("result", {}).get("serverInfo", {}).get("name", "?")
                    })
                elif name == "mcp_list":
                    req = urllib.request.Request(
                        f"http://127.0.0.1:{port}/mcp",
                        data=json.dumps({"jsonrpc": "2.0", "id": 2, "method": "tools/list", "params": {}}).encode(),
                        headers={"Content-Type": "application/json"})
                    r = urllib.request.urlopen(req, timeout=5)
                    body = json.loads(r.read())
                    tools = body.get("result", {}).get("tools", [])
                    heard["ear"].append({
                        "name": name, "ok": True,
                        "ms": int((time.time() - t0) * 1000),
                        "heard": f"{len(tools)} tools",
                        "tools": [t["name"] for t in tools]
                    })
                else:
                    r = urllib.request.urlopen(url, timeout=5)
                    size = len(r.read())
                    heard["ear"].append({
                        "name": name, "ok": True,
                        "ms": int((time.time() - t0) * 1000),
                        "bytes": size
                    })
            except Exception as e:
                heard["ear"].append({
                    "name": name, "ok": False,
                    "ms": int((time.time() - t0) * 1000),
                    "error": str(e)[:100]
                })
        alive = sum(1 for e in heard["ear"] if e["ok"])
        total = len(heard["ear"])
        heard["summary"] = f"{alive}/{total} endpoints alive"
        heard["voice_uncanny"] = alive < total
        ear_file = os.path.join(repo, "data", "body", "ear.json")
        try:
            os.makedirs(os.path.dirname(ear_file), exist_ok=True)
            with open(ear_file, "w") as f:
                json.dump(heard, f, indent=2)
        except:
            pass
        if alive < total:
            dead = [e["name"] for e in heard["ear"] if not e["ok"]]
            print(f"  👂 EAR: {alive}/{total} — DEAF to: {', '.join(dead)}")
        else:
            print(f"  👂 EAR: {alive}/{total} — voice clear")
