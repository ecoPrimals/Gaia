deckgate    IN  A    192.168.4.176   ; display, Steam Deck
southgate   IN  A    192.168.4.148   ; iPhone XS, home phone

; Infrastructure
router      IN  A    192.168.4.1     ; GL-MT6000 gateway
mikrotik    IN  A    192.168.4.2     ; L2 backbone
jetstream   IN  A    192.168.4.111   ; 10G fiber bridge to House 2
printer     IN  A    192.168.4.200   ; Epson ET-2400

; ═══════════════════════════════════════
; SOUTH POLE — LAN 2 (641 Samantha)
; ═══════════════════════════════════════
graphenegate IN  A   192.168.9.217   ; Pixel 8a diamond lens
framegate    IN  A   192.168.9.203   ; Steam Frame, ARM64 face

