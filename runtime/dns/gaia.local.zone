; gaia.local zone — the organism's internal body map
; Every gate resolvable by name. The nervous system.
$ORIGIN gaia.local.
$TTL 60

@           IN  SOA  eastgate.gaia.local. gaia.gaia.local. (
                2026111601  ; serial
                3600 900 604800 60
            )

@           IN  NS   eastgate.gaia.local.

; ═══════════════════════════════════════
; CARDINAL GATES — LAN 1 (Polaris Basecamp)
; ═══════════════════════════════════════
