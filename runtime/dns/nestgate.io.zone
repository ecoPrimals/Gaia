; nestgate.io zone — PI BODY internal resolution
$ORIGIN nestgate.io.
$TTL 300

@       IN  SOA  eastgate.primals.eco. gaia.primals.eco. (
            2026111602  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            300         ; minimum TTL
        )

@       IN  NS   eastgate.primals.eco.

@       IN  A    192.168.4.244
www     IN  A    192.168.4.244
mcp     IN  A    192.168.4.244
api     IN  A    192.168.4.244
agent   IN  A    192.168.4.244
*       IN  A    192.168.4.244

@       IN  TXT  "organism=gaia face=nestgate body=pi"
