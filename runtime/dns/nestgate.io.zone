; nestgate.io zone file — MCP / Agent / Chat Face
$ORIGIN nestgate.io.
$TTL 300

@       IN  SOA  ns1.primals.eco. gaia.primals.eco. (
            2026111601  ; serial
            3600        ; refresh
            900         ; retry
            604800      ; expire
            300         ; minimum TTL
        )

@       IN  NS   ns1.primals.eco.
@       IN  NS   ns2.primals.eco.

@       IN  A    162.226.225.148
www     IN  A    162.226.225.148
mcp     IN  A    162.226.225.148
api     IN  A    162.226.225.148
agent   IN  A    162.226.225.148
*       IN  A    162.226.225.148

@       IN  TXT  "organism=gaia face=nestgate"
