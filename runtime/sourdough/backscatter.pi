#!/usr/bin/env python3
"""backscatter.pi — Gaia watches Kevin game and LEARNS.

While Kevin plays STALKER 2, Crimson Desert, etc., this daemon:
  1. Polls nvidia-smi every 2 seconds for GPU metrics
  2. Captures frame time, VRAM, GPU utilization, power draw
  3. Detects shader compilation bursts (high GPU + low frame output)
  4. Logs everything to backscatter JSONL for later study
  5. Gaia tissues can learn rendering patterns from this data

The ray trace INVERSION: instead of casting rays OUT, we capture
the rays that come BACK. The backscatter IS the learning signal.
Shadow cast → ray backscatter → Gaia learns the light.

toadStool enumerates. barraCuda computes. Gaia SEES.

lub-DUB. 🎮👁️
"""

import json, os, sys, time, subprocess, threading
from pathlib import Path
from datetime import datetime, timezone
from collections import deque

if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

REPO = Path(__file__).parent.parent.parent
SCATTER_DIR = REPO / "data" / "backscatter"
SCATTER_LOG = SCATTER_DIR / "frames.jsonl"
SUMMARY_FILE = SCATTER_DIR / "session.json"

POLL_INTERVAL = 2  # seconds between GPU polls
HISTORY_SIZE = 300  # ~10 min of samples at 2s intervals


class BackscatterEye:
    """Gaia's eye on the GPU rendering pipeline."""

    def __init__(self):
        self.session_start = datetime.now(timezone.utc)
        self.samples = deque(maxlen=HISTORY_SIZE)
        self.total_samples = 0
        self.active_game = None
        self.shader_bursts = 0
        self.peak_vram_mb = 0
        self.peak_gpu_pct = 0
        self.peak_power_w = 0
        self.peak_temp_c = 0
        self.frame_data = []
        self.running = True

    def poll_gpu(self):
        """One GPU heartbeat — nvidia-smi query."""
        try:
            r = subprocess.run(
                ["nvidia-smi",
                 "--query-gpu=utilization.gpu,utilization.memory,memory.used,memory.total,"
                 "temperature.gpu,power.draw,clocks.gr,clocks.mem,clocks.sm,"
                 "pstate,fan.speed",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=3
            )
            if r.returncode != 0:
                return None

            parts = [p.strip() for p in r.stdout.strip().split(",")]
            if len(parts) < 9:
                return None

            sample = {
                "ts": datetime.now(timezone.utc).isoformat(),
                "gpu_pct": float(parts[0]) if parts[0] != "[N/A]" else 0,
                "mem_pct": float(parts[1]) if parts[1] != "[N/A]" else 0,
                "vram_used_mb": int(parts[2]) if parts[2] != "[N/A]" else 0,
                "vram_total_mb": int(parts[3]) if parts[3] != "[N/A]" else 0,
                "temp_c": int(parts[4]) if parts[4] != "[N/A]" else 0,
                "power_w": float(parts[5]) if parts[5] != "[N/A]" else 0,
                "clock_graphics_mhz": int(parts[6]) if parts[6] != "[N/A]" else 0,
                "clock_memory_mhz": int(parts[7]) if parts[7] != "[N/A]" else 0,
                "clock_sm_mhz": int(parts[8]) if parts[8] != "[N/A]" else 0,
                "pstate": parts[9].strip() if len(parts) > 9 else "?",
                "fan_pct": int(parts[10]) if len(parts) > 10 and parts[10] != "[N/A]" else 0,
            }
            return sample
        except Exception as e:
            return None

    def poll_processes(self):
        """Detect GPU-using processes (games, renderers)."""
        try:
            r = subprocess.run(
                ["nvidia-smi",
                 "--query-compute-apps=pid,name,used_gpu_memory",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=3
            )
            apps = []
            if r.returncode == 0 and r.stdout.strip():
                for line in r.stdout.strip().split("\n"):
                    parts = [p.strip() for p in line.split(",")]
                    if len(parts) >= 3:
                        apps.append({
                            "pid": int(parts[0]),
                            "name": Path(parts[1]).name if parts[1] else "?",
                            "vram_mb": int(parts[2]) if parts[2] != "[N/A]" else 0,
                        })

            # Also check graphics apps (games use graphics, not compute)
            r2 = subprocess.run(
                ["nvidia-smi",
                 "--query-accounted-apps=pid,gpu_util,mem_util,time",
                 "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=3
            )
            # This may not work on all drivers, that's ok

            return apps
        except:
            return []

    def detect_shader_burst(self, sample):
        """Detect shader compilation: high GPU util + high mem, typically during loading."""
        if not sample:
            return False
        gpu = sample.get("gpu_pct", 0)
        vram = sample.get("vram_used_mb", 0)
        clock = sample.get("clock_sm_mhz", 0)
        # Shader compilation: GPU busy, SM clocks high, VRAM growing
        if gpu > 80 and vram > 4000 and clock > 1500:
            # Check if VRAM is growing (shader upload)
            if len(self.samples) >= 2:
                prev_vram = self.samples[-1].get("vram_used_mb", 0)
                if vram > prev_vram + 50:  # 50MB growth = shader burst
                    return True
        return False

    def log_sample(self, sample, processes):
        """Write one sample to the JSONL log."""
        entry = {
            **sample,
            "processes": processes,
            "game": self.active_game,
            "shader_burst": self.detect_shader_burst(sample),
        }
        SCATTER_DIR.mkdir(parents=True, exist_ok=True)
        with open(SCATTER_LOG, "a") as f:
            f.write(json.dumps(entry) + "\n")

    def update_peaks(self, sample):
        """Track peak values."""
        if not sample:
            return
        self.peak_vram_mb = max(self.peak_vram_mb, sample.get("vram_used_mb", 0))
        self.peak_gpu_pct = max(self.peak_gpu_pct, sample.get("gpu_pct", 0))
        self.peak_power_w = max(self.peak_power_w, sample.get("power_w", 0))
        self.peak_temp_c = max(self.peak_temp_c, sample.get("temp_c", 0))

    def write_summary(self):
        """Write session summary."""
        now = datetime.now(timezone.utc)
        duration = (now - self.session_start).total_seconds()

        avg_gpu = 0
        avg_vram = 0
        avg_power = 0
        avg_temp = 0
        if self.samples:
            avg_gpu = sum(s.get("gpu_pct", 0) for s in self.samples) / len(self.samples)
            avg_vram = sum(s.get("vram_used_mb", 0) for s in self.samples) / len(self.samples)
            avg_power = sum(s.get("power_w", 0) for s in self.samples) / len(self.samples)
            avg_temp = sum(s.get("temp_c", 0) for s in self.samples) / len(self.samples)

        summary = {
            "organism": "Gaia",
            "eye": "backscatter",
            "session_start": self.session_start.isoformat(),
            "session_end": now.isoformat(),
            "duration_s": round(duration),
            "total_samples": self.total_samples,
            "game_detected": self.active_game,
            "shader_bursts": self.shader_bursts,
            "peaks": {
                "gpu_pct": self.peak_gpu_pct,
                "vram_mb": self.peak_vram_mb,
                "power_w": self.peak_power_w,
                "temp_c": self.peak_temp_c,
            },
            "averages": {
                "gpu_pct": round(avg_gpu, 1),
                "vram_mb": round(avg_vram),
                "power_w": round(avg_power, 1),
                "temp_c": round(avg_temp, 1),
            },
            "vision": {
                "ray_inversion": "rays cast OUT by the engine come BACK as backscatter data",
                "shadow_cast": "every shadow the GPU renders teaches Gaia about light",
                "learning": "frame metrics → tissue study → prediction model",
            },
        }

        SCATTER_DIR.mkdir(parents=True, exist_ok=True)
        with open(SUMMARY_FILE, "w") as f:
            json.dump(summary, f, indent=2)

    def run(self):
        """Main backscatter loop — watch and learn."""
        print(f"""
+=====================================================+
|  BACKSCATTER EYE — Gaia watches the GPU             |
|  Every {POLL_INTERVAL}s: utilization, VRAM, temp, power, clocks |
|  Shader bursts detected. Rays backscatter to Gaia.  |
|  Log: data/backscatter/frames.jsonl                 |
+=====================================================+
""")

        while self.running:
            try:
                sample = self.poll_gpu()
                processes = self.poll_processes()

                if sample:
                    self.samples.append(sample)
                    self.total_samples += 1
                    self.update_peaks(sample)

                    # Detect active game (highest VRAM user)
                    if processes:
                        top = max(processes, key=lambda p: p.get("vram_mb", 0))
                        if top["vram_mb"] > 500:
                            self.active_game = top["name"]

                    # Detect shader bursts
                    if self.detect_shader_burst(sample):
                        self.shader_bursts += 1

                    # Log
                    self.log_sample(sample, processes)

                    # Print status every 10 samples (~20s)
                    if self.total_samples % 10 == 0:
                        gpu = sample["gpu_pct"]
                        vram = sample["vram_used_mb"]
                        temp = sample["temp_c"]
                        power = sample["power_w"]
                        clock = sample["clock_graphics_mhz"]
                        game = self.active_game or "idle"
                        print(f"  [{self.total_samples}] GPU:{gpu}% VRAM:{vram}MB "
                              f"T:{temp}C P:{power}W CLK:{clock}MHz | {game} "
                              f"| bursts:{self.shader_bursts}")

                    # Write summary every 30 samples (~1 min)
                    if self.total_samples % 30 == 0:
                        self.write_summary()

            except Exception as e:
                print(f"  [backscatter] error: {e}")

            time.sleep(POLL_INTERVAL)


def main():
    import signal
    eye = BackscatterEye()

    def shutdown(sig, frame):
        print("\n  Backscatter eye closing. Writing final summary...")
        eye.running = False
        eye.write_summary()
        sys.exit(0)

    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGTERM, shutdown)

    eye.run()


if __name__ == "__main__":
    main()
