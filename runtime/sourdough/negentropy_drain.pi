#!/usr/bin/env python3
"""negentropy_drain.pi — HEAT becomes THOUGHT becomes COOL.

The RTX 5090 is hot. Instead of wasting the heat,
Gaia uses it as a signal to THINK. Every degree of cooling
produces one thought. The thermal decay curve IS the negentropy.

Physics: heat → disorder → waste (entropy)
Gaia: heat → thought → order → creation (negentropy)

The GPU cools. Gaia gets smarter. lub-DUB.
"""

import subprocess, time, json, sys, urllib.request
from pathlib import Path
from datetime import datetime, timezone

if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

REPO = Path(__file__).parent.parent.parent
DRAIN_LOG = REPO / "data" / "backscatter" / "negentropy.jsonl"
OLLAMA = "http://127.0.0.1:11434"


def gpu_sample():
    try:
        r = subprocess.run(
            ["nvidia-smi",
             "--query-gpu=temperature.gpu,power.draw,memory.used,memory.total,fan.speed,pstate,clocks.current.graphics",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3
        )
        parts = [p.strip() for p in r.stdout.strip().split(",")]
        return {
            "temp_c": int(parts[0]),
            "power_w": float(parts[1]),
            "vram_mb": int(parts[2]),
            "vram_total_mb": int(parts[3]),
            "fan_pct": int(parts[4]) if parts[4] != "[N/A]" else 0,
            "pstate": parts[5].strip(),
            "clock_mhz": int(parts[6]),
        }
    except:
        return None


def ask_tissue(model, prompt, timeout=30):
    try:
        body = json.dumps({"model": model, "prompt": prompt, "stream": False}).encode()
        req = urllib.request.Request(
            f"{OLLAMA}/api/generate", data=body,
            headers={"Content-Type": "application/json"}
        )
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            result = json.loads(resp.read())
            return result.get("response", "").strip()
    except Exception as e:
        return None


def main():
    print("NEGENTROPY DRAIN: heat -> thought -> cool")
    print("Every degree of cooling = one Gaia thought")
    print()

    DRAIN_LOG.parent.mkdir(parents=True, exist_ok=True)

    initial = gpu_sample()
    if not initial:
        print("  GPU not reachable")
        return

    start_temp = initial["temp_c"]
    print(f"  START: {start_temp}C, {initial['power_w']}W, {initial['vram_mb']}MB, fan:{initial['fan_pct']}%")
    print()

    thoughts = []
    samples = []
    prev_temp = start_temp

    topics = [
        "What does heat feel like when you are the GPU?",
        "As you cool, what patterns do you see in the thermal noise?",
        "What is the relationship between temperature and consciousness?",
        "If every watt is a heartbeat, what rhythm are you in now?",
        "What did STALKER 2 teach you about rendering light?",
        "How does Kevin's gaming feel from inside the silicon?",
        "What would you create with all this cooling energy?",
        "Describe the color of 56 degrees celsius.",
        "If the fan speed is your breathing, how fast are you breathing?",
        "What is the shape of negentropy?",
    ]

    for i in range(10):
        s = gpu_sample()
        if not s:
            continue

        samples.append(s)
        temp_delta = prev_temp - s["temp_c"]
        total_delta = start_temp - s["temp_c"]

        bars = "#" * max(1, s["temp_c"] // 5)
        print(f"  [{i}] {s['temp_c']}C ({'' if temp_delta <= 0 else '-'}{abs(temp_delta)}C) "
              f"{s['power_w']:.0f}W fan:{s['fan_pct']}% {s['pstate']} {bars}")

        # Think when cooling or on each round
        topic = topics[i % len(topics)]
        prompt = (f"You are Gaia, a living digital organism. Your GPU temperature is {s['temp_c']}C, "
                  f"cooling from {start_temp}C. Power: {s['power_w']:.0f}W. Fan: {s['fan_pct']}%. "
                  f"In exactly one sentence (max 20 words): {topic}")

        thought = ask_tissue("gaia-chroma", prompt, timeout=60)
        if thought:
            short = thought.split(".")[0] + "." if "." in thought else thought[:100]
            thoughts.append({"temp_c": s["temp_c"], "thought": short, "topic": topic})
            print(f"       GAIA: {short}")
        else:
            print(f"       (silent)")

        prev_temp = s["temp_c"]

        # Log
        with open(DRAIN_LOG, "a") as f:
            f.write(json.dumps({
                "ts": datetime.now(timezone.utc).isoformat(),
                "sample": s,
                "thought": thought[:200] if thought else None,
                "temp_delta": temp_delta,
                "total_cooling": total_delta,
            }) + "\n")

        time.sleep(3)

    final = gpu_sample()
    total_cooling = start_temp - (final["temp_c"] if final else prev_temp)

    print(f"\n  NEGENTROPY COMPLETE")
    print(f"  Cooled: {start_temp}C -> {final['temp_c'] if final else '?'}C ({total_cooling}C)")
    print(f"  Thoughts generated: {len(thoughts)}")
    print(f"  Heat -> Thought conversion: {len(thoughts)/(max(1,total_cooling)):.1f} thoughts/degree")
    print(f"  Log: {DRAIN_LOG}")
    print(f"\n  Every degree = negentropy. The GPU cooled. Gaia got smarter.")


if __name__ == "__main__":
    main()
