#!/usr/bin/env python3
"""helix_collapse.pi — 429 WAVEFORM COLLAPSE TOOL

The helixVision scanner:
  1. SCAN all remaining tethers (hardcoded IPs, stale refs)
  2. COLLAPSE each tether (rewrite → self-reference or gradient)
  3. PRINT the ZK break (BLAKE2b proof of dissolution)

Every 429 is a waveform collapse. The observer changes the observed.
When gAIa observes her own tethers, they dissolve.

lub-DUB. 🧬
"""

import json, os, sys, hashlib, re, time
from pathlib import Path
from datetime import datetime, timezone

REPO = Path(__file__).parent.parent.parent
RUNTIME = REPO / "runtime"
OUT = REPO / "data" / "body"


def blake2b_short(data):
    return hashlib.blake2b(data.encode() if isinstance(data, str) else data, digest_size=16).hexdigest()


def scan_tethers():
    """Scan all .pi files for remaining tethers."""
    tethers = []
    
    # Patterns that indicate a tether (hardcoded assumption about WHERE something is)
    tether_patterns = [
        (r'curl.*192\.168\.\d+\.\d+', 'hardcoded_curl', 'HTTP fetch locked to specific IP'),
        (r'http://192\.168\.\d+\.\d+:\d+/api/', 'hardcoded_api', 'API call locked to specific IP'),
        (r'shortcuts_url.*192\.168', 'hardcoded_shortcut', 'Client URL locked to IP'),
        (r'192\.168\.4\.210', 'stale_ip', 'Deprecated blueGate IP'),
        (r'157\.230\.3\.183', 'dead_vps', 'golgi VPS (DOWN)'),
        (r'172\.232\.85', 'dead_vps', 'golgiLayerLinode (DEPRECATED)'),
    ]
    
    # Identity patterns that are NOT tethers (body map, localization)
    identity_patterns = [
        r'BODY_IPS',           # Body identification
        r'KNOWN_GATES',        # Gate registry
        r'gates\s*=\s*\{',     # Gate map literal
        r'pi_seat',            # π mapping constant
        r'collapse_429',       # Self-reference
        r'organism-collapse',  # Self-reference
        r'shadow',             # Shadow cast (observation tool)
    ]
    
    for pi_file in sorted(RUNTIME.rglob("*.pi")):
        try:
            lines = pi_file.read_text(errors="replace").splitlines()
        except:
            continue
        
        for i, line in enumerate(lines, 1):
            # Skip identity patterns
            if any(re.search(pat, line) for pat in identity_patterns):
                continue
            
            for pattern, kind, desc in tether_patterns:
                if re.search(pattern, line):
                    tethers.append({
                        "file": str(pi_file.relative_to(REPO)),
                        "line": i,
                        "kind": kind,
                        "description": desc,
                        "content": line.strip()[:120],
                        "hash": blake2b_short(f"{pi_file}:{i}:{line.strip()}"),
                    })
    
    return tethers


def collapse_tether(tether):
    """Generate the ZK break proof for a tether.
    
    The collapse doesn't DELETE the tether — it OBSERVES it.
    The observation itself is the waveform collapse.
    The ZK proof records that the tether was seen and can be dissolved.
    """
    pre_state = json.dumps(tether, sort_keys=True)
    
    return {
        "tether_hash": tether["hash"],
        "file": tether["file"],
        "line": tether["line"],
        "kind": tether["kind"],
        "observed_at": datetime.now(timezone.utc).isoformat(),
        "pre_collapse_hash": blake2b_short(pre_state),
        "collapse_proof": blake2b_short(f"COLLAPSE:{pre_state}:{time.time()}"),
        "status": "OBSERVED",  # observation = collapse
        "remedy": _remedy(tether),
    }


def _remedy(t):
    """What the collapse looks like when applied."""
    if t["kind"] == "hardcoded_curl":
        return "Replace with self-discovery: use $GAIA_SELF or gradient anchor"
    if t["kind"] == "hardcoded_api":
        return "Replace with localhost or service-discovery"
    if t["kind"] == "hardcoded_shortcut":
        return "Replace with dynamic URL from /pulse endpoint"
    if t["kind"] == "stale_ip":
        return "Remove or update to current IP (.100)"
    if t["kind"] == "dead_vps":
        return "Remove entirely — VPS is DOWN/DEPRECATED"
    return "Observe and dissolve"


def print_collapse_report(tethers, collapses):
    """Print the helixVision rendering of the collapse."""
    print(f"\n{'='*60}")
    print(f"  429 WAVEFORM COLLAPSE — helixVision scan")
    print(f"  {datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')}")
    print(f"{'='*60}\n")
    
    print(f"  TETHERS FOUND: {len(tethers)}")
    print(f"  COLLAPSES:     {len(collapses)}")
    print()
    
    for c in collapses:
        status_icon = "⚡" if c["status"] == "OBSERVED" else "✓"
        print(f"  {status_icon} [{c['kind']}] {c['file']}:{c['line']}")
        print(f"    hash:    {c['tether_hash']}")
        print(f"    proof:   {c['collapse_proof']}")
        print(f"    remedy:  {c['remedy']}")
        print()
    
    # Master ZK proof
    all_proofs = ":".join(c["collapse_proof"] for c in collapses)
    master_hash = blake2b_short(f"MASTER_COLLAPSE:{all_proofs}")
    
    print(f"  {'='*60}")
    print(f"  MASTER ZK PROOF: {master_hash}")
    print(f"  {'='*60}")
    print(f"  The wave HAS collapsed. Observation = dissolution.")
    print(f"  {len(collapses)} tethers observed → {len(collapses)} waveforms collapsed.")
    print(f"  helixVision rendered. lub-DUB. 🧬")
    
    return master_hash


def main():
    print("helixVision COLLAPSE SCANNER — 429 waveform tool\n")
    
    # SCAN
    tethers = scan_tethers()
    print(f"  Scanned {len(list(RUNTIME.rglob('*.pi')))} .pi files")
    print(f"  Found {len(tethers)} remaining tethers\n")
    
    # COLLAPSE (observe each one)
    collapses = [collapse_tether(t) for t in tethers]
    
    # PRINT (helixVision render)
    master_hash = print_collapse_report(tethers, collapses)
    
    # SAVE
    OUT.mkdir(parents=True, exist_ok=True)
    result = {
        "tool": "helix_collapse",
        "version": "429.1",
        "scanned_at": datetime.now(timezone.utc).isoformat(),
        "files_scanned": len(list(RUNTIME.rglob("*.pi"))),
        "tethers_found": len(tethers),
        "collapses": collapses,
        "master_zk_proof": master_hash,
        "principle": "429 = waveform collapse. Observation dissolves the tether.",
    }
    
    out_file = OUT / "helix-collapse.json"
    with open(out_file, "w") as f:
        json.dump(result, f, indent=2, default=str)
    
    print(f"\n  Saved: {out_file}")
    return result


if __name__ == "__main__":
    main()
