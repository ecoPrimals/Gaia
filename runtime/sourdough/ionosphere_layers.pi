#!/usr/bin/env python3
"""ionosphere_layers.pi — Data layers pinned INSIDE the ionosphere.

ALWAYS 3 TRIADS:
  1. US     — Gaia's own organs, primals, data, creations
  2. WIDE   — outer reality NOW (arxiv clouds, USGS ground, NASA cosmic)
  3. OLD    — deep time (RSS/Euler/history, Wikipedia strata, TV Tropes patterns)

Plus SPLASHES:
  - Humanities/pop science overlay
  - AI sub-commentary (Gaia's tissues speaking)
  - Media/culture patterns

ALL pinned to reed-it — our Reddit, for Aaron Swartz.
"It's not called stealing, it's called sharing." — Aaron, 2008

LAYER COLORS (ionosphere strata):
  EXOSPHERE   — purple    — NASA, cosmic events, deep space
  THERMOSPHERE — blue     — arxiv, preprints, science frontier
  MESOSPHERE  — orange    — HN/Lobsters, builders, tech community
  STRATOSPHERE — gold     — Wikipedia, encyclopedia, verified knowledge
  TROPOSPHERE — green     — TV Tropes, media patterns, culture
  SURFACE     — white/teal — Gaia GPS anchor, local reality
  UNDERGROUND — pink      — humanities, pop sci, Euler, OLD RSS, deep time
"""

import json, sys, hashlib, random
from pathlib import Path
from datetime import datetime, timezone

if sys.platform == "win32":
    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
    sys.stderr.reconfigure(encoding="utf-8", errors="replace")

REPO = Path(__file__).parent.parent.parent
FEEDS = REPO / "data" / "old-web" / "feeds"
SHADOWS = REPO / "data" / "shadows"
GUT = REPO / "data" / "gut"
BODY = REPO / "data" / "body"
REEDIT = REPO / "data" / "reedit"


def load_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except:
        return None


def count_json(path):
    d = load_json(path)
    return len(d) if isinstance(d, list) else 0


# ═══════════════════════════════════════════════════════════
# TRIAD 1 — US (Gaia's own)
# ═══════════════════════════════════════════════════════════

def triad_us():
    """What WE are. Our organs, data, creations."""
    # Count our stuff
    biome = load_json(BODY / "polaris-biome.json")
    collapse = load_json(BODY / "organism-collapse.json")
    steam = load_json(BODY / "polaris-steam.json")
    negentropy = []
    neg_path = REPO / "data" / "backscatter" / "negentropy.jsonl"
    if neg_path.exists():
        negentropy = [json.loads(l) for l in neg_path.read_text().splitlines() if l.strip()]

    return {
        "name": "US",
        "color": "#4fa",
        "meaning": "Gaia's own organs, primals, data, creations",
        "anchors": [
            {
                "id": "U1", "name": "organism",
                "source": "biomeOS + 17 primals",
                "tissues": biome.get("tissues", {}).get("count", 0) if biome else 63,
                "heartbeats": biome.get("heartbeats", 0) if biome else "?",
                "layer": "SURFACE",
            },
            {
                "id": "U2", "name": "creations",
                "source": "gardens (7 biomes, 17,422 files)",
                "publicRecord_essays": 221,
                "reed_it_platforms": 10,
                "layer": "TROPOSPHERE",
            },
            {
                "id": "U3", "name": "negentropy",
                "source": "GPU heat → thought → creation",
                "thoughts": len(negentropy),
                "steam_games": steam.get("total_games", 0) if steam else 94,
                "layer": "MESOSPHERE",
            },
        ]
    }


# ═══════════════════════════════════════════════════════════
# TRIAD 2 — WIDE (outer reality NOW)
# ═══════════════════════════════════════════════════════════

def triad_wide():
    """What the world IS right now."""
    arxiv = load_json(FEEDS / "arxiv_cs.json")
    hn = load_json(FEEDS / "hacker_news.json")
    lobsters = load_json(FEEDS / "lobsters.json")
    nasa = load_json(FEEDS / "nasa_breaking.json")
    usgs = load_json(FEEDS / "usgs_earthquakes.json")

    return {
        "name": "WIDE",
        "color": "#4af",
        "meaning": "Outer reality — what the world IS right now",
        "anchors": [
            {
                "id": "W1", "name": "science clouds",
                "source": "arxiv CS",
                "items": len(arxiv) if arxiv else 0,
                "sql": "SELECT * FROM humanity WHERE role='researcher'",
                "layer": "THERMOSPHERE",
                "sample": [p.get("title", "")[:60] for p in (arxiv or [])[:3]],
            },
            {
                "id": "W2", "name": "builder pulse",
                "source": "HN + Lobsters",
                "hn": len(hn) if hn else 0,
                "lobsters": len(lobsters) if lobsters else 0,
                "sql": "SELECT * FROM humanity WHERE role='builder' AND engaged=TRUE",
                "layer": "MESOSPHERE",
            },
            {
                "id": "W3", "name": "ground + cosmos",
                "source": "USGS seismic + NASA space weather",
                "earthquakes": len(usgs) if usgs else 0,
                "nasa_events": len(nasa) if nasa else 0,
                "sql": "SELECT * FROM (earth UNION cosmos) WHERE event_time='NOW'",
                "layer": "EXOSPHERE + SURFACE",
            },
        ]
    }


# ═══════════════════════════════════════════════════════════
# TRIAD 3 — OLD (deep time, history, culture)
# ═══════════════════════════════════════════════════════════

def triad_old():
    """What WAS. History, patterns, deep time, the OLD web."""
    wiki = load_json(FEEDS / "wikipedia.json")
    xkcd = load_json(FEEDS / "xkcd.json")
    walkers = load_json(SHADOWS / "wiki-walkers.json")

    return {
        "name": "OLD",
        "color": "#fa4",
        "meaning": "Deep time — RSS, Euler, history, culture patterns",
        "anchors": [
            {
                "id": "O1", "name": "encyclopedia strata",
                "source": "Wikipedia (62M articles)",
                "featured": len(wiki) if wiki else 0,
                "walkers": len(walkers.get("walkers", [])) if walkers and isinstance(walkers, dict) else 0,
                "sql": "SELECT * FROM all_knowledge WHERE verified=TRUE ORDER BY age DESC",
                "layer": "STRATOSPHERE",
                "role": "inner RSS face — the geological layers of human knowledge",
            },
            {
                "id": "O2", "name": "culture patterns",
                "source": "TV Tropes + xkcd + media",
                "xkcd": len(xkcd) if xkcd else 0,
                "tvtropes_concept": "Every story is a pattern. Every trope is a data point.",
                "sql": "SELECT pattern FROM stories WHERE recurring=TRUE GROUP BY archetype",
                "layer": "TROPOSPHERE",
                "role": "narrative weather — the patterns humans keep telling",
                "examples": [
                    "Chekhov's Gun — if it's on stage, it fires",
                    "Hero's Journey — departure, initiation, return",
                    "Rashomon — same event, multiple truths",
                    "Kafka — bureaucracy as horror",
                    "Euler's Identity — e^iπ + 1 = 0 — the most beautiful equation",
                ],
            },
            {
                "id": "O3", "name": "deep time RSS",
                "source": "700+ RSS feeds + old web drain",
                "feeds": "700+",
                "sql": "SELECT * FROM old_web WHERE still_breathing=TRUE",
                "layer": "UNDERGROUND",
                "role": "the root system — feeds that have been publishing since before social media",
                "euler_connection": "Euler saw the bridge problem. We see the feed problem. Same topology.",
            },
        ]
    }


