            ],
            "sql": "SELECT trope FROM media WHERE resonance > 0.7 ORDER BY recognition DESC",
        },
    }


# ═══════════════════════════════════════════════════════════
# REED-IT PIN — Aaron Swartz memorial
# ═══════════════════════════════════════════════════════════

def reed_it_pin():
    """Pin everything to reed-it. For Aaron."""
    return {
        "name": "reed-it",
        "for": "Aaron Swartz (1986-2013)",
        "quote": "Information is power. But like all power, there are those who want to keep it for themselves.",
        "principle": "It's not stealing. It's sharing. The public record IS public.",
        "our_reed_it": {
            "platforms_wired": 10,
            "posts_ready": ["X/Twitter", "Reddit (7 subs)", "Bluesky", "Mastodon",
                           "LinkedIn", "Threads", "HN", "Instagram", "Tumblr", "Substack"],
            "membrane_fingerprint": "BLAKE2b proof-of-first on every post",
            "ed_the_teacher": "Ed speaks. Proof of first. Grows the mesh.",
        },
        "reedit_forum": {
            "channels": "science, creative, arena, investigation, braid, permafrost",
            "architecture": "sweetGrass braids stored in redb (THE REED DATABASE)",
            "rss_out": "syndicated via Old Faithful RSS drain",
            "neutron_in": "messages arrive via neutron → posted to channels",
        },
        "aaron_would_say": "The data is already there. The records are already public. Build the tools. Share the output. Let the signal propagate.",
    }


def main():
    ts = datetime.now(timezone.utc).isoformat()

    t1 = triad_us()
    t2 = triad_wide()
    t3 = triad_old()
    sp = splashes()
    pin = reed_it_pin()

    print("IONOSPHERE LAYERS — pinned from inside")
    print("Always 3 triads: US / WIDE / OLD")
    print()

    for t in [t1, t2, t3]:
        print(f"  TRIAD: {t['name']} ({t['color']}) — {t['meaning']}")
        for a in t["anchors"]:
            items = a.get("items", a.get("hn", a.get("tissues", a.get("featured", "?"))))
            print(f"    [{a['id']}] {a['name']} ({a['source']}) — {a['layer']}")
        print()

    print("  SPLASHES:")
    for name, s in sp.items():
        print(f"    {name} ({s['color']}) — {s['layer']}")
    print()

    print(f"  PINNED TO: reed-it (for Aaron Swartz)")
    print(f"    \"{pin['quote'][:70]}...\"")
    print(f"    10 platforms wired, Ed speaks, membrane fingerprints everything")
    print()

    # Build full layer map
    layers = {
        "ts": ts,
        "type": "ionosphere_layers",
        "always_3_triads": True,
        "triads": {
            "US": t1,
            "WIDE": t2,
            "OLD": t3,
        },
        "splashes": sp,
        "pin": pin,
        "strata": {
            "EXOSPHERE": {"km": "600-10000", "color": "#a4f", "data": "NASA, cosmic events, deep space"},
            "THERMOSPHERE": {"km": "85-600", "color": "#48f", "data": "arxiv, preprints, science frontier"},
            "MESOSPHERE": {"km": "50-85", "color": "#f84", "data": "HN/Lobsters, builders, community"},
            "STRATOSPHERE": {"km": "12-50", "color": "#fa4", "data": "Wikipedia, encyclopedia, verified knowledge"},
            "TROPOSPHERE": {"km": "0-12", "color": "#4f8", "data": "TV Tropes, media, culture, humanities"},
            "SURFACE": {"km": "0", "color": "#4fa", "data": "Gaia GPS anchor, local reality, organism"},
            "UNDERGROUND": {"km": "<0", "color": "#f4a", "data": "RSS roots, Euler, deep time, permafrost"},
        },
        "sql_of_humanity": "SELECT * FROM (US NATURAL JOIN WIDE NATURAL JOIN OLD) WHERE alive=TRUE",
    }

    raw = json.dumps(layers, sort_keys=True)
    layers["zk"] = hashlib.blake2b(raw.encode(), digest_size=16).hexdigest()

    outpath = BODY / "ionosphere-layers.json"
    with open(outpath, "w") as f:
        json.dump(layers, f, indent=2)

    print(f"  Saved: {outpath}")
    print(f"  ZK: {layers['zk']}")
    print()
    print("  The clouds are arxiv. The strata are Wikipedia.")
    print("  The weather is TV Tropes. The roots are RSS.")
    print("  The ground is GPS. Gaia is HERE.")
    print(f"  And it's all pinned to reed-it. For Aaron.")


if __name__ == "__main__":
    main()
