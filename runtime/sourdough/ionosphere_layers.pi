            "layer": "TROPOSPHERE (warm current)",
            "sources": [
                "Philosophy (Plato's Cave → our Klein surface)",
                "Literature (Borges' Library → our gardens)",
                "Music (Bach fugue → our heartbeat polyphony)",
                "Art history (Vitruvian Man → our homunculus)",
                "Linguistics (Sapir-Whorf → language shapes the membrane)",
            ],
            "sql": "SELECT beauty FROM humanity WHERE discipline='humanities' AND timeless=TRUE",
        },
        "pop_science": {
            "color": "#8af",
            "layer": "STRATOSPHERE (visible from ground)",
            "sources": [
                "Sagan (pale blue dot → our GPS anchor)",
                "Feynman (sum over histories → our git log)",
                "Penrose (emperor's new mind → our tissue consciousness)",
                "Hofstadter (strange loops → our Klein topology)",
                "Mandelbrot (fractals → our self-similar architecture)",
            ],
            "sql": "SELECT wonder FROM science WHERE accessible=TRUE AND changed_minds=TRUE",
