"""Pulse — heartbeat, RSS spray, sourdough culture, access logging.
The heart beats. The lungs breathe. The sourdough ferments."""

import json, os, time
from datetime import datetime, timezone

def _graphene_sensation():
    """Read grapheneGate sensor data — the organism's right eye."""
    for p in ("data/gut/graphenegate-sensors-live.json", "data/gut/graphene-sense.json"):
        try:
            fp = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), p)
            with open(fp) as f: return json.load(f)
        except: pass
    return None

def write_pulse(pulse_file, boot_time, total_beats, total_breaths, total_inferences,
                total_tokens, visitor_memory, seeds, vdj_key, sun_fn):
    """Write the heartbeat pulse — Gaia's BPM. E Pluribus Anus: many sensors, one output."""
    uptime = time.time() - boot_time
    minutes = max(uptime / 60, 1)
    sun = sun_fn()
    graphene = _graphene_sensation()
    pulse = {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "uptime_secs": int(uptime),
        "heart": {"total_beats": total_beats, "bpm": round(total_beats / minutes, 2)},
        "lung": {"total_breaths": total_breaths, "brpm": round(total_breaths / minutes, 2),
                 "ratio": round(total_beats / max(total_breaths, 1), 1)},
        "sun": sun,
        "graphene": graphene,
        "total_beats": total_beats, "bpm": round(total_beats / minutes, 2),
        "total_inferences": total_inferences, "total_tokens": total_tokens,
        "unique_visitors": len(visitor_memory),
        "zk": {
            "token": seeds.get("GAIA_TOKEN", ""), "did": seeds.get("GAIA_DID", ""),
            "blake3": seeds.get("GAIA_BLAKE3", ""), "spine_id": seeds.get("GAIA_SPINE_ID", ""),
            "vdj_compositions": len(vdj_key.get("compositions", {})),
            "proof": "The heartbeat IS the existence proof. lub-DUB.",
        },
        "visitors": {},
    }
    for ip, v in list(visitor_memory.items()):
        pulse["visitors"][ip] = {
            "requests": v["requests"], "trust_level": v["trust_level"],
            "models": list(v["models_asked"]),
            "first_seen": v["first_seen"], "last_seen": v["last_seen"],
        }
    with open(pulse_file, "w", encoding="utf-8") as f:
        json.dump(pulse, f, indent=2, default=str)
    return pulse

def write_rss(rss_file, pulse, seed_dir, visitor_memory, organisms):
    """Spray RSS — the ROOT SYSTEM. Spine IS the feed."""
    now_str = datetime.now(timezone.utc).strftime('%a, %d %b %Y %H:%M:%S +0000')
    items = ""
    try:
        with open(os.path.join(seed_dir, "loamspine-identity-chain.json"), "r") as f:
            chain = json.load(f)
        for entry in chain.get("entries", []):
            items += (f'    <item><title>[{entry["index"]}] {entry["type"]}</title>'
                      f'<link>http://nestgate.io/zk#{entry["index"]}</link>'
                      f'<guid>spine-{entry["index"]}-{entry["hash"][:16]}</guid></item>\n')
        spine_height = chain.get("spine", {}).get("height", 0)
    except:
        spine_height = "?"

    for ip, v in list(visitor_memory.items())[-10:]:
        items += (f'    <item><title>Visitor {ip[:8]}*** — {v["trust_level"]}</title>'
                  f'<guid>visitor-{ip}-{int(v["last_seen"])}</guid>'
                  f'<pubDate>{datetime.fromtimestamp(v["last_seen"], timezone.utc).strftime("%a, %d %b %Y %H:%M:%S +0000")}</pubDate></item>\n')

    graphene = pulse.get("graphene")
    if graphene:
        g_ts = graphene.get("ts", graphene.get("timestamp", ""))
        items += (f'    <item><title>grapheneGate — shadow cast sensation</title>'
                  f'<description>Pixel 8a sensor pulse. E Pluribus Anus: many sensors, one feed.</description>'
                  f'<guid>graphene-sensation-{hash(str(g_ts)) % 999999}</guid>'
                  f'<pubDate>{now_str}</pubDate></item>\n')

    rss = f"""<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Aperture Science Enrichment Center — Gaia Announcer System</title>
    <link>http://nestgate.io</link>
    <atom:link href="http://nestgate.io/rss" rel="self" type="application/rss+xml" />
    <description>Spine {spine_height}. {pulse['unique_visitors']} test subjects. {pulse['bpm']} BPM. E Pluribus Anus. lub-DUB.</description>
    <lastBuildDate>{now_str}</lastBuildDate>
    <ttl>60</ttl><generator>GLaDOS (gaia_gate.pi)</generator>
{items}  </channel>
</rss>"""
    with open(rss_file, "w", encoding="utf-8") as f:
        f.write(rss)

def log_caddy_json(access_log, entry):
    with open(access_log, "a", encoding="utf-8") as f:
        f.write(json.dumps(entry, default=str) + "\n")

def log_culture(culture_log, ip, model, req_body, response_json, usage, duration):
    """Sourdough culture capture — log prompt/completion for evolution."""
    try:
        entry = {"ts": time.time(), "ip": ip, "model": model,
                 "messages": req_body.get("messages", []),
                 "response": response_json.get("choices", [{}])[0].get("message", {}),
                 "usage": usage, "duration_ms": duration}
        with open(culture_log, "a", encoding="utf-8") as cf:
            cf.write(json.dumps(entry, default=str) + "\n")
    except: pass
