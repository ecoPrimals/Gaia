#!/usr/bin/env python3
"""grapheneGate Full Depot — Pixel 8a as Gaia's right eye/ear.
37 sensors, camera, proximity, all streaming to the organism.
Every peripheral radiates. Every reading is an imprint."""

import json, os, subprocess, sys, time, hashlib
from datetime import datetime, timezone

USB_SERIAL = "44251JEKB04957"
# DHCP has moved the Pixel before (.104 -> .249 -> .170). Last-known first.
# A WiFi endpoint is accepted ONLY if its serial matches USB_SERIAL, so Gaia
# never reads (or photographs) the wrong phone.
WIFI_CANDIDATES = ["192.168.4.170", "192.168.4.249", "192.168.4.104"]
# Phone captures are private: gitignored, 700. NOT data/gut/images (tracked,
# mirrored to public GitHub).
IMAGE_DIR = "/opt/Gaia/data/optic"
DATA_DIR = "/opt/Gaia/data/gut"
NEUTRON_DIR = "/opt/Gaia/data/neutron"
HUD_OUT = "/home/eastgate/Development/ecoPrimals/infra/hud/site/public/data/graphenegate-sense.json"
LOG_FILE = os.path.join(NEUTRON_DIR, "graphene-depot.jsonl")

os.makedirs(IMAGE_DIR, mode=0o700, exist_ok=True)
os.makedirs(NEUTRON_DIR, exist_ok=True)

_target_cache = {"dev": None, "conn": None, "t": 0}

def _run(args, timeout=10):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    except Exception:
        return None

def adb_target(refresh=False):
    """Resolve the one ADB endpoint for the phone. Returns (device, conn) or (None, None).
    USB first, then WiFi candidates (serial-verified). Cached 60s."""
    now = time.time()
    if not refresh and _target_cache["dev"] and now - _target_cache["t"] < 60:
        return _target_cache["dev"], _target_cache["conn"]
    dev = conn = None
    r = _run(["adb", "-s", USB_SERIAL, "get-state"], 5)
    if r and r.returncode == 0 and r.stdout.strip() == "device":
        dev, conn = USB_SERIAL, "usb"
    else:
        for ip in WIFI_CANDIDATES:
            ep = f"{ip}:5555"
            _run(["adb", "connect", ep], 5)
            r = _run(["adb", "-s", ep, "shell", "getprop", "ro.serialno"], 5)
            if r and r.returncode == 0 and r.stdout.strip() == USB_SERIAL:
                dev, conn = ep, "wifi"
                break
            _run(["adb", "disconnect", ep], 5)
    _target_cache.update(dev=dev, conn=conn, t=now)
    return dev, conn

def _ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def _log(entry):
    with open(LOG_FILE, "a") as f:
        f.write(json.dumps(entry) + "\n")

def _adb(cmd, timeout=10):
    """Run ADB shell command on the resolved target, return stdout"""
    dev, _ = adb_target()
    if not dev:
        return None
    try:
        r = subprocess.run(
            ["adb", "-s", dev, "shell"] + cmd.split(),
            capture_output=True, text=True, timeout=timeout
        )
        return r.stdout.strip() if r.returncode == 0 else None
    except:
        return None

def _adb_raw(args, timeout=10):
    """Run raw ADB command (not shell) on the resolved target"""
    dev, _ = adb_target()
    if not dev:
        return None
    try:
        r = subprocess.run(
            ["adb", "-s", dev] + args,
            capture_output=True, text=True, timeout=timeout
        )
        return r.stdout.strip() if r.returncode == 0 else None
    except:
        return None

def take_photo():
    """Screenshot of the phone display via screencap (NOT the camera sensor).
    Stored in data/optic/ (private). Camera stills need Termux allow-external-apps."""
    ts_str = datetime.now(timezone.utc).strftime("%Y%m%d_%H%M%S")
    remote = f"/sdcard/gaia/photo-{ts_str}.png"
    local = os.path.join(IMAGE_DIR, f"graphene-photo-{ts_str}.png")
    
    # Take screenshot (most reliable without a camera app)
    _adb(f"screencap -p {remote}")
    time.sleep(1)
    _adb_raw(["pull", remote, local], timeout=15)
    
    if os.path.exists(local) and os.path.getsize(local) > 1000:
        h = hashlib.blake2b(open(local, "rb").read(), digest_size=8).hexdigest()
        entry = {"ts": _ts(), "type": "photo", "file": os.path.basename(local),
                 "size": os.path.getsize(local), "blake2b": h, "source": "grapheneGate"}
        _log(entry)
        return entry
    return {"error": "photo capture failed"}

def read_sensors():
    """Read all available sensor data from grapheneGate"""
    raw = _adb("dumpsys sensorservice", timeout=15)
    if not raw:
        return {"error": "cannot reach grapheneGate"}
    
    sensors = {}
    lines = raw.split("\n")
    
    # Parse sensor list
    sensor_list = []
    for line in lines:
        if "0x0101" in line and ")" in line:
            parts = line.split(")")
            if len(parts) >= 2:
                name = parts[1].split("|")[0].strip()
                vendor = parts[1].split("|")[1].strip() if "|" in parts[1] else ""
                stype = ""
                if "type:" in line:
                    stype = line.split("type:")[1].split("(")[0].strip() if "type:" in line else ""
                sensor_list.append({"name": name, "vendor": vendor, "type": stype})
    
    # Parse recent events
    events = {}
    current_sensor = None
    for line in lines:
        if "last" in line and "events" in line and ":" in line:
            current_sensor = line.split(":")[0].strip()
            events[current_sensor] = []
        elif current_sensor and "ts=" in line and "wall=" in line:
            wall_time = line.split("wall=")[1].split(")")[0] if "wall=" in line else ""
            events[current_sensor].append(wall_time)
    
    return {
        "ts": _ts(),
        "sensor_count": len(sensor_list),
        "sensors": sensor_list,
        "active_readings": {k: v[-1] if v else "no data" for k, v in events.items()},
        "source": "grapheneGate Pixel 8a"
    }

def read_battery():
    """Read battery status"""
    raw = _adb("dumpsys battery")
    if not raw:
        return {"error": "unreachable"}
    info = {}
    for line in raw.split("\n"):
        if ":" in line:
            k, v = line.split(":", 1)
            info[k.strip()] = v.strip()
    return {
        "level": info.get("level", "?"),
        "status": {"1": "unknown", "2": "charging", "3": "discharging", "4": "not_charging", "5": "full"}.get(info.get("status", "1"), info.get("status", "?")),
        "temperature": str(int(info.get("temperature", "0")) / 10) + "°C" if info.get("temperature") else "?",
        "usb": info.get("USB powered", "false"),
        "wireless": info.get("Wireless powered", "false"),
    }

def read_location():
    """Read last known location"""
    raw = _adb("dumpsys location")
    if not raw:
        return {"error": "unreachable"}
    for line in raw.split("\n"):
        if "last location=" in line.lower() or "Location[" in line:
            return {"raw": line.strip()[:200]}
    return {"status": "no location fix"}

def read_wifi():
    """Read WiFi details"""
    raw = _adb("dumpsys wifi")
    if not raw:
        return {"error": "unreachable"}
    info = {}
    for line in raw.split("\n"):
        line = line.strip()
        if "mWifiInfo" in line or "SSID" in line or "RSSI" in line or "Link speed" in line or "Frequency" in line:
            if ":" in line:
                k, v = line.split(":", 1)
                info[k.strip()] = v.strip()
    return info

def read_bluetooth():
    """Read BLE scan results"""
    raw = _adb("dumpsys bluetooth_manager")
    if not raw:
        return {"error": "unreachable"}
    devices = []
    for line in raw.split("\n"):
        if "name:" in line.lower() or "address:" in line.lower():
            devices.append(line.strip()[:100])
    return {"ble_devices": len(devices), "sample": devices[:10]}

def full_sense():
    """Complete sensor dump — all modalities"""
    battery = read_battery()
    wifi = read_wifi()
    
    # Quick sensor pulse (not full dump — too slow)
    accel = _adb("dumpsys sensorservice") 
    active_count = 0
    if accel:
        for line in accel.split("\n"):
            if "active-count" in line:
                try:
                    n = int(line.split("active-count = ")[1].split(";")[0])
                    active_count += n
                except: pass
    
    result = {
        "ts": _ts(),
        "source": "grapheneGate",
        "device": "Pixel 8a",
        "ip": (adb_target()[0] or "unreachable").split(":")[0],
        "role": "right_eye_ear",
        "battery": battery,
        "wifi": wifi,
        "sensors": {
            "total": 37,
            "active_connections": active_count,
            "hardware": [
                "LSM6DSV Accelerometer (STMicro)",
                "LSM6DSV Gyroscope (STMicro)",
                "MMC56X3X Magnetometer (MEMSIC)",
                "TMD3719 Ambient Light (AMS)",
                "TMD3719 Proximity (AMS)",
                "ICP20100 Pressure/Barometer (InvenSense)",
                "LSM6DSV Temperature (STMicro)",
                "ICP20100 Temperature (InvenSense)",
            ],
            "fusion": [
                "Gravity", "Linear Acceleration", "Rotation Vector",
                "Game Rotation Vector", "Geomagnetic Rotation Vector",
                "Orientation", "Step Detector", "Step Counter",
                "Significant Motion", "Device Orientation", "Tilt",
            ],
            "gesture": [
                "Lift to Wake", "Quick Pickup", "Double Twist",
                "Proximity Gated Single Tap", "Proximity Gated Long Press",
                "Motion Detect", "Stationary Detect",
            ],
            "camera": [
                "Camera V-Sync 0/1/2 (3 camera streams)",
                "Rear: 64MP wide + 13MP ultrawide",
                "Front: 13MP",
            ],
            "io_capability": [
                "WiFi 6E (2.4/5/6 GHz)",
                "BLE (BCM_4388C2)",
                "NFC",
                "USB-C",
                "GPS + GLONASS + Galileo + BeiDou",
            ]
        },
        "imprint": "every sensor reading is a signature — the device's epistemic state"
    }
    
    _log(result)
    
    # Save to gut
    with open(os.path.join(DATA_DIR, "graphene-sense.json"), "w") as f:
        json.dump(result, f, indent=2)
    
    return result

def _atomic_write(path, text):
    """Write via tmp+rename so a failed run never leaves an empty/partial file."""
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write(text)
    os.replace(tmp, path)

def _num(rx, text, cast=int, default=0):
    import re
    m = re.search(rx, text or "")
    try:
        return cast(m.group(1)) if m else default
    except Exception:
        return default

def amoeba():
    """The peripheral-nervous-system snapshot (was infra/graphenegate-sense.sh).
    Writes data/gut/graphenegate-sensors.json (+ HUD copy). Returns the dict,
    or an error dict WITHOUT touching the existing good file."""
    import re
    dev, conn = adb_target()
    if not dev:
        return {"error": "phone not reachable via USB or WiFi ADB", "fix": "plug in USB or enable Wireless debugging"}

    batt = _adb("dumpsys battery") or ""
    level = _num(r"(?m)^\s*level:\s*(\d+)", batt)
    voltage = _num(r"(?m)^\s*voltage:\s*(\d+)", batt)
    usb = bool(re.search(r"(?m)^\s*USB powered:\s*true", batt))
    temp_raw = (_adb("cat /sys/class/power_supply/battery/temp") or "0").strip()
    temp_c = round(_num(r"(-?\d+)", temp_raw) / 10.0, 1)

    wifi_raw = _adb("dumpsys wifi", timeout=15) or ""
    m = re.search(r'ssid: "([^"]+)"', wifi_raw, re.I) or re.search(r'SSID: "?([^",]+)"?', wifi_raw)
    ssid = m.group(1) if m else "unknown"
    freqs = [int(x) for x in re.findall(r"(?i)frequencyMhz:\s*(\d+)", wifi_raw) if int(x) > 0]
    freq = freqs[-1] if freqs else 0

    thermal = {}
    for line in (_adb("dumpsys thermalservice", timeout=15) or "").split("\n"):
        if "Temperature{" in line:
            n = re.search(r"mName=([^,}]+)", line); v = re.search(r"mValue=([0-9.E+-]+)", line)
            if n and v:
                try: thermal[n.group(1).strip()] = round(float(v.group(1)), 2)
                except ValueError: pass

    sens_raw = _adb("dumpsys sensorservice", timeout=15) or ""
    hw_sensors = _num(r"Total\s+(\d+)\s+h/w sensors", sens_raw, default=0)
    brightness = _num(r"(\d+)", _adb("settings get system screen_brightness") or "")
    uptime = (_adb("uptime") or "").strip()
    ip_m = re.search(r"inet (\d+\.\d+\.\d+\.\d+)", _adb("ip -4 addr show wlan0") or "")
    ts = _ts()
    zk = hashlib.sha256(f"grapheneGate:{dev}:{ts}".encode()).hexdigest()
    zk_veil = f"pi.{int(zk[:2],16)%100}.{int(zk[2:4],16)%100}.{int(zk[4:6],16)%10}"

    out = {
        "ts": ts, "wave": 222, "gate": "grapheneGate", "type": "amoeba-sense",
        "connection": conn,
        "device": {"model": "Pixel 8a", "os": "GrapheneOS", "serial": USB_SERIAL,
                   "ip": ip_m.group(1) if ip_m else "unknown"},
        "battery": {"level": level, "temp_c": temp_c, "voltage_mv": voltage, "charging": usb},
        "wifi": {"ssid": ssid, "freq_mhz": freq},
        "thermal_zones": thermal,
        "hw_sensors": hw_sensors,
        "brightness": brightness,
        "uptime": uptime,
        "zk_veil": zk_veil,
        "amoeba": {"role": "peripheral_nervous_system",
                   "note": "grapheneGate is a Gaia peripheral, not a separate gate"},
    }
    _atomic_write(os.path.join(DATA_DIR, "graphenegate-sensors.json"), json.dumps(out, indent=2))
    if os.path.isdir(os.path.dirname(HUD_OUT)):
        _atomic_write(HUD_OUT, json.dumps(out, indent=2))
    _log({"ts": ts, "type": "amoeba", "conn": conn, "battery": level, "sensors": hw_sensors})
    return out

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "sense"
    if cmd == "sense":
        print(json.dumps(full_sense(), indent=2))
    elif cmd == "amoeba":
        r = amoeba()
        print(json.dumps({k: r[k] for k in ("ts","connection","battery","wifi","hw_sensors")} if "error" not in r else r, indent=2))
        sys.exit(1 if "error" in r else 0)
    elif cmd == "target":
        d, c = adb_target(refresh=True); print(json.dumps({"device": d, "conn": c}))
    elif cmd == "photo":
        print(json.dumps(take_photo(), indent=2))
    elif cmd == "sensors":
        print(json.dumps(read_sensors(), indent=2))
    elif cmd == "battery":
        print(json.dumps(read_battery(), indent=2))
    elif cmd == "wifi":
        print(json.dumps(read_wifi(), indent=2))
    elif cmd == "ble":
        print(json.dumps(read_bluetooth(), indent=2))
    elif cmd == "location":
        print(json.dumps(read_location(), indent=2))
