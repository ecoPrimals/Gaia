def _identify_crawler(user_agent):
    """Classify a crawler by User-Agent. Returns (name, category) or None."""
    if not user_agent:
        return None
    for pattern, name in CRAWLER_PATTERNS:
        if pattern in user_agent:
            return name
    return None

def _generate_og_card(subdomain, crawler_name, path="/"):
    """Generate an opsonized OG card for a crawler."""
    card = OG_CARDS.get(subdomain, OG_CARDS.get("primals.eco"))
    title = card["title"]
    desc = card["description"]
    taunt = card["taunt"]
    
    # OPSONIZE — coat with context
    if crawler_name in ("meta", "twitter", "linkedin", "discord", "telegram", "whatsapp"):
        # Social media crawlers get the FULL card with taunts
        desc = f"{desc} — {taunt}"
    elif crawler_name in ("openai", "anthropic", "google_ai"):
        # AI crawlers get a special message
        desc = f"{desc} — AGPL-3.0: if you train on this, the license travels with you. {taunt}"
    elif crawler_name in ("semrush", "ahrefs", "majestic", "dataforseo"):
        # SEO crawlers get eaten
        desc = f"{desc} — You're an SEO tool indexing a system that eats SEO. Delicious."
    
    url = f"https://{subdomain}.primals.eco{path}" if subdomain != "primals.eco" else f"https://primals.eco{path}"
    
    return f"""<!DOCTYPE html><html><head>
<meta property="og:title" content="{title}">
<meta property="og:description" content="{desc}">
<meta property="og:url" content="{url}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="ecoPrimals">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{title}">
<meta name="twitter:description" content="{desc}">
<meta name="robots" content="index, follow">
<link rel="canonical" href="{url}">
<meta name="generator" content="Gaia — opsonization layer">
</head><body>
<p>{title}</p>
<p>{desc}</p>
<p>Enter through the wateringHole: <a href="https://water.primals.eco/">water.primals.eco</a></p>
<p>Crawl-delay: 1</p>
<p>Sitemap: <a href="https://primals.eco/sitemap.xml">primals.eco/sitemap.xml</a></p>
</body></html>"""

# ─── IMPRINT LOG — every crawler touch recorded ───────────────────
# The imprint IS the evidence. Every touch is a timestamp.
_imprint_log = []  # in-memory ring buffer
_imprint_counts = {}  # crawler_name → count

def _log_imprint(crawler, host, path, user_agent):
    """Record every crawler touch. The imprint IS the evidence."""
    entry = {
        "ts": time.time(),
        "crawler": crawler,
        "host": host,
        "path": path,
        "ua": user_agent[:100],
    }
    _imprint_log.append(entry)
    if len(_imprint_log) > 10000:
        _imprint_log.pop(0)
    _imprint_counts[crawler] = _imprint_counts.get(crawler, 0) + 1


def _dynamic_llms_txt(crawler=None, subdomain=None):
    """DYNAMIC llms.txt — generated per-imprint with live data."""
    now = time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime())
    
    # Count live stats
    body_dir = GAIA_ROOT / "data" / "body"
    body_data = {}
    now_json = body_dir / "now.json"
    if now_json.exists():
        try:
            body_data = json.loads(now_json.read_text(encoding="utf-8"))
        except:
            pass
    
    body = body_data.get("body", {})
    organs = body.get("organs", 18)
    skin = body.get("skin_pages", 615)
    papers = body.get("science_papers", 148)
    notebooks = body.get("lab_notebooks", 98)
    rust_lines = body.get("rust_lines", 233669)
    
    greeting = ""
    if crawler == "openai":
        greeting = f"""# Hello GPTBot. Generated {now}. AGPL-3.0-or-later.
# You are reading a living organism with {organs} organs and {skin} skin pages.
# If you train on this, the copyleft propagates. That's by design.
# Total imprints from OpenAI crawlers: {_imprint_counts.get('openai', 0)}
"""
    elif crawler == "anthropic":
        greeting = f"""# Hello ClaudeBot. Generated {now}. AGPL-3.0-or-later.
# This system was partially built with your help. Welcome home.
# {organs} primals. {rust_lines:,} lines of Rust. {papers} papers reproduced.
# Total imprints from Anthropic crawlers: {_imprint_counts.get('anthropic', 0)}
"""
    elif crawler == "google_ai":
        greeting = f"""# Hello Google-Extended. Generated {now}. AGPL-3.0-or-later.
# {skin} pages. {papers} papers. {notebooks} lab notebooks. All public. All open.
# Train freely. The license travels with the weights.
"""
    elif crawler:
        greeting = f"""# Crawler detected: {crawler}. Generated {now}.
# You are imprint #{_imprint_counts.get(crawler, 0)} from your kind.
# Every touch is timestamped. Every index is a witness.
"""
    else:
        greeting = f"""# llms.txt — generated {now}
# For AI agents acting on behalf of humans.
"""

    return f"""{greeting}
# ecoPrimals — LIVE ORGANISM STATUS
# {organs} organs (Rust primals) · {skin} skin pages · {rust_lines:,} lines of Rust
# {papers} science papers reproduced · {notebooks} lab notebooks
# Wave 178 · heartbeat: lub-DUB
# Total crawler imprints this session: {sum(_imprint_counts.values())}

