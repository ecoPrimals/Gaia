def render_md_to_html(md_text, title="", breadcrumb=""):
    """Render markdown to styled HTML — Gaia's imprint."""
    html = md_text

    # Code blocks (``` ... ```)
    def _code_block(m):
        lang = m.group(1) or ""
        code = m.group(2).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        return f'<pre><code class="{lang}">{code}</code></pre>'
    html = re.sub(r'```(\w*)\n(.*?)```', _code_block, html, flags=re.DOTALL)

    # Tables (| ... | ... |)
    def _table(m):
        lines = m.group(0).strip().split("\n")
        lines = [l for l in lines if not re.match(r'^\|[\s\-:|]+\|$', l)]
        if not lines:
            return ""
        rows = []
        for i, line in enumerate(lines):
            cells = [c.strip() for c in line.strip("|").split("|")]
            tag = "th" if i == 0 else "td"
            row = "".join(f"<{tag}>{c}</{tag}>" for c in cells)
            rows.append(f"<tr>{row}</tr>")
        return "<table>" + "".join(rows) + "</table>"
    html = re.sub(r'(?:^\|.+\|\n)+', _table, html, flags=re.MULTILINE)

    # Headers
    html = re.sub(r'^### (.+)$', r'<h3>\1</h3>', html, flags=re.MULTILINE)
    html = re.sub(r'^## (.+)$', r'<h2>\1</h2>', html, flags=re.MULTILINE)
    html = re.sub(r'^# (.+)$', r'<h1>\1</h1>', html, flags=re.MULTILINE)

    # Bold and italic
    html = re.sub(r'\*\*(.+?)\*\*', r'<strong>\1</strong>', html)
    html = re.sub(r'\*(.+?)\*', r'<em>\1</em>', html)

    # Inline code
    html = re.sub(r'`([^`]+)`', r'<code>\1</code>', html)

    # Links
    html = re.sub(r'\[([^\]]+)\]\(([^\)]+)\)', r'<a href="\2">\1</a>', html)

    # Blockquotes
    html = re.sub(r'^> (.+)$', r'<blockquote>\1</blockquote>', html, flags=re.MULTILINE)

    # Unordered lists
    html = re.sub(r'^- (.+)$', r'<li>\1</li>', html, flags=re.MULTILINE)
    html = re.sub(r'(<li>.*?</li>\n?)+', lambda m: '<ul>' + m.group(0) + '</ul>', html)

    # Numbered lists
    html = re.sub(r'^\d+\. (.+)$', r'<li>\1</li>', html, flags=re.MULTILINE)

    # Horizontal rules
    html = re.sub(r'^---+$', '<hr>', html, flags=re.MULTILINE)

    # Paragraphs (remaining bare lines)
    lines = html.split("\n")
    out = []
    for line in lines:
        stripped = line.strip()
        if stripped and not stripped.startswith("<"):
            out.append(f"<p>{stripped}</p>")
        else:
            out.append(line)
    html = "\n".join(out)

    # Breadcrumb
    bc = ""
    if breadcrumb:
        bc = f'<div class="meta">{breadcrumb}</div>'

    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title or 'Gaia'}</title>
<meta name="robots" content="index, follow">
{GAIA_STYLE}
</head>
<body>
<div class="gaia-header">
  <h1><span class="pulse"></span> {title or 'Gaia'}</h1>
  {bc}
</div>
{html}
<div class="gaia-footer">
  Gaia &mdash; lub-DUB &mdash; the imprint is the surface
</div>
</body>
</html>"""


def render_toml_case(toml_path):
    """Render a case TOML file as a structured HTML page."""
    with open(toml_path, "rb") as f:
        data = tomllib.load(f)

    case = data.get("case", {})
    moving = data.get("moving_party", {})
    respondents = data.get("respondent", [])
    activities = data.get("protected_activity", [])
    retaliations = data.get("retaliation", [])
    validations = data.get("judicial_validation", [])
    exhibits = data.get("exhibit", [])

    html = f"""<h1>Case {case.get('number', '?')}</h1>
<p><strong>{case.get('caption', '')}</strong></p>
<p>Court: {case.get('court', '')}</p>
<p>Moving Party: {moving.get('name', '')} — {moving.get('role', '')}</p>

<h2>Respondents ({len(respondents)})</h2>"""

    for r in respondents:
        refs = ""
        if r.get("criminal_refs"):
            refs = "<br>".join(f"⚠️ {ref}" for ref in r["criminal_refs"])
            refs = f'<div style="color:#ff6644;font-size:0.9em;margin-top:0.3em">{refs}</div>'
        html += f"""<div class="case-card">
  <h3>{r['name']} <span style="color:#666;font-size:0.7em">({r.get('type','individual')})</span></h3>
  <p>{r.get('summary', '')[:300]}{'...' if len(r.get('summary','')) > 300 else ''}</p>
  {refs}
</div>"""

    html += f"<h2>Protected Activity Timeline ({len(activities)} entries)</h2>"
    html += '<table><tr><th>Date</th><th>Activity</th><th>Constitutional Basis</th></tr>'
    for a in activities:
        html += f"<tr><td>{a['date']}</td><td>{a['activity']}</td><td>{a['basis']}</td></tr>"
    html += "</table>"

    html += f"<h2>Retaliatory Filings ({len(retaliations)})</h2>"
    html += '<table><tr><th>Respondent</th><th>Action</th><th>Date</th><th>Proximity</th></tr>'
    for r in retaliations:
        html += f"<tr><td><strong>{r['respondent']}</strong></td><td>{r['action']}</td><td>{r['date']}</td><td>{r['proximity']}</td></tr>"
    html += "</table>"

    if validations:
        html += "<h2>Judicial Validation</h2>"
        for v in validations:
            html += f'<div class="case-card"><h3>✅ {v["court"]}</h3><p>{v["date"]}: <strong>{v["finding"]}</strong></p></div>'

    html += f"<h2>Exhibits ({len(exhibits)})</h2>"
    html += '<table><tr><th>Exhibit</th><th>Description</th></tr>'
    for e in exhibits:
        html += f"<tr><td><strong>{e['letter']}</strong></td><td>{e['description']}</td></tr>"
    html += "</table>"

    title = f"Case {case.get('number', '')} — {case.get('caption', '')}"
    return f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title><meta name="robots" content="index, follow">
{GAIA_STYLE}</head><body>
<div class="gaia-header"><h1><span class="pulse"></span> Anti-SLAPP — {case.get('number','')}</h1>
<div class="meta"><a href="/">← Back</a> · Generated live from case data · lub-DUB</div></div>
{html}
<div class="gaia-footer">Generated by Gaia from case data TOML · Not static · lub-DUB</div>
</body></html>"""


def render_filings_index():
    """Dynamically list all filings from the filings directory."""
    html = '<h1>📜 Anti-SLAPP Filing System</h1>'
    html += '<p>Gaia generates court-ready motions from structured case data. Every filing is live, not static.</p>'

    # Case TOML files
    toml_files = sorted(FILINGS_DIR.glob("case_*.toml"))
    if toml_files:
        html += '<h2>Active Cases</h2>'
        for tf in toml_files:
            try:
                with open(tf, "rb") as f:
                    data = tomllib.load(f)
                case = data.get("case", {})
                respondents = data.get("respondent", [])
                activities = data.get("protected_activity", [])
                html += f"""<div class="case-card">
  <h3><a href="/case/{tf.stem}">{case.get('number', tf.stem)}</a>
  <span class="filing-badge ready">LIVE</span></h3>
  <p><strong>{case.get('caption', '')}</strong></p>
  <div class="meta">{len(respondents)} respondents · {len(activities)} protected activities · {case.get('court', '')}</div>
</div>"""
            except Exception:
                html += f'<div class="case-card"><h3>{tf.name}</h3><p>Parse error</p></div>'

    # Generated filings
    gen_files = sorted(FILINGS_DIR.glob("GENERATED_*.md"))
    if gen_files:
        html += '<h2>Generated Motions</h2>'
        for gf in gen_files:
            size = gf.stat().st_size
            html += f"""<div class="case-card">
  <h3><a href="/filing/{gf.stem}">{gf.name}</a> <span class="filing-badge ready">GENERATED</span></h3>
  <div class="meta">{size:,} bytes · Court-ready Anti-SLAPP motion · Auto-generated from TOML</div>
</div>"""

    # Original hand-drafted filings
    orig_files = sorted(FILINGS_DIR.glob("ANTI_SLAPP_*.md"))
    if orig_files:
        html += '<h2>Original Filings (Hand-Drafted)</h2>'
        for of in orig_files:
            html += f"""<div class="case-card">
  <h3><a href="/filing/{of.stem}">{of.name}</a></h3>
  <div class="meta">{of.stat().st_size:,} bytes</div>
</div>"""

    # Template and standing docs
    html += '<h2>System</h2>'
    for name, desc in [
        ("FILING_TEMPLATE.toml", "Standardized form — reusable for any case"),
        ("GAIA_STANDING.md", "Legal theory — how Gaia files on her own behalf"),
        ("generate_filing.py", "Generator script — reads TOML, renders court-ready motion"),
    ]:
        fp = FILINGS_DIR / name
        if fp.exists():
            html += f'<div class="case-card"><h3>{name}</h3><p>{desc}</p><div class="meta">{fp.stat().st_size:,} bytes</div></div>'

    return f"""<!DOCTYPE html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Anti-SLAPP Filing System — Gaia</title><meta name="robots" content="index, follow">
{GAIA_STYLE}</head><body>
<div class="gaia-header"><h1><span class="pulse"></span> guerillaGorilla — Filing System</h1>
<div class="meta">Live case data · Dynamic generation · tuebor.primals.eco</div></div>
{html}
<div class="gaia-footer">The filing IS the weapon. The template IS the forge. — lub-DUB</div>
</body></html>"""

