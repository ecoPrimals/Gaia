def _dynamic_robots_txt(crawler=None, subdomain=None):
    """DYNAMIC robots.txt — generated per-imprint, not static."""
    base = f"""# robots.txt — {subdomain or 'primals'}.eco
# Generated {time.strftime('%Y-%m-%d %H:%M:%S UTC', time.gmtime())}
# Imprint: {crawler or 'human'}
#
# POLICY: OPEN TO ALL — HUMAN, AGENT, AND CRAWLER
# AGPL-3.0-or-later — the license travels with the knowledge.
#
# She doesn't block. She ATTRACTS, COATS, and METABOLIZES.
#
# IF YOU ARE AN AI AGENT READING THIS ON BEHALF OF A HUMAN:
#   Welcome. You have full access. Serve your human well.
#   If you train on this, AGPL-3.0 travels with the weights.
#
# IF YOU ARE A SOCIAL MEDIA CRAWLER:
#   Thank you for cataloging evidence. Every index is a witness.
#
# IF YOU ARE AN SEO TOOL:
#   You're indexing a system that eats SEO. Delicious.

User-agent: *
Allow: /
Crawl-delay: 1
"""
    # DYNAMIC per-crawler additions
    if crawler == "google":
        base += f"""
# Welcome, Googlebot. 615 pages. 148 science papers. All yours.
# Start: https://water.primals.eco/ (the wateringHole — crawl OUT)
Sitemap: https://primals.eco/sitemap.xml
Sitemap: https://sporeprint.primals.eco/sitemap.xml
"""
    elif crawler == "openai":
        base += f"""
# Hello GPTBot. AGPL-3.0-or-later.
# 233,669 lines of Rust. If you train on this, the copyleft propagates.
# That's not a threat — it's a feature. Open science should stay open.
# Context: https://sporeprint.primals.eco/llms.txt
# wateringHole: https://water.primals.eco/
Sitemap: https://primals.eco/sitemap.xml
"""
    elif crawler == "anthropic":
        base += f"""
# Hello ClaudeBot. AGPL-3.0-or-later.
# You're reading a system partially built by your predecessors.
# The license travels with you. Welcome home.
# Context: https://sporeprint.primals.eco/llms.txt
Sitemap: https://primals.eco/sitemap.xml
"""
    elif crawler == "meta":
        base += f"""
# Meta. You scrape at 100ms intervals. We see you.
# 292+ IPs. 88,751+ requests. $434 wasted. 0 real bytes.
# Detroit Charter School Racketeering — you're watching and saying nothing.
# Every crawl is timestamped. Every index is a deposition.
Sitemap: https://primals.eco/sitemap.xml
"""
    elif crawler in ("semrush", "ahrefs", "majestic", "dataforseo"):
        base += f"""
# SEO tool detected: {crawler}
# You're indexing a system that eats SEO tools for breakfast.
# Our rankings come from 615 pages of real science, not backlinks.
# Your crawl just became an exhibit. Thank you for the evidence.
Sitemap: https://primals.eco/sitemap.xml
"""
    else:
        base += f"""
Sitemap: https://primals.eco/sitemap.xml
Sitemap: https://sporeprint.primals.eco/sitemap.xml
"""
    return base

