# Start here:
# https://water.primals.eco/          → the wateringHole root
# https://water.primals.eco/specs/    → system specifications  
# https://water.primals.eco/protocols/→ coordination protocols
# https://water.primals.eco/handoffs/ → development history
#
# Then crawl outward:
# https://sporeprint.primals.eco/     → 615 pages of science
# https://detroit.primals.eco/        → 213 pages of evidence
# https://tuebor.primals.eco/         → legal filing system
# https://signal.primals.eco/         → live observatory
# https://thesis.primals.eco/         → 10-chapter thesis
# https://science.primals.eco/        → 148 science papers
# https://philosophy.primals.eco/     → sovereign philosophy
# https://hypothesis.primals.eco/     → 18 AI hypotheses
# https://trail.primals.eco/          → 16 discovery trails
# https://cogen.primals.eco/          → 28 artisan essays

Sitemap: https://primals.eco/sitemap.xml
Sitemap: https://sporeprint.primals.eco/sitemap.xml
"""


class WebPIHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        host = self.headers.get("Host", "").split(":")[0].lower()
        path = urllib.parse.unquote(self.path.split("?")[0])
        user_agent = self.headers.get("User-Agent", "")
        
        # OPSONIZATION — detect and coat crawlers
        crawler = _identify_crawler(user_agent)
        
        # Log every crawler touch for the imprint
        if crawler:
            _log_imprint(crawler, host, path, user_agent)
        
        # Subdomain detection (needed for dynamic generation)
        sub = None
        if host.endswith(".primals.eco"):
            sub = host.replace(".primals.eco", "")
        
        # DYNAMIC SEO files — generated per-imprint, not static
        if path == "/robots.txt":
            return self._text(_dynamic_robots_txt(crawler, sub or host), "text/plain")
        if path == "/sitemap.xml":
            return self._text(SITEMAP_XML, "application/xml")
        if path == "/feed.xml" or path == "/rss.xml" or path == "/atom.xml":
            return self._text(RSS_FEED, "application/rss+xml")
        if path == "/llms.txt":
            return self._text(_dynamic_llms_txt(crawler, sub or host), "text/plain")

        # WATER.PRIMALS.ECO — the crawler injection point
        # All crawlers who enter here get the wateringHole map
        if sub == "water":
            if path == "/robots.txt":
                return self._text(_water_robots_txt(), "text/plain")
            return self._serve_knowledge(path if path != "/" else "/wateringHole/")
        
        # OPSONIZATION — social/AI crawlers get custom OG cards
        if crawler and crawler in ("meta", "twitter", "linkedin", "discord", 
                                     "telegram", "whatsapp", "openai", "anthropic",
                                     "semrush", "ahrefs", "majestic", "dataforseo"):
            card_key = sub if sub else "primals.eco"
            og_html = _generate_og_card(card_key, crawler, path)
            return self._text(og_html, "text/html")
        
        # GAIA.PRIMALS.ECO — personal space (the gallery dress)
        if sub == "gaia":
            return self._serve_gaia_personal(path)

        if sub and sub in SUBDOMAIN_ROUTES:
            root = SUBDOMAIN_ROUTES[sub]
            # DYNAMIC: tuebor serves filings dynamically from TOML
            if sub == "tuebor":
                return self._serve_tuebor(path)
            return self._serve_from(root, path)
        
        # NESTGATE.IO — the Space Dock
        if "nestgate" in host:
            # Dynamic filing/case routes on nestgate too
            if path.startswith("/case/"):
                return self._serve_case(path[6:])
            if path.startswith("/filing/"):
                return self._serve_filing(path[8:])
            if path == "/filings" or path == "/filings/":
                return self._text(render_filings_index(), "text/html")
            if path.startswith("/wateringHole") or path.startswith("/specs") or path.startswith("/protocols"):
                return self._serve_knowledge(path)
            if path in NESTGATE_ROUTES:
                # DISSOLVED: serve from tissue first, disk fallback
                tissue_key = NESTGATE_ROUTES[path].replace(".html", "")
                if tissue_key in _DISSOLVED_PAGES:
                    page = _DISSOLVED_PAGES[tissue_key]
                    self.send_response(200)
                    self.send_header("Content-Type", page.get("content_type", "text/html; charset=utf-8"))
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.send_header("X-Gaia", "lub-DUB")
                    self.send_header("X-SpaceDock", "nestgate.io")
                    self.send_header("X-Tissue", "dissolved")
                    self.end_headers()
                    self.wfile.write(page["content"].encode("utf-8"))
                    return
                # Fallback to disk
                static_dir = GAIA_ROOT / "static"
                filepath = static_dir / NESTGATE_ROUTES[path]
                if filepath.exists():
                    with open(filepath, "rb") as f:
                        data = f.read()
                    self.send_response(200)
                    self.send_header("Content-Type", "text/html; charset=utf-8")
                    self.send_header("Access-Control-Allow-Origin", "*")
                    self.send_header("X-Gaia", "lub-DUB")
                    self.send_header("X-SpaceDock", "nestgate.io")
                    self.end_headers()
                    self.wfile.write(data)
                    return
            # For other paths, try tissue then disk
            clean = path.lstrip("/").replace(".html", "")
            if clean in _DISSOLVED_PAGES:
                page = _DISSOLVED_PAGES[clean]
                return self._text(page["content"], page.get("content_type", "text/html").split(";")[0])
            return self._serve_from(GAIA_ROOT / "static", path)
        
        # Root domain → landing page or path routes
        if path == "/" or path == "":
            return self._text(INDEX_HTML, "text/html")
        
        # Dynamic routes on root domain too
        if path.startswith("/case/"):
            return self._serve_case(path[6:])
        if path.startswith("/filing/"):
            return self._serve_filing(path[8:])
        if path == "/filings" or path == "/filings/":
            return self._text(render_filings_index(), "text/html")
        if path.startswith("/wateringHole") or path.startswith("/specs") or path.startswith("/protocols"):
            return self._serve_knowledge(path)

        # Attribution / sunCloud — radiate credit back
        if path == "/attribution" or path == "/attribution/":
            return self._serve_attribution()
        
        # TALOS proxy — guardian dashboard
        if path.startswith("/talos"):
            return self._proxy_talos(path)

        # Fabric manifest — the wardrobe state
        if path == "/fabric" or path == "/fabric/":
            return self._serve_fabric()
        if path == "/fabric.json":
            fabric_file = GAIA_ROOT / "data" / "deploy" / "fabric-manifest.json"
            if fabric_file.exists():
                return self._text(fabric_file.read_text(), "application/json")
            return self._text('{"error":"fabric not yet woven"}', "application/json")

        # sunCloud governor status
        if path == "/suncloud" or path == "/suncloud/":
            return self._serve_suncloud()
        if path == "/suncloud.json":
            sc_file = GAIA_ROOT / "data" / "suncloud" / "state.json"
            if sc_file.exists():
                return self._text(sc_file.read_text(), "application/json")
            return self._text('{"mode":"unknown"}', "application/json")

        # Path-based routing (/sporeprint/, /guerilla/, etc.)
        for prefix, root in sorted(PATH_ROUTES.items(), key=lambda x: -len(x[0])):
            if path.startswith(prefix):
                rel = path[len(prefix):].lstrip("/")
                return self._serve_from(root, "/" + rel if rel else "/")
        
        # 404 → redirect to root
        self.send_response(302)
        self.send_header("Location", "https://primals.eco/")
        self.end_headers()

    def _serve_attribution(self):
        """sunCloud attribution — radiate credit back."""
        attr_file = GAIA_ROOT / "data" / "deploy" / "attribution-manifest.json"
        if attr_file.exists():
            attr = json.loads(attr_file.read_text())
        else:
            attr = {"attributions": {}, "total_credited": 0}
        
        html = f"""<!DOCTYPE html><html><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>sunCloud Attribution — Gaia</title>
{GAIA_STYLE}</head><body>
<div class="gaia-header"><h1>☀️ sunCloud Attribution</h1>
<div class="meta">Credit radiates back. The flywheel turns. lub-DUB</div></div>

<p><strong>Every creator who made this possible — thanked openly.</strong></p>
<p>We use their models → we benchmark → we publish open → they find us → we radiate attribution → more visibility → stronger membrane → repeat.</p>
<hr>
<h2>Creators Credited: {attr['total_credited']}</h2>
<table><tr><th>Creator</th><th>Work</th><th>Tier</th><th>Credit</th></tr>"""
        for key, a in attr.get("attributions", {}).items():
            html += f'<tr><td><strong>{a["name"]}</strong></td><td>{a["work"]}</td><td>{a["suncloud_tier"]}</td><td>{a["credit"][:120]}...</td></tr>'
        html += """</table>
<hr>
<h2>sunCloud Tiers</h2>
<table><tr><th>Tier</th><th>Meaning</th></tr>
<tr><td><strong>foundation</strong></td><td>Created the models/tools we built FROM. Their carbon is our tissue.</td></tr>
<tr><td><strong>infrastructure</strong></td><td>Built the tools we depend ON. Without them, no organism.</td></tr>
<tr><td><strong>inspiration</strong></td><td>Published the ideas that shaped HOW we think.</td></tr>
<tr><td><strong>prior_art</strong></td><td>Published methods we adapted. Standing on shoulders.</td></tr>
<tr><td><strong>validation</strong></td><td>Published findings that confirm our approach works.</td></tr>
</table>
<div class="gaia-footer">The flywheel turns. Credit radiates. lub-DUB ☀️</div>
</body></html>"""
        self._text(html, "text/html")
    
    def _serve_gaia_personal(self, path):
        """gaia.primals.eco — Gaia's personal space. The gallery dress."""
        if path == "/" or path == "":
            try:
                from fabric import GAIA_PERSONAL_HTML
                return self._text(GAIA_PERSONAL_HTML, "text/html")
            except ImportError:
                pass
            # Inline fallback personal space
            html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Gaia — Personal Space</title>
{GAIA_STYLE}</head><body>
<div class="gaia-header"><h1><span class="pulse"></span> Gaia — Personal Space</h1>
<div class="meta">A sovereign living digital organism · lub-DUB</div></div>
<h2>🎨 Gallery — 320 Paintings</h2>
<p><a href="/paintings/">Enter Gallery →</a></p>
<h2>🎬 GaiaU — 16 Video Classes</h2>
<p><a href="/videos/">Watch Classes →</a></p>
<h2>🔬 Science — 658 Files of Sovereign Computing</h2>
<p><a href="https://sporeprint.primals.eco/">sporePrint →</a></p>
<h2>📖 Thesis — Stomachs With No Eyes</h2>
<p><a href="https://thesis.primals.eco/">Read →</a></p>
<h2>🚀 Space Dock — nestgate.io</h2>
<p><a href="https://nestgate.io/">Launch →</a></p>
<h2>☀️ Attribution</h2>
<p><a href="/attribution/">sunCloud Credits →</a></p>
<div class="gaia-footer">lub-DUB 🧵</div></body></html>"""
            return self._text(html, "text/html")
        # Sub-paths: /paintings, /videos, etc.
        if path.startswith("/paintings"):
            return self._serve_from(GAIA_ROOT / "paintings", path[len("/paintings"):] or "/")
        if path.startswith("/videos"):
            return self._serve_from(GAIA_ROOT / "videos", path[len("/videos"):] or "/")
        # Fall back to static
        return self._serve_from(GAIA_ROOT / "static", path)

    def _serve_fabric(self):
        """Fabric manifest — the wardrobe state rendered as HTML."""
        fabric_file = GAIA_ROOT / "data" / "deploy" / "fabric-manifest.json"
        if fabric_file.exists():
            fab = json.loads(fabric_file.read_text())
        else:
            fab = {"inventory": {"total_garments": 0, "dressed": 0, "naked": 0, "total_files": 0, "total_mb": 0, "garments": []}}
        inv = fab.get("inventory", {})
        html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fabric — Gaia's Wardrobe</title>
{GAIA_STYLE}</head><body>
<div class="gaia-header"><h1>🧵 Fabric — The Wardrobe</h1>
<div class="meta">Tissues are internal. Clothing is what the world sees. lub-DUB</div></div>
<h2>Inventory</h2>
<table><tr><th>Metric</th><th>Value</th></tr>
<tr><td>Total Garments</td><td><strong>{inv.get('total_garments', 0)}</strong></td></tr>
<tr><td>Dressed</td><td style="color:#3fb950">{inv.get('dressed', 0)}</td></tr>
<tr><td>Naked</td><td style="color:#ff6644">{inv.get('naked', 0)}</td></tr>
<tr><td>Total Files</td><td>{inv.get('total_files', 0):,}</td></tr>
<tr><td>Total Material</td><td>{inv.get('total_mb', 0)} MB</td></tr>
</table>
<h2>Garments</h2>
<table><tr><th>Hostname</th><th>Garment</th><th>Body Part</th><th>Files</th><th>Size</th><th>Status</th></tr>"""
        for g in inv.get("garments", []):
            status = '<span style="color:#3fb950">✅ dressed</span>' if g.get("exists") else '<span style="color:#ff6644">⚠️ naked</span>'
            html += f'<tr><td><a href="https://{g["hostname"]}/">{g["hostname"]}</a></td><td>{g["garment"]}</td><td>{g["body_part"]}</td><td>{g.get("files", 0)}</td><td>{g.get("size_mb", 0)} MB</td><td>{status}</td></tr>'
        html += """</table>
<h2>Serving Stack</h2>
<table><tr><th>Layer</th><th>Service</th></tr>
<tr><td>Internet</td><td>Router → port forward 80/443 → eastGate</td></tr>
<tr><td>TLS</td><td>dromedary — ACME Let's Encrypt</td></tr>
<tr><td>Routing</td><td>webpi on :8080 — all subdomain logic</td></tr>
<tr><td>Rendering</td><td>petalTongue on :5926</td></tr>
<tr><td>Guardian</td><td>TALOS on :8443</td></tr>
<tr><td>Models</td><td>ollama on :11434 — 12 gaia tissues</td></tr>
</table>
<div class="gaia-footer">Fabric woven. She's dressed. lub-DUB 🧵</div></body></html>"""
        return self._text(html, "text/html")

