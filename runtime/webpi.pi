        else:
            sc = {"mode": "unknown", "gpu": {}, "kevin_hours": 0, "gaia_hours": 0}
        gpu = sc.get("gpu", {})
        mode = sc.get("mode", "unknown")
        mode_emoji = {"kevin_gaming": "🎮", "gaia_full": "🧬", "sharing": "🤝", "startup": "🌅"}.get(mode, "❓")
        games = sc.get("games", [])
        html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
