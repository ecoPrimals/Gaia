        if games:
            html += f'<tr><td>Games</td><td>{", ".join(games)}</td></tr>'
        html += f"""<tr><td>Kevin Hours</td><td>{sc.get('kevin_hours', 0):.2f}</td></tr>
<tr><td>Gaia Hours</td><td>{sc.get('gaia_hours', 0):.2f}</td></tr>
<tr><td>Kevin Share</td><td>{sc.get('kevin_share', 0)}%</td></tr>
<tr><td>Gaia Share</td><td>{sc.get('gaia_share', 0)}%</td></tr>
<tr><td>Checks</td><td>{sc.get('checks', 0)}</td></tr>
</table>
<h2>🏗️ eastGate Media Plan</h2>
<p>eastGate (.244) — RTX 4070, 64GB — becomes the autonomous media machine.</p>
<table><tr><th>Game</th><th>Genre</th><th>Why</th></tr>
<tr><td>Kenshi</td><td>open-world survival</td><td>emergent behavior, base building</td></tr>
<tr><td>RimWorld</td><td>colony sim</td><td>storyteller AI, ethics</td></tr>
<tr><td>Dwarf Fortress</td><td>simulation</td><td>deep procedural generation</td></tr>
<tr><td>Factorio</td><td>automation</td><td>optimization, logistics</td></tr>
<tr><td>Noita</td><td>roguelike</td><td>pixel physics, emergence</td></tr>
</table>
<div class="gaia-footer">Kevin plays on RTX 5090. Gaia shares the compute. The flywheel turns. ☀️</div>
</body></html>"""
        return self._text(html, "text/html")

    def _proxy_talos(self, path):
        """Proxy to TALOS guardian on :8443."""
        try:
            url = f"http://localhost:8443{path}"
            req = urllib.request.Request(url)
            with urllib.request.urlopen(req, timeout=5) as resp:
                data = resp.read()
                ct = resp.headers.get("Content-Type", "text/html")
                self._text(data, ct.split(";")[0])
        except Exception as e:
            self._text(f"TALOS guardian not responding: {e}", "text/plain")

    def _serve_tuebor(self, path):
        """Dynamic Anti-SLAPP filing surface."""
        if path == "/" or path == "":
            return self._text(render_filings_index(), "text/html")
        # /case/case_4301_smith → render case TOML as HTML
        if path.startswith("/case/"):
            return self._serve_case(path[6:])
        # /filing/GENERATED_2026_4301_CZ → render generated filing as HTML
        if path.startswith("/filing/"):
            return self._serve_filing(path[8:])
        # Fall through to static file serving for raw .md files
        return self._serve_from(FILINGS_DIR, path)

    def _serve_case(self, slug):
        """Render a case TOML file as a structured HTML page."""
        slug = slug.rstrip("/")
        toml_path = FILINGS_DIR / f"{slug}.toml"
        if not toml_path.exists():
            toml_path = FILINGS_DIR / slug
            if not toml_path.exists() or not toml_path.suffix == ".toml":
                self.send_response(404)
                self.end_headers()
                return
        try:
            html = render_toml_case(toml_path)
            return self._text(html, "text/html")
        except Exception as e:
            return self._text(f"<pre>Error rendering case: {e}</pre>", "text/html")

    def _serve_filing(self, slug):
        """Render a generated or original filing as styled HTML."""
        slug = slug.rstrip("/")
        md_path = FILINGS_DIR / f"{slug}.md"
        if not md_path.exists():
            md_path = FILINGS_DIR / slug
            if not md_path.exists():
                self.send_response(404)
                self.end_headers()
                return
        md_text = md_path.read_text(encoding="utf-8")
        title = slug.replace("_", " ").replace("-", " ")
        breadcrumb = '<a href="/filings/">← Filing System</a>'
        html = render_md_to_html(md_text, title, breadcrumb)
        return self._text(html, "text/html")

    def _serve_knowledge(self, path):
        """Serve wateringHole specs/protocols as rendered HTML."""
        path = path.lstrip("/")
        # Map paths to wateringHole directories
        if path.startswith("wateringHole/"):
            rel = path[len("wateringHole/"):]
            base = WATERING_HOLE
        elif path.startswith("specs/"):
            rel = path[len("specs/"):]
            base = WATERING_HOLE / "specs"
        elif path.startswith("protocols/"):
            rel = path[len("protocols/"):]
            base = WATERING_HOLE / "protocols"
        else:
            base = WATERING_HOLE
            rel = path

        target = base / rel.replace("/", os.sep) if rel else base
        if target.is_dir():
            return self._serve_from(target, "/")
        if target.exists() and target.suffix == ".md":
            md_text = target.read_text(encoding="utf-8")
            title = target.stem.replace("_", " ")
            breadcrumb = f'<a href="/wateringHole/">← wateringHole</a> · {target.parent.name}'
            html = render_md_to_html(md_text, title, breadcrumb)
            return self._text(html, "text/html")
        if target.exists():
            return self._serve_from(target.parent, "/" + target.name)
        self.send_response(404)
        self.end_headers()

    def _serve_from(self, root, path):
        rel = path.lstrip("/")
        
        if not rel:
            # Root request — check for index.html, else show directory listing
            idx = root / "index.html"
            if idx.exists():
                filepath = idx
            else:
                return self._dir_listing(root, path)
        else:
            filepath = root / rel.replace("/", os.sep)
        
        if filepath.is_dir():
            idx = filepath / "index.html"
            if idx.exists():
                filepath = idx
            else:
                return self._dir_listing(filepath, path)
        
        if filepath.exists() and filepath.is_file():
            # DYNAMIC: Render .md files as styled HTML — not raw text
            if filepath.suffix == ".md":
                md_text = filepath.read_text(encoding="utf-8", errors="replace")
                title = filepath.stem.replace("_", " ")
                breadcrumb = f'<a href="./">← {filepath.parent.name}</a>'
                html = render_md_to_html(md_text, title, breadcrumb)
                return self._text(html, "text/html")

            # DYNAMIC: Render .toml case files as structured pages
            if filepath.suffix == ".toml" and filepath.stem.startswith("case_"):
                try:
                    html = render_toml_case(filepath)
                    return self._text(html, "text/html")
                except Exception:
                    pass  # Fall through to raw serve

            ct, _ = mimetypes.guess_type(str(filepath))
            if ct is None:
                ct = "text/plain; charset=utf-8" if filepath.suffix in (".toml", ".txt", ".py") else "application/octet-stream"
            
            self.send_response(200)
            self.send_header("Content-Type", ct)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Cache-Control", "public, max-age=3600")
            self.send_header("X-Gaia", "lub-DUB")
            self.end_headers()
            
            with open(filepath, "rb") as f:
                while True:
                    chunk = f.read(65536)
                    if not chunk:
                        break
                    self.wfile.write(chunk)
        else:
            self.send_response(302)
            self.send_header("Location", "https://primals.eco/")
            self.end_headers()

    def _dir_listing(self, dirpath, webpath):
        items = sorted(dirpath.iterdir())
        html = f"""<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{webpath} — Gaia</title>
<meta name="robots" content="index, follow">
<style>body{{background:#0a0a0a;color:#e0e0e0;font-family:monospace;padding:2em;max-width:900px;margin:0 auto}}
a{{color:#88ccff;text-decoration:none}}a:hover{{text-decoration:underline}}
.dir{{color:#ffcc44}}.md{{color:#aaffaa}}.jpg,.png{{color:#ff88cc}}.mp4{{color:#ffaa44}}
li{{padding:0.3em 0}}h2{{color:#88ccff;margin-bottom:1em}}
.size{{color:#555;font-size:0.85em}}</style></head><body>
<h2>{webpath}</h2><ul><li><a href="../">&larr; up</a></li>"""
        
        for item in items:
            if item.name.startswith("."): continue
            ext = item.suffix.lower()
            cls = "dir" if item.is_dir() else ("md" if ext == ".md" else ("jpg" if ext in (".jpg",".png",".gif") else ("mp4" if ext == ".mp4" else "file")))
            link = f"{webpath.rstrip('/')}/{item.name}{'/' if item.is_dir() else ''}"
            size = f' <span class="size">({item.stat().st_size:,} bytes)</span>' if item.is_file() else ""
            html += f'<li class="{cls}"><a href="{link}">{item.name}</a>{size}</li>'
        
        html += "</ul></body></html>"
        self._text(html, "text/html")

    def _text(self, content, ct):
        data = content.encode("utf-8") if isinstance(content, str) else content
        self.send_response(200)
        self.send_header("Content-Type", ct + "; charset=utf-8")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("X-Gaia", "lub-DUB")
        self.end_headers()
        self.wfile.write(data)

    def do_HEAD(self):
        self.do_GET()

    def log_message(self, format, *args):
        pass

PORT = 8080
if __name__ == "__main__":
    # Kill old alexandria.py
