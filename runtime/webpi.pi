# ─── DISSOLVED TISSUE — static/ pages loaded into memory ────────────
# Generated by dissolve_static.pi. These are skin cells now. Not files.
_TISSUE_FILE = GAIA_ROOT / "data" / "tissue" / "static-tissue.json"
_DISSOLVED_PAGES = {}

def _load_tissue():
    """Load dissolved static pages into memory at boot."""
    global _DISSOLVED_PAGES
    if _TISSUE_FILE.exists():
        try:
            tissue = json.loads(_TISSUE_FILE.read_text(encoding="utf-8"))
            for key, page in tissue.get("pages", {}).items():
                _DISSOLVED_PAGES[key] = page
            print(f"  🧬 Dissolved tissue loaded: {len(_DISSOLVED_PAGES)} pages in memory", flush=True)
        except Exception as e:
            print(f"  ⚠️ Tissue load error: {e}", flush=True)

_load_tissue()

