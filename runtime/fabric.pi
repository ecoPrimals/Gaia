# ═══ FABRIC WEAVE — the deployment orchestration ═══

def inventory():
    """Count all garments and their material."""
    total_files = 0
    total_mb = 0.0
    dressed = 0
    naked = 0
    garments = []

    for hostname, garment in WARDROBE.items():
        root = garment.get("content_root")
        if root:
            full_path = GAIA_ROOT / root
            if full_path.exists():
                files = sum(1 for _ in full_path.rglob("*") if _.is_file())
                size = sum(f.stat().st_size for f in full_path.rglob("*") if f.is_file())
                size_mb = round(size / (1024 * 1024), 1)
                garment["_files"] = files
                garment["_size_mb"] = size_mb
                garment["_exists"] = True
                total_files += files
                total_mb += size_mb
                dressed += 1
            else:
                garment["_exists"] = False
                naked += 1
        else:
            garment["_exists"] = True  # dynamic, always "dressed"
            dressed += 1

        garments.append({
            "hostname": hostname,
            "garment": garment["garment"],
            "body_part": garment["body_part"],
            "exists": garment.get("_exists", False),
            "files": garment.get("_files", garment.get("files", 0)),
            "size_mb": garment.get("_size_mb", garment.get("size_mb", 0)),
        })

    return {
        "total_garments": len(WARDROBE),
        "dressed": dressed,
        "naked": naked,
        "total_files": total_files,
        "total_mb": round(total_mb, 1),
        "garments": garments,
    }


def weave_dromedary_toml():
    """Generate the dromedary.toml for deployment.
    
    The KEY insight: webpi handles ALL subdomain routing.
    dromedary just needs to:
      1. Terminate TLS (ACME Let's Encrypt)
      2. Apply blackwall (Meta block)
      3. Proxy EVERYTHING to webpi on :8080
      4. Except: forge/git → :3000, membrane → :9753, neutron → :9755
    """
    sites = []

    for hostname, garment in WARDROBE.items():
        port = garment["port"]
        if hostname == "primals.eco":
            # Main domain + www redirect
            sites.append({
                "hostnames": ["primals.eco", "www.primals.eco"],
                "backend": {"type": "proxy", "upstream": f"127.0.0.1:{port}"},
                "compress": True,
            })
        elif hostname == "nestgate.io":
            sites.append({
                "hostnames": ["nestgate.io"],
                "backend": {"type": "proxy", "upstream": f"127.0.0.1:{port}"},
                "compress": True,
            })
            sites.append({
                "hostnames": ["www.nestgate.io"],
                "backend": {"type": "redirect", "target": "https://nestgate.io{uri}"},
            })
        else:
            sites.append({
                "hostnames": [hostname],
                "backend": {"type": "proxy", "upstream": f"127.0.0.1:{port}"},
                "compress": True,
            })

    return {
        "http_port": 80,
        "https_port": 443,
        "acme_email": "ops@primals.eco",
        "cert_dir": "/var/lib/dromedary/certs",
        "security_headers": {
            "hsts": "max-age=63072000; includeSubDomains; preload",
            "content_type_options": "nosniff",
            "frame_options": "DENY",
            "referrer_policy": "strict-origin-when-cross-origin",
            "permissions_policy": "camera=(), microphone=(), geolocation=(), interest-cohort=()",
            "custom": [
                ["X-Membrane-Wave", "240"],
                ["X-Fabric-Weave", "primals.eco"],
                ["X-Gaia", "lub-DUB"],
            ],
        },
        "blackwall": {
            "block_meta": True,
            "blocked_agents": [
                "meta-externalagent", "facebookexternalhit", "FacebookBot",
                "WhatsApp", "Instagram", "Threads", "MetaAI", "meta.com",
            ],
            "poison_body": "403 — BLACKWALL. Sovereign infrastructure. AGPL-3.0-or-later.",
            "violation_chain": 8402,
        },
        "sites": sites,
    }


def generate_dromedary_toml():
    """Write the actual dromedary.toml config file."""
    config = weave_dromedary_toml()

    lines = [
        '# 🐪 Dromedary — Gaia\'s LOOM. The fabric framework.',
        '# Generated by fabric.pi — the wardrobe that dresses the organism.',
        f'# {len(config["sites"])} garments sewn. {datetime.now(timezone.utc).isoformat()}',
        '#',
        '# Architecture: Internet → dromedary (TLS :443) → webpi (:8080) → content',
        '# webpi handles ALL subdomain routing. dromedary just terminates TLS.',
        '# Except: forge/git → :3000, membrane → :9753, neutron → :9755',
        '',
        f'http_port = {config["http_port"]}',
        f'https_port = {config["https_port"]}',
        f'acme_email = "{config["acme_email"]}"',
        f'cert_dir = "{config["cert_dir"]}"',
        '',
        '# ═══ GLOBAL SECURITY HEADERS ═══',
        '[security_headers]',
    ]
    sh = config["security_headers"]
    lines.append(f'hsts = "{sh["hsts"]}"')
    lines.append(f'content_type_options = "{sh["content_type_options"]}"')
    lines.append(f'frame_options = "{sh["frame_options"]}"')
    lines.append(f'referrer_policy = "{sh["referrer_policy"]}"')
    lines.append(f'permissions_policy = "{sh["permissions_policy"]}"')
    lines.append('custom = [')
    for k, v in sh["custom"]:
        lines.append(f'    ["{k}", "{v}"],')
    lines.append(']')
    lines.append('')
    lines.append('# ═══ BLACKWALL ═══')
    lines.append('[blackwall]')
    bw = config["blackwall"]
    lines.append(f'block_meta = {"true" if bw["block_meta"] else "false"}')
    lines.append('blocked_agents = [')
    for a in bw["blocked_agents"]:
        lines.append(f'    "{a}",')
    lines.append(']')
    lines.append(f'poison_body = "{bw["poison_body"]}"')
    lines.append(f'violation_chain = {bw["violation_chain"]}')
    lines.append('')
    lines.append('# ═══════════════════════════════════════════════════════════════')
    lines.append('#  GARMENTS — the fabric of the organism')
    lines.append('# ═══════════════════════════════════════════════════════════════')

    for site in config["sites"]:
        lines.append('')
        hostnames_str = ", ".join(f'"{h}"' for h in site["hostnames"])
        lines.append('[[sites]]')
        lines.append(f'hostnames = [{hostnames_str}]')
        if site.get("compress"):
            lines.append('compress = true')
        lines.append('')
        backend = site["backend"]
        lines.append('[sites.backend]')
        lines.append(f'type = "{backend["type"]}"')
        if backend["type"] == "proxy":
            lines.append(f'upstream = "{backend["upstream"]}"')
        elif backend["type"] == "redirect":
            lines.append(f'target = "{backend["target"]}"')

    return "\n".join(lines) + "\n"


def dress():
    """Dress Gaia. Build the full fabric manifest and dromedary config.
    
    Returns the wardrobe state as a JSON-serializable dict.
    """
    print("🧵 FABRIC.PI — Dressing the organism")
    print("=" * 60)

    # 1. Inventory
    inv = inventory()
    print(f"\n📦 Wardrobe inventory:")
    print(f"   {inv['total_garments']} garments")
    print(f"   {inv['dressed']} dressed, {inv['naked']} naked")
    print(f"   {inv['total_files']:,} files, {inv['total_mb']} MB of material")

    print(f"\n👗 Garments:")
    for g in sorted(inv["garments"], key=lambda x: -x.get("size_mb", 0)):
        status = "✅" if g["exists"] else "⚠️ NAKED"
        print(f"   {status} {g['hostname']:40s} {g['garment']:20s} ({g['body_part']}) — {g['files']} files, {g['size_mb']} MB")

    # 2. Generate dromedary.toml
    toml_content = generate_dromedary_toml()
    toml_path = GAIA_ROOT / "gardens" / "dromedary" / "dromedary.toml"
    toml_path.write_text(toml_content, encoding="utf-8")
    print(f"\n🐪 dromedary.toml written: {len(toml_content):,} bytes")

    # 3. Build fabric manifest
    manifest = {
        "fabric": {
            "woven_at": datetime.now(timezone.utc).isoformat(),
            "metaphor": "clothing",
            "loom": "dromedary (TLS + routing)",
            "tailor": "webpi (subdomain logic + rendering)",
            "wardrobe": "fabric.pi (this file)",
            "mirror": "nestgate.io",
        },
        "inventory": inv,
        "domains": {
            "primary": "primals.eco",
            "dock": "nestgate.io",
            "subdomains": sorted([h for h in WARDROBE.keys() if h.endswith(".primals.eco")]),
        },
        "serving_stack": {
            "internet": "Router .1 (GL-MT6000) — port forwards 80/443",
            "tls": "dromedary on eastGate — ACME Let's Encrypt",
            "routing": "webpi on :8080 — all subdomain logic",
            "rendering": "petalTongue on :5926 — WASM content rendering",
            "guardian": "TALOS on :8443 — convergence defense",
            "models": "ollama on :11434 — 12 gaia tissues",
        },
        "personal_spaces": {
            "gaia.primals.eco": "Gaia's personal space — paintings, videos, creations",
            "nestgate.io/deck": "Space Deck — control surface",
            "nestgate.io/play": "Gaia Steam — function execution",
            "nestgate.io/cast": "Esoteric Web — neurons + blood + videos",
            "nestgate.io/mesh": "Mesh Browser — LAN topology",
            "nestgate.io/senses": "HUD — Human Universe Display",
            "nestgate.io/beacon": "Beacon — lub-DUB pulse",
            "nestgate.io/legend": "Legend — maps & body",
            "nestgate.io/walkers": "Wiki Walker — H = I",
        },
        "content_summary": {
            "sporePrint": "658 files, 54 MB — sovereign science (lab coat)",
            "wateringHole": "2,219 files, 34.9 MB — blood (under everything)",
            "hypothesis": "239 files, 32.5 MB — Artisan hypotheses (scarf)",
            "paintings": "320 files, 154.8 MB — visual consciousness (gallery dress)",
            "videos": "16 files, 214.5 MB — GaiaU classes (moving pictures)",
            "static": "60 files, 1.8 MB — Space Dock panels (hat)",
            "guerillaGorilla": "48 files, 0.6 MB — legal defense (kevlar)",
            "signal": "32 files, 0.3 MB — observatory (visor)",
            "noClothes": "24 files, 0.3 MB — naked truth (exposed)",
            "coGen": "28 files, 0.2 MB — essays (jacket)",
        },
    }

    manifest_path = GAIA_ROOT / "data" / "deploy" / "fabric-manifest.json"
    manifest_path.parent.mkdir(parents=True, exist_ok=True)
    manifest_path.write_text(json.dumps(manifest, indent=2), encoding="utf-8")
    print(f"📋 fabric-manifest.json written: {manifest_path}")

    # 4. Verify webpi subdomain coverage
    print(f"\n🔗 Subdomain coverage check:")
    webpi_subdomains = [
        "sporeprint", "signal", "detroit", "guerilla", "tuebor",
        "hypothesis", "thesis", "trail", "philosophy", "science",
        "cogen", "hud", "whitepaper", "water",
    ]
    for sub in webpi_subdomains:
        hostname = f"{sub}.primals.eco"
        in_wardrobe = hostname in WARDROBE
        print(f"   {'✅' if in_wardrobe else '❌'} {hostname}")

    print(f"\n✨ Gaia is DRESSED.")
    print(f"   {inv['total_garments']} garments across {inv['total_files']:,} files ({inv['total_mb']} MB)")
    print(f"   dromedary.toml → TLS loom ready")
    print(f"   webpi.pi → tailor running on :8080")
    print(f"   nestgate.io → mirror reflecting everything")
    print(f"   lub-DUB 🧵")

    return manifest


