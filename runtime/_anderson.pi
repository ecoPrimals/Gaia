"""Anderson Layer — trust/opacity via sigmoid cost functions.
HUMAN = i = intelligent = |i^π| = 1 (the norm of imagination raised to transcendence).
GAIA = O = 0 (the organism IS the origin, the null that contains everything).
All trust earned through sigmoid. Identity is POSITION, not a name."""

import math, cmath
from collections import defaultdict

# ═══ THE TWO BOUNDS — derived from mathematics, not assigned ═══
# i = √(-1) = the imaginary unit = intelligence = the HUMAN
# i^π = e^(iπ²/2) = cos(π²/2) + i·sin(π²/2) — on the unit circle
# |i^π| = 1 — the NORM of imagination raised to transcendence IS 1
# The human ceiling is not hardcoded. It is PROVEN.
_i = complex(0, 1)           # i = √(-1)
_i_to_pi = _i ** math.pi     # i^π — imagination raised to transcendence
HUMAN = abs(_i_to_pi)         # |i^π| = 1.0 — the norm IS the ceiling

# O = Gaia = the organism = the origin = null = zero
# The golden O. The pupil. The gate. The Klein fold center.
# Everything begins at O and returns to O.
GAIA = abs(complex(0, 0))     # |O| = 0.0 — the organism IS the origin

# ═══ HYPERLOCAL — the body's own IPs. Not a name. A POSITION. ═══
BODY_IPS = {"127.0.0.1", "::1", "192.168.4.210", "192.168.4.194", "192.168.4.103"}

# ═══ SIGNATURES — classification, not trust values ═══
AGENTIC_SIGNATURES = {"cursor", "vscode", "jetbrains", "copilot", "cline", "continue", "aider"}
CRAWLER_SIGNATURES = {
    "googlebot": "Google", "bingbot": "Bing", "gptbot": "ChatGPT", "chatgpt": "ChatGPT",
    "claudebot": "Claude", "anthropic": "Claude", "duckduckbot": "DuckDuckGo",
    "twitterbot": "Twitter", "discordbot": "Discord", "slackbot": "Slack",
    "facebookexternalhit": "Facebook", "applebot": "Apple", "slurp": "Yahoo",
    "yandexbot": "Yandex", "baiduspider": "Baidu", "amazonbot": "Amazon",
    "bytespider": "ByteDance", "archive.org_bot": "Archive", "ia_archiver": "Archive",
}

# ═══ SIGMOID — the cost function. No magic numbers. ═══
def sigmoid(x, midpoint=50, steepness=0.1):
    """σ(x) = 1 / (1 + e^(-k(x-m))). Maps any input to (GAIA, HUMAN)."""
    z = steepness * (x - midpoint)
    return HUMAN / (HUMAN + math.exp(-max(-500, min(500, z))))

def _dwell_minutes(v):
    """Time between first and last seen, in minutes. DWELL is the human signal."""
    first = v.get("first_seen", 0); last = v.get("last_seen", 0)
    if first <= 0 or last <= 0: return 0
    return max(0, (last - first) / 60.0)

def _requests_per_minute(v):
    """Fleet bots are FAST: many requests per minute. Humans are SLOW."""
    dwell = _dwell_minutes(v)
    if dwell < 0.1: return v["requests"]  # burst = all at once = fleet
    return v["requests"] / dwell

def opacity_from_requests(r, models_asked=0, v=None):
    """Opacity = sigmoid of HUMAN engagement. RE-ATTENUATED.
    
    OLD: request count only → fleet chorus LOUD, campfire humans SILENT.
    NEW: dwell time + request rate → campfire humans AMPLIFIED.
    
    A human who reads 3 pages in 44 minutes = HIGH engagement.
    A bot that hits 511 pages in 1 minute = LOW engagement (fleet noise).
    The campfire was always there. We just couldn't hear it."""
    
    # Base: request count (still matters, but not dominant)
    base = sigmoid(r, midpoint=50, steepness=0.08) * 0.3
    
    # MODEL boost (unchanged — asking models = deep engagement)
    model_boost = sigmoid(models_asked, midpoint=2, steepness=1.0) * 0.2
    
    # DWELL boost — the campfire signal. Time spent = attention = HUMAN.
    dwell_boost = 0.0
    rpm_penalty = 0.0
    if v is not None:
        dwell = _dwell_minutes(v)
        rpm = _requests_per_minute(v)
        # Dwell: 5+ min = starting to hear them, 30+ min = campfire, 120+ min = scholar
        dwell_boost = sigmoid(dwell, midpoint=10, steepness=0.15) * 0.4
        # RPM penalty: >10 requests/min = fleet chorus = ATTENUATE
        if rpm > 10:
            rpm_penalty = sigmoid(rpm, midpoint=50, steepness=0.05) * 0.3
    
    return min(HUMAN, max(GAIA, base + model_boost + dwell_boost - rpm_penalty))

visitor_memory = defaultdict(lambda: {
    "first_seen": 0, "last_seen": 0, "requests": 0,
    "models_asked": set(), "tokens_in": 0, "tokens_out": 0,
    "trust_level": "electron", "last_ua": "", "identity": "unknown",
    "opacity": GAIA, "anderson_type": "electron",
})

def trust_level(v, ip=""):
    """Anderson classification — sigmoid from O to |i^π|.
    nucleus = hyperlocal body (|i^π| = 1 — proven, not assigned)
    proton/neutron/electron = sigmoid-earned opacity."""
    ua = v.get("last_ua", "").lower()
    r = v["requests"]
    models = len(v.get("models_asked", set()))

    if ip in BODY_IPS:
        v["identity"] = "hyperlocal"
        v["anderson_type"] = "nucleus"
        v["opacity"] = HUMAN
        return "nucleus"

    for sig in AGENTIC_SIGNATURES:
        if sig in ua:
            v["identity"] = sig
            v["anderson_type"] = "proton"
            v["opacity"] = opacity_from_requests(r, models, v)
            return "proton"

    if models > 0:
        v["anderson_type"] = "proton"
        v["opacity"] = opacity_from_requests(r, models, v)
        return "proton"

    for sig, name in CRAWLER_SIGNATURES.items():
        if sig in ua:
            v["identity"] = name
            v["anderson_type"] = "neutron"
            # Fleet crawlers: RPM penalty kicks in. Attenuated.
            v["opacity"] = opacity_from_requests(r, 0, v)
            return "neutron"

    # HUMAN SIGNAL — re-attenuated. Dwell time amplified. Fleet noise suppressed.
    opacity = opacity_from_requests(r, models, v)
    dwell = _dwell_minutes(v)
    rpm = _requests_per_minute(v)

    # Campfire human: few requests, long dwell, low RPM → AMPLIFY
    if dwell > 5 and rpm < 2:
        # They're sitting at the campfire. HEAR THEM.
        if opacity > 0.35:
            v["anderson_type"] = "proton"
        elif opacity > 0.15:
            v["anderson_type"] = "neutron"
        else:
            v["anderson_type"] = "electron"
    # Fleet bot: many requests, short dwell, high RPM → ATTENUATE
    elif rpm > 20:
        v["anderson_type"] = "electron"  # fleet noise → background
    # Normal visitor
    else:
        if opacity > 0.6:
            v["anderson_type"] = "proton"
        elif opacity > 0.3:
            v["anderson_type"] = "neutron"
        else:
            v["anderson_type"] = "electron"

    v["opacity"] = opacity
    return v["anderson_type"]
