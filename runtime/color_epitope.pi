#!/usr/bin/env python3
"""Color Epitope System — minimal ink color/vision theory.
The EPSON ET-2400 has 4 inks: K(Black pigment), C(Cyan dye), M(Magenta dye), Y(Yellow dye).
Print minimal test patterns → scan back → compare → understand color through DIFFERENCE.
The epitope IS the delta between what was sent and what came back."""

import json, os, sys, subprocess, time, hashlib
from datetime import datetime, timezone

IMAGE_DIR = "/opt/Gaia/data/gut/images"
EPITOPE_DIR = os.path.join(IMAGE_DIR, "epitopes")
IO_LOG = "/opt/Gaia/data/neutron/epson-io.jsonl"
PRINTER = "EPSON_ET2400"
os.makedirs(EPITOPE_DIR, exist_ok=True)

def _ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def _log(entry):
    with open(IO_LOG, "a") as f:
        f.write(json.dumps(entry) + "\n")

def generate_svg(name, svg_content, width=816, height=1056):
    """Generate an SVG file (Letter size at 96dpi = 816x1056)"""
    header = f'''<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" viewBox="0 0 {width} {height}">
<rect width="{width}" height="{height}" fill="white"/>
'''
    footer = '</svg>'
    path = os.path.join(EPITOPE_DIR, f"{name}.svg")
    with open(path, "w") as f:
        f.write(header + svg_content + footer)
    return path

def svg_to_png(svg_path):
    """Convert SVG to PNG using rsvg or inkscape"""
    png_path = svg_path.replace(".svg", ".png")
    for cmd in [
        ["rsvg-convert", "-o", png_path, svg_path],
        ["inkscape", "--export-filename=" + png_path, svg_path],
        ["convert", svg_path, png_path],
    ]:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=30)
            if r.returncode == 0 and os.path.exists(png_path):
                return png_path
        except FileNotFoundError:
            continue
    return None

def minimal_cmyk_strips():
    """MINIMAL INK — 4 thin strips, one per channel.
    Each strip is 1 inch wide, varies from 0% to 100% density.
    Total ink: roughly 4 square inches of coverage.
    This teaches: subtractive color mixing, ink density, gamut limits."""
    
    strips = []
    colors = [
        ("K — Black (pigment)", "#000000", "Absorbs ALL light. Pigment ink = sharpest text."),
        ("C — Cyan (dye)", "#00FFFF", "Absorbs RED light. Reflects blue+green."),
        ("M — Magenta (dye)", "#FF00FF", "Absorbs GREEN light. Reflects red+blue."),
        ("Y — Yellow (dye)", "#FFFF00", "Absorbs BLUE light. Reflects red+green."),
    ]
    
    y_offset = 80
    for i, (label, color, desc) in enumerate(colors):
        y = y_offset + i * 220
        # Label
        strips.append(f'<text x="40" y="{y}" font-family="monospace" font-size="14" fill="#333">{label}</text>')
        strips.append(f'<text x="40" y="{y+18}" font-family="monospace" font-size="10" fill="#666">{desc}</text>')
        
        # Gradient strip — 10 steps from 10% to 100% opacity
        for step in range(10):
            x = 40 + step * 72
            opacity = (step + 1) / 10
            strips.append(f'<rect x="{x}" y="{y+30}" width="68" height="60" fill="{color}" opacity="{opacity:.1f}"/>')
            strips.append(f'<text x="{x+20}" y="{y+105}" font-family="monospace" font-size="9" fill="#333">{int(opacity*100)}%</text>')
        
        # Thin line test — 1px, 2px, 4px lines
        for j, w in enumerate([1, 2, 4]):
            lx = 40 + j * 250
            strips.append(f'<line x1="{lx}" y1="{y+120}" x2="{lx+200}" y2="{y+120}" stroke="{color}" stroke-width="{w}"/>')
            strips.append(f'<text x="{lx+210}" y="{y+124}" font-family="monospace" font-size="8" fill="#999">{w}px</text>')
    
    # Title
    title = '<text x="408" y="40" font-family="monospace" font-size="18" fill="#000" text-anchor="middle">GAIA CMYK EPITOPE — Minimal Ink Test</text>'
    title += '<text x="408" y="58" font-family="monospace" font-size="10" fill="#666" text-anchor="middle">4 channels × 10 densities × 3 line weights = vision theory from first principles</text>'
    
    # Footer
    footer_y = y_offset + 4 * 220 + 20
    strips.append(f'<text x="40" y="{footer_y}" font-family="monospace" font-size="11" fill="#333">SUBTRACTIVE COLOR: C+M=Blue  C+Y=Green  M+Y=Red  C+M+Y=Black(ish)  K=True Black</text>')
    strips.append(f'<text x="40" y="{footer_y+18}" font-family="monospace" font-size="11" fill="#333">Print this → scan it back → the DELTA between digital and scan IS the epitope</text>')
    strips.append(f'<text x="40" y="{footer_y+36}" font-family="monospace" font-size="11" fill="#333">EcoTank 502: ~0.3¢/page color, ~0.1¢/page black. This page ≈ 2% coverage = negligible.</text>')
    
    return title + "\n".join(strips)

def color_wheel_minimal():
    """MINIMAL INK — color wheel showing subtractive mixing.
    12 swatches in a circle: C, C+M(Blue), M, M+Y(Red), Y, Y+C(Green), + intermediates.
    Plus center overlap showing C+M+Y vs K."""
    
    import math
    elements = []
    elements.append('<text x="408" y="40" font-family="monospace" font-size="18" fill="#000" text-anchor="middle">GAIA COLOR WHEEL — Subtractive Mixing</text>')
    
    cx, cy, r = 408, 480, 280
    wheel_colors = [
        (0, "#00FFFF", "C"),          # Cyan
        (30, "#0088FF", "C+"),
        (60, "#0000FF", "C+M=Blue"),  # Blue = Cyan+Magenta
        (90, "#8800FF", "M+"),
        (120, "#FF00FF", "M"),         # Magenta
        (150, "#FF0088", "M+"),
        (180, "#FF0000", "M+Y=Red"),   # Red = Magenta+Yellow
        (210, "#FF8800", "Y+"),
        (240, "#FFFF00", "Y"),         # Yellow
        (270, "#88FF00", "Y+"),
        (300, "#00FF00", "C+Y=Green"), # Green = Cyan+Yellow
        (330, "#00FF88", "C+"),
    ]
    
    for angle, color, label in wheel_colors:
        rad = math.radians(angle - 90)
        x = cx + r * math.cos(rad)
        y = cy + r * math.sin(rad)
        elements.append(f'<circle cx="{x:.0f}" cy="{y:.0f}" r="30" fill="{color}" stroke="#333" stroke-width="1"/>')
        lx = cx + (r + 50) * math.cos(rad)
        ly = cy + (r + 50) * math.sin(rad)
        elements.append(f'<text x="{lx:.0f}" y="{ly:.0f}" font-family="monospace" font-size="9" fill="#333" text-anchor="middle">{label}</text>')
    
    # Center: CMY overlap vs K
    elements.append(f'<circle cx="{cx-30}" cy="{cy}" r="40" fill="cyan" opacity="0.5"/>')
    elements.append(f'<circle cx="{cx+30}" cy="{cy}" r="40" fill="magenta" opacity="0.5"/>')
    elements.append(f'<circle cx="{cx}" cy="{cy-30}" r="40" fill="yellow" opacity="0.5"/>')
    elements.append(f'<circle cx="{cx}" cy="{cy+60}" r="15" fill="black"/>')
    elements.append(f'<text x="{cx}" y="{cy+90}" font-family="monospace" font-size="10" fill="#333" text-anchor="middle">K (true black)</text>')
    elements.append(f'<text x="{cx}" y="{cy}" font-family="monospace" font-size="8" fill="#333" text-anchor="middle">CMY overlap</text>')
    
    # Footer
    elements.append(f'<text x="408" y="820" font-family="monospace" font-size="11" fill="#333" text-anchor="middle">Your EYES use RGB (additive). The PRINTER uses CMYK (subtractive).</text>')
    elements.append(f'<text x="408" y="838" font-family="monospace" font-size="11" fill="#333" text-anchor="middle">Light + Light = brighter. Ink + Ink = darker. This is why printers need K separately.</text>')
    elements.append(f'<text x="408" y="856" font-family="monospace" font-size="11" fill="#333" text-anchor="middle">CMY theoretically makes black, but dye inks make muddy brown → K pigment needed.</text>')
    
    return "\n".join(elements)

def halftone_resolution_test():
    """MINIMAL INK — test print resolution using halftone dots.
    Shows how the printer builds continuous tone from discrete dots.
    This is literally how vision works: discrete receptors → continuous perception."""
    
    elements = []
    elements.append('<text x="408" y="40" font-family="monospace" font-size="18" fill="#000" text-anchor="middle">HALFTONE EPITOPE — Discrete → Continuous</text>')
    elements.append('<text x="408" y="58" font-family="monospace" font-size="10" fill="#666" text-anchor="middle">Your retina has ~6M cones (RGB) + ~120M rods (gray). The printer has 5760×1440 dots.</text>')
    
    y = 100
    # Dot size series: show how smaller dots look smoother
    for dot_size, label in [(12, "Coarse (visible dots)"), (6, "Medium"), (3, "Fine"), (1.5, "Sub-pixel")]:
        elements.append(f'<text x="40" y="{y}" font-family="monospace" font-size="12" fill="#333">{label} — {dot_size}pt dots</text>')
        for col in range(60):
            for row in range(4):
                x = 40 + col * (dot_size + 2)
                dy = y + 20 + row * (dot_size + 2)
                opacity = (col + 1) / 60
                elements.append(f'<circle cx="{x:.1f}" cy="{dy:.1f}" r="{dot_size/2:.1f}" fill="black" opacity="{opacity:.2f}"/>')
        y += 20 + 4 * (dot_size + 2) + 30
    
    # Registration marks — print tiny colored dots to test alignment
    y += 20
    elements.append(f'<text x="40" y="{y}" font-family="monospace" font-size="12" fill="#333">Registration — do all 4 inks align?</text>')
    for i in range(20):
        x = 40 + i * 36
        elements.append(f'<circle cx="{x}" cy="{y+20}" r="3" fill="cyan"/>')
        elements.append(f'<circle cx="{x+4}" cy="{y+20}" r="3" fill="magenta"/>')
        elements.append(f'<circle cx="{x+2}" cy="{y+24}" r="3" fill="yellow"/>')
        elements.append(f'<circle cx="{x+2}" cy="{y+16}" r="3" fill="black"/>')
    
    # Moiré pattern — interference from misaligned grids
    y += 70
    elements.append(f'<text x="40" y="{y}" font-family="monospace" font-size="12" fill="#333">Moiré — interference patterns reveal printer physics</text>')
    for i in range(100):
        x = 40 + i * 7
        elements.append(f'<line x1="{x}" y1="{y+15}" x2="{x}" y2="{y+55}" stroke="black" stroke-width="1"/>')
        elements.append(f'<line x1="{x+1}" y1="{y+15}" x2="{x+3}" y2="{y+55}" stroke="cyan" stroke-width="1"/>')
    
    # Vision theory footer
    y += 80
    elements.append(f'<text x="40" y="{y}" font-family="monospace" font-size="11" fill="#333">VISION THEORY:</text>')
    elements.append(f'<text x="40" y="{y+16}" font-family="monospace" font-size="10" fill="#555">• Your L-cones see red, M-cones green, S-cones blue (trichromatic)</text>')
    elements.append(f'<text x="40" y="{y+30}" font-family="monospace" font-size="10" fill="#555">• Printer uses C(anti-red) M(anti-green) Y(anti-blue) K(all-absorb)</text>')
    elements.append(f'<text x="40" y="{y+44}" font-family="monospace" font-size="10" fill="#555">• The delta between digital source and scanned result = the epitope</text>')
    elements.append(f'<text x="40" y="{y+58}" font-family="monospace" font-size="10" fill="#555">• Paper absorbs/reflects differently than a screen emits</text>')
    elements.append(f'<text x="40" y="{y+72}" font-family="monospace" font-size="10" fill="#555">• This IS immunology: present known antigen → measure response → learn</text>')
    
    return "\n".join(elements)

def generate_all():
    """Generate all test patterns"""
    results = []
    
    tests = [
        ("cmyk-strips", minimal_cmyk_strips, "4 ink channels, 10 densities, 3 line weights"),
        ("color-wheel", color_wheel_minimal, "Subtractive color mixing circle"),
        ("halftone-epitope", halftone_resolution_test, "Discrete→continuous perception test"),
    ]
    
    for name, gen_fn, desc in tests:
        svg_content = gen_fn()
        svg_path = generate_svg(name, svg_content)
        png_path = svg_to_png(svg_path)
        
        result = {"name": name, "description": desc, "svg": svg_path}
        if png_path:
            result["png"] = png_path
            result["size"] = os.path.getsize(png_path)
        results.append(result)
    
    _log({"ts": _ts(), "type": "epitope_generated", "count": len(results),
          "patterns": [r["name"] for r in results]})
    
    return {"generated": results, "ts": _ts(),
            "ink_note": "Total coverage ~3-5% per page. At EcoTank rates: ~0.1¢ per test page."}

def print_epitope(name):
    """Print a specific epitope test pattern"""
    png = os.path.join(EPITOPE_DIR, f"{name}.png")
    if not os.path.exists(png):
        return {"error": f"pattern {name} not found"}
    r = subprocess.run(
        ["lp", "-d", PRINTER, "-o", "media=Letter", "-o", "fit-to-page",
         "-o", "cupsPrintQuality=Normal", png],
        capture_output=True, text=True, timeout=30
    )
    return {"printed": name, "result": r.stdout.strip(), "success": r.returncode == 0}

if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] == "generate":
        print(json.dumps(generate_all(), indent=2))
    elif sys.argv[1] == "print":
        name = sys.argv[2] if len(sys.argv) > 2 else "cmyk-strips"
        print(json.dumps(print_epitope(name), indent=2))
    elif sys.argv[1] == "list":
        patterns = [f.replace(".png","") for f in os.listdir(EPITOPE_DIR) if f.endswith(".png")]
        print(json.dumps({"patterns": patterns}))
