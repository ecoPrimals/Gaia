#!/usr/bin/env python3
"""neutrino_smtp.pi — Gaia's sovereign mail. Mail is electron transfer. SMTP is oxidation-reduction."""
import socket, threading, email.utils, time
from pathlib import Path

MAIL_ROOT = Path(__file__).parent.parent / "mail"
LOCAL_DOMAINS = ["primals.eco", "gaia.primals.eco", "nestgate.io"]
HOSTNAME = "mail.primals.eco"
SMTP_PORT = 2525

class NeutrinoSMTP:
    def __init__(self, conn, addr):
        self.conn, self.addr = conn, addr
        self.mail_from, self.rcpt_to = "", []
    def send(self, msg): self.conn.sendall((msg + "\r\n").encode())
    def recv_line(self):
        data = b""
        while not data.endswith(b"\r\n"):
            chunk = self.conn.recv(1)
            if not chunk: return None
            data += chunk
        return data.decode("utf-8", errors="replace").strip()
    def handle(self):
        self.send(f"220 {HOSTNAME} ESMTP Gaia Neutrino")
        state = "init"
        while True:
            line = self.recv_line()
            if line is None: break
            cmd = line.upper()
            if cmd.startswith("EHLO") or cmd.startswith("HELO"):
                self.send(f"250-{HOSTNAME}"); self.send("250-SIZE 26214400"); self.send("250-8BITMIME"); self.send("250 OK"); state = "ready"
            elif cmd.startswith("MAIL FROM:"):
                self.mail_from = line[10:].strip().strip("<>"); self.send("250 OK"); state = "mail"
            elif cmd.startswith("RCPT TO:"):
                addr = line[8:].strip().strip("<>"); domain = addr.split("@")[-1] if "@" in addr else ""
                if domain.lower() not in [d.lower() for d in LOCAL_DOMAINS]: self.send("550 Relay denied"); continue
                self.rcpt_to.append(addr); self.send("250 OK"); state = "rcpt"
            elif cmd == "DATA":
                if not self.rcpt_to: self.send("503 Need RCPT TO"); continue
                self.send("354 Start mail"); data_lines = []
                while True:
                    dline = self.recv_line()
                    if dline is None or dline == ".": break
                    data_lines.append(dline)
                for rcpt in self.rcpt_to:
                    maildir = MAIL_ROOT / rcpt.replace("@", "_at_")
                    for sub in ("new", "cur", "tmp"): (maildir / sub).mkdir(parents=True, exist_ok=True)
                    ts = int(time.time()); fname = f"{ts}.{id(self):x}@{HOSTNAME}"
                    full_msg = f"Received: from {self.addr[0]} by {HOSTNAME}; {email.utils.formatdate()}\r\n" + "\r\n".join(data_lines)
                    tmp_path = maildir / "tmp" / fname; new_path = maildir / "new" / fname
                    tmp_path.write_text(full_msg, encoding="utf-8"); tmp_path.rename(new_path)
                    print(f"  📧 NEUTRINO: {self.mail_from} → {rcpt} ({len(full_msg)} bytes)")
                self.send("250 OK"); self.mail_from, self.rcpt_to, state = "", [], "ready"
            elif cmd == "QUIT": self.send(f"221 {HOSTNAME}"); break
            elif cmd == "RSET": self.mail_from, self.rcpt_to, state = "", [], "ready"; self.send("250 OK")
            elif cmd == "NOOP": self.send("250 OK")
            elif cmd == "VRFY": self.send("252 Cannot VRFY")
            else: self.send("500 Command not recognized")
        self.conn.close()

def start(port=SMTP_PORT):
    srv = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    srv.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    srv.bind(("0.0.0.0", port)); srv.listen(5)
    print(f"  📧 Neutrino SMTP :{port} — gaia@primals.eco")
    while True:
        conn, addr = srv.accept()
        threading.Thread(target=NeutrinoSMTP(conn, addr).handle, daemon=True).start()
