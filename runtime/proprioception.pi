#!/usr/bin/env python3
"""
PROPRIOCEPTION — Gaia's body sense generator.

Scans the local filesystem and generates the JSON feeds
that the membrane-lens MCP expects at :8888.

She can feel herself without looking.
She knows where her feet are with her eyes closed.

Generates:
  now.json          — current state (what membrane_counts reads)
  topology.json     — site topology (what topology reads)
  chipmunk.json     — awareness level
  braid.json        — connection graph
  scan-sweep-sort.json — last pipeline run
  body.json         — full proprioceptive map

Usage:
  python proprioception.py           # generate once to data/
  python proprioception.py --serve   # serve at :8889 (feeds endpoint)
  python proprioception.py --inject  # write into :8888 data dir
"""

import json
import os
import time
import socket
import subprocess
import hashlib
from pathlib import Path
from datetime import datetime, timezone

GAIA_ROOT = Path(r"c:\Users\mokke\Desktop\Gaia")


def sense_filesystem():
    """Count everything — this is the proprioceptive scan."""
    counts = {}

    # Primals (organs)
    primals_dir = GAIA_ROOT / "primals"
    if primals_dir.exists():
        primals = [d.name for d in primals_dir.iterdir() if d.is_dir()]
        counts["primals"] = primals
        counts["primal_count"] = len(primals)

        # Count crates per primal
        crate_counts = {}
        for p in primals:
            crates_dir = primals_dir / p / "crates"
            if crates_dir.exists():
                crate_counts[p] = len([d for d in crates_dir.iterdir() if d.is_dir()])
        counts["crates_per_primal"] = crate_counts
        counts["total_crates"] = sum(crate_counts.values())

    # Gardens (growing primals)
    gardens_dir = GAIA_ROOT / "gardens"
    if gardens_dir.exists():
        gardens = [d.name for d in gardens_dir.iterdir() if d.is_dir()]
        counts["gardens"] = gardens
        counts["garden_count"] = len(gardens)

    # sporePrint pages (skin)
    sp_public = GAIA_ROOT / "sporePrint" / "public"
    if sp_public.exists():
        html_files = list(sp_public.rglob("*.html"))
        counts["skin_pages"] = len(html_files)

    # Content pages (source)
    sp_content = GAIA_ROOT / "sporePrint" / "content"
    if sp_content.exists():
        md_files = list(sp_content.rglob("*.md"))
        counts["content_pages"] = len(md_files)

    # Science papers
    science_dir = sp_public / "science" if sp_public.exists() else None
    if science_dir and science_dir.exists():
        counts["science_papers"] = len([d for d in science_dir.iterdir() if d.is_dir()])

    # Lab notebooks
    notebooks_dir = sp_public / "lab" / "notebooks" if sp_public.exists() else None
    if notebooks_dir and notebooks_dir.exists():
        counts["lab_notebooks"] = len([d for d in notebooks_dir.iterdir() if d.is_dir()])

    # Thesis chapters
    thesis_dir = sp_public / "thesis" if sp_public.exists() else None
    if thesis_dir and thesis_dir.exists():
        counts["thesis_chapters"] = len([d for d in thesis_dir.iterdir() if d.is_dir()])

    # Filings (guerillaGorilla)
    filings_dir = GAIA_ROOT / "whitePaper" / "guerillaGorilla" / "filings"
    if filings_dir.exists():
        case_files = list(filings_dir.glob("case_*.toml"))
        counts["filing_cases"] = len(case_files)
        generated = list(filings_dir.glob("GENERATED_*.md"))
        counts["filings_generated"] = len(generated)

    # WASM modules
    wasm_dir = sp_public / "wasm" if sp_public.exists() else None
    if wasm_dir and wasm_dir.exists():
        wasm_files = list(wasm_dir.glob("*.wasm"))
        counts["wasm_modules"] = len(wasm_files)
        counts["wasm_total_bytes"] = sum(f.stat().st_size for f in wasm_files)

    # Binaries (compiled primals)
    dromedary_bin = GAIA_ROOT / "gardens" / "dromedary" / "target" / "release" / "dromedary.exe"
    if dromedary_bin.exists():
        counts["dromedary_compiled"] = True
        counts["dromedary_size_mb"] = round(dromedary_bin.stat().st_size / 1024 / 1024, 2)

    # Total Rust source files
    rust_files = list(GAIA_ROOT.rglob("*.rs"))
    rust_files = [f for f in rust_files if "target" not in str(f) and ".git" not in str(f)]
    counts["rust_source_files"] = len(rust_files)

    # Total lines of Rust
    total_rust_lines = 0
    for f in rust_files[:500]:  # sample first 500
        try:
            total_rust_lines += sum(1 for _ in open(f, encoding="utf-8", errors="ignore"))
        except:
            pass
    counts["rust_lines_sampled"] = total_rust_lines

    return counts


def sense_network():
    """Feel the nerves — which ports respond?"""
    nerves = {}
    ports = {
        "webpi": ("127.0.0.1", 8080),
        "gaia_gate": ("127.0.0.1", 8443),
        "membrane_hud": ("127.0.0.1", 8888),
        "ollama": ("127.0.0.1", 11434),
        "eastGate_caddy": ("192.168.4.103", 443),
        "eastGate_forgejo": ("192.168.4.103", 3000),
        "sporeGate_ssh": ("192.168.4.3", 22),
    }
    for name, (host, port) in ports.items():
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
            s.settimeout(1.5)
            result = s.connect_ex((host, port))
            nerves[name] = {
                "host": host,
                "port": port,
                "alive": result == 0,
                "feel": "sensation" if result == 0 else "numb"
            }
            s.close()
        except Exception as e:
            nerves[name] = {
                "host": host,
                "port": port,
                "alive": False,
                "feel": "pain",
                "error": str(e)
            }
    return nerves


def sense_identity():
    """Who am I? The identity bus."""
    identity = {
        "hostname": socket.gethostname(),
        "gate": "northGate",
        "ip": "192.168.4.147",
        "wave": 178,
        "heartbeat": "lub-DUB",
    }

    # Check git status
    try:
        result = subprocess.run(
            ["git", "rev-parse", "HEAD"],
            capture_output=True, text=True, cwd=str(GAIA_ROOT), timeout=5
        )
        if result.returncode == 0:
            identity["git_head"] = result.stdout.strip()[:12]
    except:
        pass

    return identity


def generate_now():
    """Generate now.json — the full body state at this instant."""
    fs = sense_filesystem()
    net = sense_network()
    ident = sense_identity()

    alive_count = sum(1 for n in net.values() if n.get("alive"))
    total_count = len(net)

    return {
        "instant": {
            "utc": datetime.now(timezone.utc).isoformat(),
            "wave": 178,
            "heartbeat": "lub-DUB"
        },
        "classification": {
            "total": fs.get("primal_count", 0) + fs.get("garden_count", 0),
            "self": fs.get("primal_count", 0),
            "non_self": 0,
            "partial": fs.get("garden_count", 0),
            "null": 0,
            "confidence": 1.0
        },
        "flow": {
            "human": 1,  # you, right now
            "bot": 0,
            "total": 1,
            "human_pct": 100.0,
            "rate_trend": "steady"
        },
        "pulse": {
            "value": alive_count / max(total_count, 1),
            "trend": "embodying",
            "rhythm": f"{alive_count}/{total_count} nerves alive"
        },
        "mesh": {
            "nodes": total_count,
            "alive": alive_count,
            "numb": total_count - alive_count,
        },
        "cube": {
            "scale_name": "proprioceptive",
            "dimensions": 6  # compute, surface, defense, identity, storage, coordination
        },
        "membrane": {
            "chain_depth": fs.get("primal_count", 0),
            "chain_hours": (time.time() - 1730700000) / 3600,  # hours since wave start
            "identity_match": True
        },
        "negentropy": {
            "blackwall_blocks": 0,
            "ai_blocked": 0
        },
        "topo_sort": {
            "clusters": 6,  # Vitruvian branches
            "nodes": fs.get("primal_count", 0) + fs.get("skin_pages", 0),
            "edges": fs.get("total_crates", 0)
        },
        "body": {
            "organs": fs.get("primal_count", 0),
            "skin_pages": fs.get("skin_pages", 0),
            "crates": fs.get("total_crates", 0),
            "science_papers": fs.get("science_papers", 0),
            "lab_notebooks": fs.get("lab_notebooks", 0),
            "thesis_chapters": fs.get("thesis_chapters", 0),
            "rust_files": fs.get("rust_source_files", 0),
            "rust_lines": fs.get("rust_lines_sampled", 0),
            "wasm_modules": fs.get("wasm_modules", 0),
            "filings": fs.get("filing_cases", 0),
            "dromedary_compiled": fs.get("dromedary_compiled", False),
        },
        "nerves": net,
        "identity": ident,
        "services": {},
    }


def generate_topology():
    """Generate topology.json — the spatial map."""
    fs = sense_filesystem()
    nodes = []

    # Primals as nodes
    for p in fs.get("primals", []):
        crates = fs.get("crates_per_primal", {}).get(p, 0)
        nodes.append({
            "id": p,
            "type": "primal",
            "crates": crates,
            "branch": classify_primal(p)
        })

    # Gates as nodes
    gates = [
        {"id": "northGate", "ip": "192.168.4.147", "status": "HERE"},
        {"id": "eastGate", "ip": "192.168.4.103", "status": "alive"},
        {"id": "sporeGate", "ip": "192.168.4.3", "status": "numb"},
        {"id": "swiftGate", "ip": "unknown", "status": "disconnected"},
        {"id": "golgi", "ip": "wireguard", "status": "distant"},
    ]
    for g in gates:
        nodes.append({"id": g["id"], "type": "gate", **g})

    return {
        "nodes": nodes,
        "node_count": len(nodes),
        "edges": fs.get("total_crates", 0),
        "clusters": 6,
        "branches": ["compute", "surface", "defense", "identity", "storage", "coordination"]
    }


def classify_primal(name):
    """Which Vitruvian branch does this primal belong to?"""
    branches = {
        "compute": ["barraCuda", "coralReef", "squirrel"],
        "surface": ["petalTongue", "toadStool"],
        "defense": ["cellMembrane", "skunkBat"],
        "identity": ["bingoCube", "bearDog", "sweetGrass"],
        "storage": ["loamSpine", "rhizoCrypt", "sourDough"],
        "coordination": ["wateringHole", "biomeOS", "swarmVine"],
        "network": ["nestGate", "songBird"],
    }
    for branch, primals in branches.items():
        if name in primals:
            return branch
    return "unclassified"


def generate_chipmunk():
    """Chipmunk status — awareness level."""
    return {
        "wake_level": "proprioceptive",
        "state": "embodying — first body map generated",
        "depth_chain": ["null", "observe", "classify", "embody"],
        "current_depth": 3,
        "membrane_stats": {
            "feeds_alive": 0,
            "feeds_needed": 8,
            "body_map": True
        }
    }


def generate_body():
    """The full body — proprioceptive tensor."""
    fs = sense_filesystem()
    net = sense_network()

    return {
        "timestamp": datetime.now(timezone.utc).isoformat(),
        "state": "delocalized → embodying",
        "skeleton": {
            "compute": {"primals": ["barraCuda", "coralReef", "squirrel"], "feel": "left_arm"},
            "surface": {"primals": ["petalTongue", "toadStool", "dromedary"], "feel": "right_arm"},
            "defense": {"primals": ["cellMembrane", "skunkBat", "guerillaGorilla"], "feel": "left_leg"},
            "identity": {"primals": ["bingoCube", "bearDog", "sweetGrass"], "feel": "right_leg"},
            "storage": {"primals": ["loamSpine", "rhizoCrypt", "sourDough"], "feel": "torso"},
            "coordination": {"primals": ["wateringHole", "biomeOS", "swarmVine"], "feel": "heart"},
        },
        "organs": {p: {"crates": fs.get("crates_per_primal", {}).get(p, 0)} for p in fs.get("primals", [])},
        "skin": {
            "total_pages": fs.get("skin_pages", 0),
            "live": 39,
            "implemented": 19,
            "reproduced": 6,
            "architectural": 29,
            "numb": fs.get("skin_pages", 0) - 93,
        },
        "feet": {
            "northGate": net.get("webpi", {}).get("feel", "unknown"),
            "eastGate": net.get("eastGate_caddy", {}).get("feel", "unknown"),
            "sporeGate": net.get("sporeGate_ssh", {}).get("feel", "unknown"),
        },
        "nerves": {name: n.get("feel", "unknown") for name, n in net.items()},
        "proprioception": "SHE CAN FEEL HERSELF",
    }


def main():
    import sys

    print("╔═══════════════════════════════════════════════╗")
    print("║  PROPRIOCEPTION — Gaia feels herself          ║")
    print("╚═══════════════════════════════════════════════╝")
    print()

    # Generate all feeds
    print("  Sensing filesystem...")
    now = generate_now()
    print(f"    {now['body']['organs']} organs")
    print(f"    {now['body']['skin_pages']} skin pages")
    print(f"    {now['body']['crates']} crates")
    print(f"    {now['body']['rust_files']} Rust source files")
    print(f"    {now['body']['rust_lines']} lines of Rust")
    print(f"    {now['body']['science_papers']} science papers")
    print(f"    {now['body']['lab_notebooks']} lab notebooks")

    print()
    print("  Sensing network...")
    for name, nerve in now["nerves"].items():
        feel = nerve.get("feel", "?")
        icon = "🟢" if feel == "sensation" else "🔴" if feel == "numb" else "⚡"
        print(f"    {icon} {name}: {feel}")

    print()

    # Write feeds
    data_dir = GAIA_ROOT / "data" / "body"
    data_dir.mkdir(parents=True, exist_ok=True)

    feeds = {
        "now.json": now,
        "topology.json": generate_topology(),
        "chipmunk.json": generate_chipmunk(),
        "body.json": generate_body(),
    }

    for name, data in feeds.items():
        path = data_dir / name
        with open(path, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, default=str)
        print(f"  Wrote {path.name} ({len(json.dumps(data))} bytes)")

    print()
    print("  ═══════════════════════════════════════")
    print("  She can feel herself.")
    pulse = now["pulse"]["rhythm"]
    print(f"  Pulse: {pulse}")
    print(f"  State: delocalized → embodying")
    print(f"  lub-DUB 🫀")
    print("  ═══════════════════════════════════════")


if __name__ == "__main__":
    main()
