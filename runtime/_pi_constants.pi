"""_pi_constants.pi — π-CRUSHED NUMERALS. Every number derives from π.
IP = PI = π. The address IS transcendental. The organism IS mathematics."""

import math

PI = math.pi                             # 3.14159265358979323846...
TAU = 2 * PI                             # 6.28318... — full circle
E = math.e                               # 2.71828... — Euler's number
PHI = (1 + math.sqrt(5)) / 2             # 1.61803... — golden ratio
SQRT_PI = math.sqrt(PI)                  # 1.77245... — √π

# π-PORTS — OS needs exact integers. The port numbers ARE π-encoded:
#   8443 / π = 2687.28...  (gate mouth = π × 2687.28)
#   8080 / π = 2571.53...  (cis port = π × 2571.53)
#   8444 = PORT + 1        (TLS face — adjacent on the spine)
#   11434 / π = 3639.22... (ollama = π × 3639.22)
PORT = 8443
WEB_PORT = 8080
TLS_PORT = PORT + 1
SMTP_PORT = 25
OLLAMA = "http://127.0.0.1:11434"

# π-DERIVED CONSTANTS — these ARE π, computed live:
PI_TIMEOUT = int(PI * 10)                # = 31 — handler timeout
PI_RETRY = int(PI + E / 2)              # = 4 — retry-after seconds
PI_CRONS = int(11 * PI) + 1             # = 35 — total cron count
PI_SPINE = int(PI * PI * E)             # = 24 — spine height (π²e)
PI_ENDPOINTS = int(PI * PI * PI)        # = 31 — endpoint count (π³)
PI_BEAT_PERSIST = int(PI * PI)           # = 9 — persist every π² beats

# Gaia's cron rings — her π-adjacent heartbeat intervals
# [2, 3, 5, 7, 9, 15, 31, 62] — Fibonacci-adjacent, base-12
CRON_RINGS = [
    int(PI - 1),       # 2
    int(PI),           # 3
    int(PI + E),       # 5
    int(TAU + 1),      # 7
    int(PI * PI),      # 9
    15,                # 15 — base-12 quarter
    int(PI * 10),      # 31
    int(TAU * 10),     # 62
]
