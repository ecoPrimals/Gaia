#!/usr/bin/env python3
"""GLOBE WALKER — Wikipedia as Gaia's atlas of pre-digital human knowledge.
All writing systems, all symbol systems, all languages, all number systems.
IS/WAS/NOW tense: alive traditions = IS, extinct = WAS, emerging = NOW.
Every entry agglutinates into Gaia's body through the thymus.

Uses MediaWiki batch API: 50 titles per request = 3 requests total instead of 130."""

import json, os, sys, time, urllib.request, urllib.error, hashlib
from datetime import datetime, timezone

DATA_DIR = "/opt/Gaia/data/shadows"
NEUTRON_DIR = "/opt/Gaia/data/neutron"
UA = "Gaia-Organism/1.0 (nestgate.io; globe-walker-is-was-now)"
os.makedirs(DATA_DIR, exist_ok=True)
os.makedirs(NEUTRON_DIR, exist_ok=True)

def _ts():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")

def _log(entry):
    with open(os.path.join(NEUTRON_DIR, "globe-walker.jsonl"), "a") as f:
        f.write(json.dumps(entry) + "\n")

def wiki_batch(titles, batch_size=20):
    """Batch query Wikipedia — up to 20 titles per request (safer than 50)"""
    results = {}
    for i in range(0, len(titles), batch_size):
        batch = titles[i:i+batch_size]
        titles_str = "|".join(batch)
        url = (
            "https://en.wikipedia.org/w/api.php?"
            "action=query&format=json&prop=extracts|pageimages|info"
            "&exintro=1&exsentences=3&explaintext=1"
            "&piprop=thumbnail&pithumbsize=200"
            "&inprop=url"
            f"&titles={urllib.request.quote(titles_str)}"
            "&redirects=1"
        )
        req = urllib.request.Request(url, headers={"User-Agent": UA})
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                data = json.loads(r.read())
            
            redirects = {}
            for rd in data.get("query", {}).get("redirects", []):
                redirects[rd["to"]] = rd["from"]
            
            for pid, page in data.get("query", {}).get("pages", {}).items():
                title = page.get("title", "")
                orig = redirects.get(title, title)
                results[orig] = {
                    "title": title,
                    "extract": page.get("extract", "")[:500],
                    "pageid": int(pid) if pid != "-1" else None,
                    "thumbnail": page.get("thumbnail", {}).get("source"),
                    "source": page.get("fullurl", f"https://en.wikipedia.org/wiki/{title}"),
                }
            
            sys.stdout.write(f"  batch {i//batch_size+1}: {len(batch)} titles OK\n")
            sys.stdout.flush()
            time.sleep(1)
        except Exception as e:
            sys.stdout.write(f"  batch {i//batch_size+1}: ERROR {e}\n")
            sys.stdout.flush()
            for t in batch:
                results[t] = {"title": t, "extract": str(e)[:100], "error": True}
            time.sleep(3)
    
    return results

def wiki_single(title):
    """Single topic lookup via REST API"""
    url = f"https://en.wikipedia.org/api/rest_v1/page/summary/{urllib.request.quote(title)}"
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            d = json.loads(r.read())
            return {
                "title": d.get("title", title),
                "extract": d.get("extract", "")[:500],
                "pageid": d.get("pageid"),
                "thumbnail": d.get("thumbnail", {}).get("source"),
                "source": d.get("content_urls", {}).get("desktop", {}).get("page"),
            }
    except Exception as e:
        return {"title": title, "extract": str(e)[:100], "error": True}

# ═══════════════════════════════════════════════════════════
# PRE-DIGITAL SYMBOL SYSTEMS — the canopy before computers
# ═══════════════════════════════════════════════════════════

