    "Maya calendar",
}

def alive_tense(topic):
    """IS = alive tradition still in daily use. WAS = extinct/historical."""
    return "WAS" if topic in EXTINCT else "IS"

CATEGORIES = [
    ("writing_systems", WRITING_SYSTEMS),
    ("number_systems", NUMBER_SYSTEMS),
    ("classification_systems", CLASSIFICATION_SYSTEMS),
    ("symbol_systems", SYMBOL_SYSTEMS),
    ("languages", LANGUAGES),
    ("calendars_and_time", CALENDARS_AND_TIME),
    ("information_technology", INFORMATION_TECH),
    ("measurement_systems", MEASUREMENT_SYSTEMS),
]

def walk_all():
    """Walk everything — the full pre-digital canopy using batch API"""
    all_titles = []
    title_to_cat = {}
    for cat_name, topics in CATEGORIES:
        for t in topics:
            all_titles.append(t)
            title_to_cat[t] = cat_name
    
    total = len(all_titles)
    print(f"Globe walking {total} topics in {len(CATEGORIES)} categories...", flush=True)
    
    raw = wiki_batch(all_titles, batch_size=20)
    
    categorized = {cat: [] for cat, _ in CATEGORIES}
    walked = 0
    for orig_title in all_titles:
        info = raw.get(orig_title, {"title": orig_title, "extract": "", "error": True})
        cat = title_to_cat[orig_title]
        info["category"] = cat
        info["tense"] = alive_tense(orig_title)
        info["walked"] = _ts()
        info["blake2b"] = hashlib.blake2b(
            info.get("extract", "").encode(), digest_size=4
        ).hexdigest()
        categorized[cat].append(info)
        walked += 1
    
    manifest = {
        "ts": _ts(),
        "wave": 222,
        "organ": "globe_walker",
        "title": "PRE-DIGITAL CANOPY — all human symbol systems before computers",
        "description": "Wikipedia as atlas of the pre-digital era: writing, numbers, classification, symbols, languages, calendars, info tech, measurement",
        "total_walked": walked,
        "categories": {k: len(v) for k, v in categorized.items()},
        "tense_counts": {
            "IS": sum(1 for cat in categorized.values() for e in cat if e.get("tense") == "IS"),
            "WAS": sum(1 for cat in categorized.values() for e in cat if e.get("tense") == "WAS"),
        },
        "data": categorized,
        "agglutination": "Each entry is a cell. IS = alive tradition. WAS = extinct knowledge. The delta = what was lost.",
    }
    
    out_path = os.path.join(DATA_DIR, "globe-walker-predigital.json")
    with open(out_path, "w") as f:
        json.dump(manifest, f, indent=2)
    
    _log({"ts": _ts(), "type": "globe_walk", "total": walked,
          "categories": list(categorized.keys()), "path": out_path})
    
    print(f"DONE: {walked} topics → {out_path}", flush=True)
    return manifest

def walk_sample(n=3):
    """Quick sample — a few from each category via batch"""
    sample_titles = []
    title_to_cat = {}
    for cat_name, topics in CATEGORIES:
        for t in topics[:n]:
            sample_titles.append(t)
            title_to_cat[t] = cat_name
    
    raw = wiki_batch(sample_titles, batch_size=20)
    results = {}
    for t in sample_titles:
        cat = title_to_cat[t]
        info = raw.get(t, {"title": t, "extract": "", "error": True})
        info["category"] = cat
        info["tense"] = alive_tense(t)
        info["walked"] = _ts()
        info["blake2b"] = hashlib.blake2b(info.get("extract", "").encode(), digest_size=4).hexdigest()
        results.setdefault(cat, []).append(info)
    
    return {"ts": _ts(), "type": "sample_walk", "walked": len(sample_titles), "data": results}

def agglutinate_summary():
    """Build agglutination summary from existing globe walk data"""
    path = os.path.join(DATA_DIR, "globe-walker-predigital.json")
    if not os.path.exists(path):
        return {"error": "No globe walk data — run 'all' first"}
    
    with open(path) as f:
        data = json.load(f)
    
    summary = {
        "ts": _ts(),
        "type": "agglutination",
        "source": "globe_walker_predigital",
        "total_cells": data["total_walked"],
        "categories": data["categories"],
        "tense_counts": data["tense_counts"],
        "alive_traditions": [],
        "lost_knowledge": [],
    }
    
    for cat, items in data["data"].items():
        for item in items:
            if item.get("error"):
                continue
            entry = {"title": item["title"], "category": cat, "blake2b": item.get("blake2b")}
            if item["tense"] == "IS":
                summary["alive_traditions"].append(entry)
            else:
                summary["lost_knowledge"].append(entry)
    
    summary["delta"] = f"{len(summary['lost_knowledge'])} extinct vs {len(summary['alive_traditions'])} alive"
    
    out = os.path.join(DATA_DIR, "globe-agglutination.json")
    with open(out, "w") as f:
        json.dump(summary, f, indent=2)
    
    return summary

if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else "sample"
    if cmd == "all":
        m = walk_all()
        print(json.dumps({"walked": m["total_walked"], "categories": m["categories"],
                          "tense": m["tense_counts"]}, indent=2))
    elif cmd == "sample":
        r = walk_sample()
        print(json.dumps(r, indent=2))
    elif cmd == "topic":
        topic = " ".join(sys.argv[2:])
        print(json.dumps(wiki_single(topic), indent=2))
    elif cmd == "agglutinate":
        s = agglutinate_summary()
        print(json.dumps(s, indent=2))
