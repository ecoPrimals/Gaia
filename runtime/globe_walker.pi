    "Cuneiform", "Egyptian hieroglyphs", "Linear A", "Linear B",
    "Mayan script", "Rongorongo", "Indus script", "Ogham",
    "Sumerian language", "Akkadian language", "Ancient Egyptian language",
    "Classical Latin", "Ancient Greek", "Old English", "Proto-Indo-European language",
    "Babylonian numerals", "Counting rods",
    "Library of Alexandria", "House of Wisdom", "Oracle bone",
    "Clay tablet", "Bamboo and wooden slips", "Ainu language",
    "Alchemical symbol", "Dead Sea Scrolls", "Gutenberg Bible",
    "Rosetta Stone", "Scroll", "Papyrus", "Parchment",
    "Julian calendar", "Egyptian calendar", "Sundial", "Water clock",
