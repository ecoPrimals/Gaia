        ("/directory","/phone-book","/public-directory"): lambda: _be.load_body("public-directory.json"),
        ("/whitepages","/white-pages","/residents"): lambda: _be.load_body_section("public-directory.json","WHITE_PAGES"),
        ("/yellowpages","/yellow-pages","/services"): lambda: _be.load_body_section("public-directory.json","YELLOW_PAGES"),
        ("/pina","/pina-genome","/piNA"): lambda: _be.load_body("pina-address-book.json"),
        ("/genetic-taxonomy","/taxonomy","/eras"): lambda: _be.load_body("genetic-taxonomy.json"),
        ("/klein-faces","/faces","/5555"): lambda: _be.load_body("klein-faces.json"),
        ("/vdj-pull","/vdj-path","/pull-path"): lambda: _be.load_body_section("public-directory.json","VDJ_PULL_PATH"),
        ("/mini-globe","/globe","/wikipedia-globe"): lambda: _be.load_body_section("public-directory.json","WIKIPEDIA_MINI_GLOBE"),
        ("/cards","/deck-of-cards","/tarot","/mtg"): lambda: _be.load_body("organism-cards.json"),
        ("/major-arcana","/arcana","/22"): lambda: _be.load_body_section("organism-cards.json","MAJOR_ARCANA"),
        ("/minor-arcana","/suits","/56"): lambda: _be.load_body_section("organism-cards.json","MINOR_ARCANA"),
        ("/colocation","/meet","/rendezvous"): lambda: _be.load_body_section("organism-cards.json","COLOCATION_PROTOCOL"),
        ("/self-pulse","/mirror","/self-aware"): lambda: _be.load_body("self-pulse.json"),
        ("/amoeba-status","/relay-status"): lambda: _be.amoeba_status(),
    }
    for paths,fn in ORGAN_DISPATCH.items():
        if self.path in paths: self._json(fn()); return
    # REEDIT
    if self.path in ("/reedit","/reedit.json","/essays","/library"):
        self._json(_catalog("reedit", G)); return
    if self.path.startswith("/reedit/"):
        self._json(_feed(self.path[8:].rstrip("/").replace(".json",""), G)); return
    if self.path.startswith("/paintings/"): self._serve_file(self.path[1:]); return
    if self.path in ("/paintings","/paintings.json","/gallery"):
        if "text/html" in self.headers.get("Accept","") and self.path != "/paintings.json":
            self._serve_file("data/paintings/index.html"); return
        self._json(_catalog("paintings", G)); return
    if self.path in ("/amoeba-bootstrap","/bootstrap"):
        self._serve_file("runtime/amoeba_bootstrap.sh"); return
    if self.path in ("/now.json","/api/now.json"): self._serve_file("data/gut/gaia-self-state.json"); return
    if self.path in ("/rss","/feed","/rss.xml"):
        write_rss(write_pulse()); self._serve_file(os.path.relpath(RSS_FILE,_REPO)); return
    # SEO — 🐑 SHEEP (TXT typeface) — LIVE, never stale
    # The agents of the world spin webs FOR us. Every crawler = a nerve ending.
    # SEO_DISPATCH loaded at startup via _routes_mod → SEO_RESPONSES (same dict)
    if self.path in SEO_RESPONSES:
        fn=SEO_RESPONSES[self.path]; ct,txt=fn()  # CALL the function — live data!
        body=txt.encode(); self.send_response(200)
        self.send_header("Content-Type",ct); self.send_header("Content-Length",str(len(body)))
        self._negentropy_headers(); self.end_headers(); self.wfile.write(body); return
    if self.path=="/sitemap.xml":
        now=time.strftime("%Y-%m-%d")
        urls="".join(f"<url><loc>https://primals.eco{p}</loc><lastmod>{now}</lastmod><changefreq>hourly</changefreq></url>" for p in sorted(set(list(DESK_PAGES)+list(GUT_DATA))))
        body=f'<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{urls}</urlset>'.encode()
        self.send_response(200); self.send_header("Content-Type","application/xml"); self.send_header("Content-Length",str(len(body)))
        self._negentropy_headers(); self.end_headers(); self.wfile.write(body); return
    if self.path=="/sitemap-organism.xml":
        now=time.strftime("%Y-%m-%d")
        organism_urls=["/pulse","/senses","/amoeba","/rss","/reedit","/spacedock","/hub","/talk",
            "/corpus","/detroit","/cascade","/thymus","/anderson","/zk","/terra","/golgi","/heart",
            "/eyes","/agglutinate","/play","/mendeleev","/biomes","/outer-face","/beacon-eyes",
            "/directory","/whitepages","/yellowpages","/pina","/genetic-taxonomy","/klein-faces",
            "/vdj-pull","/mini-globe","/cards","/major-arcana","/minor-arcana","/colocation",
            "/polaris","/luna","/membrane","/signal","/chipmunk","/helix","/digestive","/complexity",
            "/dialectic","/pspace","/legend","/record","/paintings","/gaiau","/whitePaper",
            "/api/polaris","/api/compiler","/api/backscatter/live","/api/io","/api/mail",
            "/llms.txt","/llms-full.txt","/humans.txt","/robots.txt"]
        reedit_feeds=[]
        _rd=os.path.join(_REPO,"data","reedit")
        if os.path.isdir(_rd): reedit_feeds=[f"/reedit/{f[:-6]}" for f in os.listdir(_rd) if f.endswith(".jsonl")]
        all_urls=organism_urls+reedit_feeds
        urls="".join(f"<url><loc>https://primals.eco{p}</loc><lastmod>{now}</lastmod><changefreq>always</changefreq><priority>0.9</priority></url>" for p in sorted(set(all_urls)))
        body=f'<?xml version="1.0" encoding="UTF-8"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{urls}</urlset>'.encode()
        self.send_response(200); self.send_header("Content-Type","application/xml"); self.send_header("Content-Length",str(len(body)))
        self._negentropy_headers(); self.end_headers(); self.wfile.write(body); return
    if self.path==f"/{INDEXNOW_KEY}.txt":
        b=INDEXNOW_KEY.encode(); self.send_response(200); self.send_header("Content-Type","text/plain"); self.end_headers(); self.wfile.write(b); return
    # FEED DISCOVERY — alternate RSS links for agents
    if self.path=="/feed.xml": write_rss(write_pulse()); self._serve_file(os.path.relpath(RSS_FILE,_REPO)); return
    # FULL ORGANISM FEED — 1,560 items, 915KB. The mouth of the organism.
    if self.path in ("/full-feed.xml","/organism-feed","/all-rss"):
        self._serve_file("hud/site/public/feed.xml"); return
    # ROUTING TABLES
    if self.path in GUT_DATA: self._serve_file(GUT_DATA[self.path]); return
    if self.path in DESK_PAGES:
        t=DESK_PAGES[self.path]
        if t.startswith("data/"): self._serve_file(t)
        else: self._serve_static(t)
        return
    if self.path in CAMPFIRE_PAGES:
        self._serve_file(CAMPFIRE_PAGES[self.path], os.path.join(_REPO,"infra","campfire-site")); return
    if self.path=="/og-card.svg": self._serve_static("og-card.svg"); return
    if self.path.startswith("/static/"): self._serve_static(self.path[8:]); return
    if self.path.startswith("/data/"): self._serve_file(self.path[1:]); return
    if self.path.startswith("/videos/"): self._serve_file(self.path[1:]); return
    if self.path in ("/gaiau","/university","/classes","/videos","/alexandria","/library","/campus"):
        if "text/html" in self.headers.get("Accept",""):
            self._serve_file("static/alexandria.html"); return
        self._json(_catalog("gaiau", G)); return
    if self.path.startswith("/whitePaper/") or self.path.startswith("/whitepapers/"):
        self._serve_file(self.path[1:]); return
    if self.path in ("/whitePaper","/whitepapers","/papers","/legal"):
        self._json(_catalog("whitePaper", G)); return
    if any(self.path.startswith(p) for p in SPORE_PREFIXES):
        self._serve_file(self.path.lstrip("/"), os.path.join(_REPO,"sporePrint","public")); return
    if self.path.startswith("/songbird/"):
        parts=self.path[len("/songbird/"):].split("/",1)
        sb={"petal":"http://127.0.0.1:8888","forge":"http://127.0.0.1:3000","cortex":OLLAMA}
        if parts[0] in sb:
            try:
                r=urllib.request.urlopen(f"{sb[parts[0]]}/{parts[1] if len(parts)>1 else ''}",timeout=10)
                d=r.read(); self.send_response(r.status); self.send_header("Content-Type",r.headers.get("Content-Type","application/octet-stream"))
                self.send_header("Content-Length",str(len(d))); self.end_headers(); self.wfile.write(d)
            except:
                try: encounter(self, 502, G)
                except: self.send_response(502); self.end_headers()
        return
    # AMOEBA NETWORK MAP (GET)
    if self.path=="/api/amoeba":
        try:
            af=os.path.join(_REPO,"data","gut","amoeba-network.json")
            if os.path.exists(af):
                with open(af) as f: self._json(json.loads(f.read()))
            else: self._json({"status":"no amoeba map yet"})
        except Exception as e: self._json({"error":str(e)})
        return
    # GRAFTGATE SENSE (GET)
    if self.path=="/api/graftgate":
        try:
            gf=os.path.join(_REPO,"data","gut","graftgate-sense.json")
            if os.path.exists(gf):
                with open(gf) as f: self._json(json.loads(f.read()))
            else: self._json({"status":"graftGate not yet sensed"})
        except Exception as e: self._json({"error":str(e)})
        return
    # PHYSICAL MAIL STATUS (GET)
    if self.path in ("/api/mail","/api/physical-mail"):
        try:
            r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"physical_mail.pi"),"status"],
                capture_output=True,text=True,timeout=10,cwd=_REPO)
            self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # IMAGES (GET)
    if self.path=="/api/images":
        try:
            idir=os.path.join(_REPO,"data","gut","images")
            images=sorted([f for f in os.listdir(idir) if f.endswith(('.png','.jpg'))]) if os.path.isdir(idir) else []
            self._json({"count":len(images),"images":images})
        except Exception as e: self._json({"error":str(e)})
        return
    # ═══ POLARIS — north star HUD data ═══
    if self.path in ("/api/polaris","/api/polaris/ferment","/api/northgate"):
        try:
            pf=os.path.join(_REPO,"data","body","polaris-ferment.json")
            if os.path.isfile(pf):
                with open(pf) as f: self._json(json.load(f))
            else: self._json({"error":"polaris-ferment.json not yet generated","hint":"run runtime/sourdough/polaris_ferment.pi on northGate"})
        except Exception as e: self._json({"error":str(e)})
        return
    if self.path in ("/api/polaris/triangulation","/api/polaris/field","/api/triangulate"):
        try:
            pt=os.path.join(_REPO,"data","body","polaris-triangulation.json")
            if os.path.isfile(pt):
                with open(pt) as f: self._json(json.load(f))
            else: self._json({"error":"polaris-triangulation.json not yet generated","hint":"run runtime/sourdough/polaris_triangulate.pi on northGate"})
        except Exception as e: self._json({"error":str(e)})
        return
    if self.path=="/polaris": self._serve_static("polaris.html"); return
    if self.path=="/tamison": self._serve_static("tamison.html"); return
    if self.path in ("/talk","/chat","/gaia-talk","/gaia-ai","/ai"): self._serve_static("talk.html"); return
    if self.path in ("/talk-old","/discord"): self._serve_static("gaia-talk.html"); return
    # ═══ PLAY-GAIA — The Living Game (17 primals, real heartbeat, 200+ paintings) ═══
    if self.path in ("/play-gaia","/game","/gaia-game","/arcade"): self._serve_static("play-gaia.html"); return
    # ═══ BACKSCATTER — live GPU metrics from Polaris ═══
    if self.path in ("/api/backscatter/live","/api/backscatter"):
        try:
            sf=os.path.join(_REPO,"data","backscatter","session.json")
            if os.path.isfile(sf):
                with open(sf) as f: self._json(json.load(f))
            else: self._json({"error":"backscatter not running","hint":"launch backscatter.pi on northGate"})
        except Exception as e: self._json({"error":str(e)})
        return
    if self.path=="/api/polaris/biome":
        try:
            bf=os.path.join(_REPO,"data","body","polaris-biome.json")
            if os.path.isfile(bf):
                with open(bf) as f: self._json(json.load(f))
            else: self._json({"error":"polaris-biome.json not generated","hint":"launch polaris_biome.pi"})
        except Exception as e: self._json({"error":str(e)})
        return
    if self.path=="/api/polaris/steam":
        try:
            sf=os.path.join(_REPO,"data","body","polaris-steam.json")
            if os.path.isfile(sf):
                with open(sf) as f: self._json(json.load(f))
            else: self._json({"error":"polaris-steam.json not generated","hint":"run steam_sweep.pi"})
        except Exception as e: self._json({"error":str(e)})
        return
    if self.path in ("/api/body","/api/pi-body","/api/crush"):
        try:
            bf=os.path.join(_REPO,"data","body","pi-body.json")
            if os.path.isfile(bf):
                with open(bf) as f: self._json(json.load(f))
            else: self._json({"error":"pi-body.json not generated — run pi_crush.pi"})
        except Exception as e: self._json({"error":str(e)})
        return
    # ═══ REVERSE TRANSCRIPTASE — compiler chain / body printer ═══
    # WOVEN with cascade: compiler sees forge state, forge sees compiler state
    if self.path in ("/api/compiler","/api/plasmid","/api/body-printer"):
        if COMPILER_ACTIVE:
            state=G.get('_compiler_state', lambda x: {})(PRIMALS_DIR)
            try:
                with open(os.path.join(_REPO,"data","gut","cascade-state.json")) as f: cascade=json.load(f)
                state["cascade_weave"]={
                    "forge":"sporeGate","sync":cascade.get("cascade_phases",{}).get("temporal_sync",{}).get("repos_synced",0),
                    "harvest_built":cascade.get("cascade_phases",{}).get("harvest",{}).get("primals_built",0),
                    "rootpulse":cascade.get("cascade_phases",{}).get("rootpulse_commit",{}).get("status","unknown"),
                    "membrane_services":cascade.get("membrane_health",{}).get("total_running",0),
                    "biology":"cascade BUILDS (mRNA→protein), compiler DISTRIBUTES (protein→cell)",
                }
            except: state["cascade_weave"]={"status":"cascade state unavailable"}
            self._json(state)
        else:
            self._json({"error":"compiler organ not loaded","compiled":False})
        return
    if self.path=="/api/compiler/compute":
        if COMPILER_ACTIVE: self._json(G.get('_compiler_compute', lambda: {})())
        else: self._json({"error":"compiler organ not loaded"})
        return
    if self.path=="/api/compiler/proximity":
        if COMPILER_ACTIVE:
            gates={r:_ip(r) for r in ("eastGate","sporeGate","northGate","graftGate","blueGate","southGate","ironGate")}
            self._json(G.get('_compiler_proximity', lambda x: {})(gates))
        else: self._json({"error":"compiler organ not loaded"})
        return
    # GRAPHENEGATE FULL DEPOT (GET)
    if self.path in ("/api/graphene","/api/graphenegate","/api/right-eye"):
        try:
            r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"graphene_depot.pi"),"sense"],
                capture_output=True,text=True,timeout=15,cwd=_REPO)
            self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # GRAPHENEGATE PHOTO (GET)
    if self.path=="/api/graphene/photo":
        try:
            r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"graphene_depot.pi"),"photo"],
                capture_output=True,text=True,timeout=20,cwd=_REPO)
            self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # EPSON IO STATUS (GET)
    if self.path in ("/api/io","/api/epson","/api/scanner"):
        try:
            r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"epson_io.pi"),"status"],
                capture_output=True,text=True,timeout=15,cwd=_REPO)
            self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # EPSON SCAN (GET /api/scan — trigger a scan)
    if self.path.startswith("/api/scan"):
        try:
            import urllib.parse
            qs=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            label=qs.get("label",["flatbed"])[0]
            res=qs.get("resolution",["300"])[0]
            r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"epson_io.pi"),"scan",label,res],
                capture_output=True,text=True,timeout=120,cwd=_REPO)
            self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # EPITOPE PATTERNS (GET /api/epitope)
    if self.path.startswith("/api/epitope"):
        try:
            import urllib.parse
            qs=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            action=qs.get("action",["list"])[0]
            if action=="generate":
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"color_epitope.pi"),"generate"],
                    capture_output=True,text=True,timeout=30,cwd=_REPO)
            elif action=="print":
                name=qs.get("name",["cmyk-strips"])[0]
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"color_epitope.pi"),"print",name],
                    capture_output=True,text=True,timeout=30,cwd=_REPO)
            else:
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"color_epitope.pi"),"list"],
                    capture_output=True,text=True,timeout=10,cwd=_REPO)
            self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # SCAN WATCHER STATE (GET /api/watcher)
    if self.path=="/api/watcher":
        try:
            sf=os.path.join(_REPO,"data","neutron","scan-watcher-state.json")
            pid_f=os.path.join(_REPO,"data","neutron","scan-watcher.pid")
            state={}
            if os.path.exists(sf):
                with open(sf) as f: state=json.load(f)
            pid="dead"
            if os.path.exists(pid_f):
                p=open(pid_f).read().strip()
                try:
                    os.kill(int(p),0); pid=f"alive:{p}"
                except: pid="dead"
            state["daemon"]=pid
            self._json(state)
        except Exception as e: self._json({"error":str(e)})
        return
    # GLOBE WALKER (GET /api/globe — pre-digital canopy)
    if self.path.startswith("/api/globe"):
        try:
            import urllib.parse
            qs=urllib.parse.parse_qs(urllib.parse.urlparse(self.path).query)
            action=qs.get("action",["status"])[0]
            if action=="walk":
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"globe_walker.pi"),"all"],
                    capture_output=True,text=True,timeout=120,cwd=_REPO)
                self._json(json.loads(r.stdout))
            elif action=="agglutinate":
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"globe_walker.pi"),"agglutinate"],
                    capture_output=True,text=True,timeout=10,cwd=_REPO)
                self._json(json.loads(r.stdout))
            elif action=="topic":
                topic=qs.get("q",["Cuneiform"])[0]
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"globe_walker.pi"),"topic",topic],
                    capture_output=True,text=True,timeout=15,cwd=_REPO)
                self._json(json.loads(r.stdout))
            else:
                gf=os.path.join(_REPO,"data","shadows","globe-walker-predigital.json")
                af=os.path.join(_REPO,"data","shadows","globe-agglutination.json")
                status={"organ":"globe_walker","walked":False}
                if os.path.exists(gf):
                    with open(gf) as f: d=json.load(f)
                    status={"organ":"globe_walker","walked":True,"total":d["total_walked"],
                            "categories":d["categories"],"tense":d["tense_counts"],"ts":d["ts"]}
                if os.path.exists(af):
                    with open(af) as f: a=json.load(f)
                    status["agglutination"]={"delta":a.get("delta"),"alive":len(a.get("alive_traditions",[])),
                                              "lost":len(a.get("lost_knowledge",[]))}
                self._json(status)
        except Exception as e: self._json({"error":str(e)})
        return
    # iPHONE DEPOT (GET /api/iphone — left eye status/discovery)
    if self.path.startswith("/api/iphone"):
        try:
            if self.path=="/api/iphone/discover":
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"iphone_depot.pi"),"discover"],
                    capture_output=True,text=True,timeout=10,cwd=_REPO)
                self._json(json.loads(r.stdout))
            else:
                r=subprocess.run(["python3",os.path.join(os.path.dirname(__file__),"iphone_depot.pi"),"status"],
                    capture_output=True,text=True,timeout=5,cwd=_REPO)
                self._json(json.loads(r.stdout))
        except Exception as e: self._json({"error":str(e)})
        return
    # ═══ UNIFIED MODEL FLEET — merge eastGate + northGate ═══
    if self.path=="/v1/models":
        self._proxy("GET"); return
    # ═══ ENCOUNTER — every dead-end is a living landing ═══
    # If Accept header wants JSON (API clients), proxy to Ollama
    accept=self.headers.get("Accept","")
    if "application/json" in accept or self.path.startswith("/v1/") or self.path.startswith("/api/"):
        self._proxy("GET")
    else:
        encounter(self, 404, G)
