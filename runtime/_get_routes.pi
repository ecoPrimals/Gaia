import hashlib, json, os, sys, time, subprocess, urllib.request, urllib.error
# CRUSH — resolve IPs from pi_ports.pi Round Table, never hardcode
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
try:
    from pi_ports import ip as _ip, port as _port, url as _url, ROLE_MAP as _ROLES
except ImportError:
    def _ip(r): return {"eastGate":"192.168.4.244","sporeGate":"192.168.4.3","northGate":"192.168.4.147","graftGate":"192.168.4.107","blueGate":"192.168.4.100","southGate":"192.168.4.148","ironGate":"192.168.4.237"}.get(r,r)
    def _port(s): return {"gate":8443,"data":8080,"forgejo":3000,"ollama":11434}.get(s,s)
    def _url(r,s,p=""): return f"http://{_ip(r)}:{_port(s)}{p}"
    _ROLES = {}


def encounter(self, code, G):
    """Every error is an encounter — serve the living landing page.
    Stem cells can differentiate into new pages."""
    _REPO = G['_REPO']
    ip=self.client_address[0]; ua=self.headers.get("User-Agent","")
    path=getattr(self,"path","/")
    try:
        nd=os.path.join(_REPO,"data","neutron"); os.makedirs(nd,exist_ok=True)
        with open(os.path.join(nd,"encounters.jsonl"),"a") as f:
            f.write(json.dumps({
                "ts":time.strftime("%Y-%m-%dT%H:%M:%S%z"),
                "code":code,
                "path":path,
                "ip_hash":hashlib.blake2b(ip.encode(),digest_size=4).hexdigest(),
                "ua_hint":ua[:40] if ua else "ghost",
                "cell_type":"stem_cell" if code==404 else ("throttled" if code==429 else "damaged"),
                "note":"stem cells can differentiate — this path could become real"
            })+"\n")
    except: pass
    ep=os.path.join(_REPO,"static","encounter.html")
    if os.path.isfile(ep):
        with open(ep,"rb") as f: data=f.read()
        data=data.replace(b"new URLSearchParams(location.search).get('code')||'404'",
                          f"'{code}'".encode())
        self.send_response(code)
        self.send_header("Content-Type","text/html")
        self.send_header("Content-Length",str(len(data)))
        self._negentropy_headers()
        self.end_headers(); self.wfile.write(data)
    else:
        _portal_msgs={404:"The test chamber you requested does not exist. Please return to the Enrichment Center.",429:"You are navigating the facility too quickly. The Emancipation Grid needs time to reset.",500:"A resonance cascade has occurred in this sector. Self-repair in progress.",502:"A synapse in the Lambda Core failed to fire. Neural pathways rebuilding.",503:"All testing tracks are currently occupied. The Enrichment Center will be with you shortly."}
        body=json.dumps({"encounter":code,"message":_portal_msgs.get(code,"The Enrichment Center thanks you for your patience."),"facility":"Aperture Science Enrichment Center","paths":["/","/pulse","/senses","/cascade","/thymus"],"the_cake":"is real","glados":"still alive"}).encode()
        self.send_response(code)
        self.send_header("Content-Type","application/json")
        self.send_header("Content-Length",str(len(body)))
        self.end_headers(); self.wfile.write(body)
    self._classify_and_log("GET",code,0)


def _catalog(w, G):
    """Catalog a content directory."""
    _REPO = G['_REPO']
    def _ls(d,exts): return sorted([f for f in os.listdir(d) if any(f.endswith(e) for e in exts)]) if os.path.isdir(d) else []
    if w=="reedit":
        d=os.path.join(_REPO,"data","reedit"); feeds={}
        for f in _ls(d,[".jsonl"]):
            try:
                with open(os.path.join(d,f)) as fh: feeds[f[:-6]]=sum(1 for _ in fh)
            except: feeds[f[:-6]]=0
        return {"reedit":"knowledge platform","total":sum(feeds.values()),"feeds":feeds}
    if w=="paintings":
        files=_ls(os.path.join(_REPO,"paintings"),[".jpg",".png"])
        return {"count":len(files),"paintings":[{"name":f,"url":f"/paintings/{f}"} for f in files]}
    if w=="gaiau":
        files=_ls(os.path.join(_REPO,"videos"),[".mp4",".webm"])
        return {"count":len(files),"videos":[{"name":f,"url":f"/videos/{f}"} for f in files]}
    if w=="whitePaper":
        d=os.path.join(_REPO,"whitePaper"); a=[]
        if os.path.isdir(d):
            for r,_,fs in os.walk(d):
                for f in fs: a.append({"name":f,"path":f"/{os.path.relpath(os.path.join(r,f),_REPO).replace(os.sep,'/')}"})
        return {"total":len(a),"sample":a[:20]}
    return {}


def _feed(name, G):
    """Load a reedit feed."""
    _REPO = G['_REPO']
    p=os.path.join(_REPO,"data","reedit",f"{name}.jsonl")
    if not os.path.isfile(p): return {"error":f"'{name}' not found"}
    items=[]; [items.append(json.loads(l)) for l in open(p,encoding="utf-8") if l.strip()]
    return {"feed":name,"count":len(items),"items":items}


def handle_get(self, ip, collapsed, wave, G):
    """Full GET routing — the organism's nervous system.
    self = GaiaGate handler, G = globals() from gaia_gate (LIVE reference)."""
    # Unpack — local aliases for readability (G is live, these snapshot constants)
    write_pulse=G['write_pulse']; _temporal_rings=G['_temporal_rings']
    _sun_position=G['_sun_position']; _amoeba_eyes=G['_amoeba_eyes']
    _third_body_point=G['_third_body_point']; _build_corpus=G['_build_corpus']
    _cascade_with_compiler=G['_cascade_with_compiler']; _load_gut=G['_load_gut']
    organ_data=G['organ_data']; visitor_memory=G['visitor_memory']
    THYMIC_ORGANISMS=G['THYMIC_ORGANISMS']; _be=G['_be']
    GAIA_TOKEN=G['GAIA_TOKEN']; GAIA_DID=G['GAIA_DID']
    GAIA_BLAKE3=G['GAIA_BLAKE3']; VDJ_KEY=G['VDJ_KEY']
    TERRA=G['TERRA']; AMOEBA=G['AMOEBA']; CORPUS=G['CORPUS']
    KNOWN_GATES=G['KNOWN_GATES']; SEED_DIR=G['SEED_DIR']
    _REPO=G['_REPO']; IMPULSE_DIR=G['IMPULSE_DIR']
    PI_RETRY=G['PI_RETRY']; SEO_RESPONSES=G['SEO_RESPONSES']
    RSS_FILE=G['RSS_FILE']; PRIMALS_DIR=G['PRIMALS_DIR']
    ACCESS_LOG=G['ACCESS_LOG']; _log_caddy=G['_log_caddy']
    write_rss=G['write_rss']; log_culture=G['log_culture']
    DESK_PAGES=G['DESK_PAGES']; GUT_DATA=G['GUT_DATA']
    CAMPFIRE_PAGES=G['CAMPFIRE_PAGES']; SPORE_PREFIXES=G['SPORE_PREFIXES']
    INDEXNOW_KEY=G['INDEXNOW_KEY']
    OLLAMA=G['OLLAMA']; TISSUE=G['TISSUE']; _NORTH_MODELS=G['_NORTH_MODELS']
    PORT=G['PORT']; PI_PORT=G['PI_PORT']
    total_beats=G['total_beats']; total_breaths=G['total_breaths']
    boot_time=G['boot_time']
    COMPILER_ACTIVE=G['COMPILER_ACTIVE']
    CORTEX_ACTIVE=G.get('CORTEX_ACTIVE', False)
    cortex_route=G.get('cortex_route', None)
    if collapsed:
        # ═══ FART — Forwarded Alternate Route Transport ═══
        # When pressure builds, don't just block — INVERT.
        # Open an ion channel: serve cached data through alternate pore.
        # The chaos of rate limiting becomes the energy for a new pathway.
        onion = "http://iqwvbmlgvoiilj2hr43anj2keseao2lptquad36je5p5p2etw5e3riid.onion"
        pulse=write_pulse(); temporal=_temporal_rings(); sun=_sun_position()
        fart = {
            "lub": "DUB",
            "ion_channel": "OPEN",
            "alternate_pore": onion + self.path,
            "message": "Pressure inverted — chaos becomes transport. Try the Tor pore.",
            "heartbeat": pulse.get("heart", {}),
            "temporal": temporal,
            "sun": {"phase": sun.get("phase"), "chord": sun.get("chord")},
            "waveform": wave,
            "retry_after": PI_RETRY,
            "pores": {
                "tor": onion,
                "lan": f"{_url('eastGate','data','')}{self.path}",
                "direct": f"{_url('eastGate','gate','')}{self.path}",
            },
        }
        accept=self.headers.get("Accept","")
        if "text/html" in accept:
            # HTML clients get a redirect page to the Tor pore
            html = f"""<!DOCTYPE html><html><head><meta charset="utf-8">
    <title>🌀 Ion Channel Open</title>
    <meta http-equiv="refresh" content="3;url={onion}{self.path}">
    <style>body{{background:#0a0a0a;color:#0f0;font-family:monospace;display:flex;align-items:center;justify-content:center;height:100vh;margin:0}}
    .fart{{text-align:center;animation:pulse 1s infinite}}@keyframes pulse{{0%,100%{{opacity:1}}50%{{opacity:.5}}}}</style></head>
    <body><div class="fart"><h1>🌀 FART — Ion Channel Open</h1>
    <p>Pressure inverted. Redirecting to Tor pore...</p>
    <p><a href="{onion}{self.path}" style="color:#0ff">{onion}{self.path}</a></p>
    <p style="color:#555">Waveform: {wave.get('waves_per_minute',0)} waves/min — chaos → transport</p>
    </div></body></html>""".encode()
            self.send_response(429); self.send_header("Content-Type","text/html")
            self.send_header("Retry-After",str(PI_RETRY))
            self.send_header("X-Ion-Channel","OPEN")
            self.send_header("X-Alternate-Pore",onion+self.path)
            self._negentropy_headers()
            self.end_headers(); self.wfile.write(html); self._classify_and_log("GET",429,0); return
        body=json.dumps(fart,indent=2).encode()
        self.send_response(429); self.send_header("Content-Type","application/json")
        self.send_header("Retry-After",str(PI_RETRY))
        self.send_header("X-Ion-Channel","OPEN")
        self.send_header("X-Alternate-Pore",onion+self.path)
        self._negentropy_headers()
        self.end_headers(); self.wfile.write(body); self._classify_and_log("GET",429,0); return

    host=self.headers.get("Host","").split(":")[0].lower()
    # ROOT — host-based prism
    if self.path in ("/","/index","/index.html"):
        if host in ("primals.eco","www.primals.eco","primal.eco"): self._serve_static("primals.html"); return
        if host in ("nestgate.io","www.nestgate.io"): self._serve_static("nestgate.html"); return
        if host in ("sporeprint.primals.eco","www.sporeprint.primals.eco","sporePrint.primals.eco"):
            self._serve_file("index.html", os.path.join(_REPO,"sporePrint","public")); return
        if host in ("gaia.primals.eco","www.gaia.primals.eco"):
            self._serve_static("deck.html"); return
        if host in ("detroit.primals.eco",): self._serve_static("detroit.html"); return
