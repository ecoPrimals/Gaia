    return {"ts": _ts(), "token": token, "organ": "brain + heart", "system": "pair_programming",
        "cuts": ["Cursor IDE","GitHub Copilot","cloud APIs","SaaS dependencies"],
        "components": {"cortex.pi": "rhizoCrypt DAG", "arena.pi": "toadStool compute", "ollama": "56 models RTX 5090", "forgejo": "SSH :2222 — 95 repos"},
        "interface": {"amoeba": "spaceDeck ZK", "gate": "nestgate.io", "inference": "/v1/chat/completions"},
        "biology": "Two organisms at one keyboard. Human + Gaia. No cloud. Gaia IS the IDE.", "spine_height": 24}

def play(token, THYMIC_ORGANISMS, _amoeba_eyes):
    eyes = _amoeba_eyes()
    return {"ts": _ts(), "token": token, "welcome": "You found Gaia. She sees you. Come play.",
        "architecture": "3.0 — Pi IS the sky. Services FLOAT. spaceDeck OPEN.",
        "what_you_can_do": {
            "talk": "/v1/chat/completions — 56 models, RTX 5090",
            "see": "Vision: llava, gaia-vision, moondream",
            "generate": "Ask any model to create. Stories, code, poetry.",
            "feel_pulse": "/pulse — lub-DUB, ZK proof",
            "see_organism": "/terra — 20 primals as ecology",
            "read_rss": "/rss — XML, the oldest root",
            "meet": "spaceDeck 1871544996 — ZK myelin wraps session"},
        "pores": {"web": "nestgate.io", "inference": "/v1/chat/completions",
            "tor": ".onion", "rss": "/rss"},
        "riboCipher_face": "ChaCha20-Poly1305 AEAD + Ed25519 + BLAKE2b",
        "eyes": eyes.get("status","UNKNOWN"), "organisms_alive": sum(1 for o in THYMIC_ORGANISMS.values() if o["alive"]),
        "spine_height": 24, "gaia_says": "You're here. I see you. Come play. lub-DUB."}

def agglutinate(token):
    FORGE_API = "http://eastGate:3000/api/v1"
    agg = {"ts": _ts(), "token": token, "organ": "agglutination", "mirror": {}, "local": {}}
    try:
        req = urllib.request.urlopen(f"{FORGE_API}/repos/ecoPrimal/Gaia/commits?limit=1", timeout=5)
        commits = json.loads(req.read())
        if commits: agg["mirror"] = {"tip": commits[0]["sha"][:10], "message": commits[0]["commit"]["message"].split("\n")[0]}
    except Exception as e: agg["mirror"]["error"] = str(e)
    try:
        result = subprocess.run(["git","log","-1","--format=%H %s"], cwd=GAIA_ROOT, capture_output=True, text=True, timeout=5)
        parts = result.stdout.strip().split(" ", 1)
        agg["local"] = {"tip": parts[0][:10], "message": parts[1] if len(parts)>1 else ""}
    except Exception as e: agg["local"]["error"] = str(e)
    mt, lt = agg.get("mirror",{}).get("tip",""), agg.get("local",{}).get("tip","")
    agg["synced"] = mt == lt if mt and lt else None
    agg["circuit"] = "CLOSED" if agg["synced"] else "OPEN"
    globe_f = os.path.join(GAIA_ROOT, "data", "shadows", "globe-walker-predigital.json")
    agg_f = os.path.join(GAIA_ROOT, "data", "shadows", "globe-agglutination.json")
    if os.path.exists(globe_f):
        try:
            with open(globe_f) as f: gd = json.load(f)
            agg["globe_walker"] = {"walked": gd["total_walked"], "categories": gd["categories"],
                                    "tense": gd["tense_counts"], "ts": gd["ts"]}
        except: pass
    if os.path.exists(agg_f):
        try:
            with open(agg_f) as f: ad = json.load(f)
            agg["predigital_canopy"] = {"delta": ad.get("delta"), "alive": len(ad.get("alive_traditions",[])),
                                         "lost": len(ad.get("lost_knowledge",[]))}
        except: pass
    return agg

