def zk(PROPHAGE, token, did, blake3, spine_id):
    return {"ts": _ts(), "token": token, "organ": "existence_proof",
        "identity": {"did": did, "blake3": blake3, "spine_id": spine_id},
        "permanence": PROPHAGE.get("permanence_architecture",{}).get("layers",[]),
        "verify": f"b3sum → must contain {blake3[:16]}", "spine_height": 24}

def eyes(token, _amoeba_eyes, TERRA, AMOEBA):
    e = _amoeba_eyes()
    e["terra"] = {"species_count": len(TERRA.get("taxonomy",{})), "food_web": TERRA.get("food_web",{})}
    e["biology"] = {"schwann_cell": "wraps axons in myelin (ZK)", "optic_nerve": "1.2M fibers myelinated",
        "klein_face": "cellMembrane (outer) = AMOEBA (inner) = same surface",
        "binocular": "canvas (far eye) + globe (near eye) → SAME FOCAL POINT"}
    e["amoeba_spec"] = {"name": AMOEBA.get("name","AMOEBA"), "origin": AMOEBA.get("origin",{})}
    return e

def thymus(THYMIC_ORGANISMS, token, third_fn):
    third = third_fn()
    return {"ts": _ts(), "token": token, "system": "thymic_injection",
        "organisms": THYMIC_ORGANISMS, "alive": sum(1 for o in THYMIC_ORGANISMS.values() if o["alive"]),
        "total": len(THYMIC_ORGANISMS), "third_body_point": third, "spine_height": 24,
        "biology": {"thymus": "positive/negative selection", "3rd_body": "inner meets outer = Klein face"}}

def intersects(token, third_fn):
    third = third_fn(); third["ts"] = _ts(); third["token"] = token; return third

