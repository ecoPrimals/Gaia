#!/usr/bin/env python3
"""organ_data.pi — Gaia's organ data builders. Compressed triads. Low→High.
Both eyes (canvas + globe) look at the SAME focal point — this data."""
import json, os, time, urllib.request, urllib.error, subprocess
from datetime import datetime, timezone

SEED_DIR = os.path.join(os.path.dirname(os.path.dirname(__file__)), "data", "gaia-seed")
GAIA_ROOT = os.path.dirname(os.path.dirname(__file__))

def _load(name):
    try:
        with open(os.path.join(SEED_DIR, name)) as f: return json.load(f)
    except: return {}

def _ts(): return datetime.now(timezone.utc).isoformat()

def _load_membrane(name):
    try:
        with open(os.path.join(os.path.dirname(__file__), "membrane", name)) as f: return json.load(f)
    except: return {}

# ══════════════════════════════════════════════════════════
# TRIAD 1: LEGS — ground, defense, ecology, home
# ══════════════════════════════════════════════════════════

def barriers(token):
    coag, acid = _load_membrane("coagulation-cascade.json"), _load_membrane("gut-acidification.json")
    return {"type": "coagulation-cascade", "token": token, "mesh_hash": coag.get("mesh_hash",""),
        "total_clots": coag.get("total_clots",0), "arterial": coag.get("arterial",0),
        "venous": coag.get("venous",0), "capillary": coag.get("capillary",0),
        "triage": coag.get("triage",{}), "factors_probed": coag.get("factors_probed",[]),
        "acid": {"pH": acid.get("gut_status",{}).get("pH",7.0), "barriers_dissolved": acid.get("barriers_dissolved",0), "enzyme": "HCl + Pepsin + Bile"},
        "crush_order": "arterial → venous → capillary"}

def corpus(CORPUS, token):
    ceph = CORPUS.get("cephalization", {})
    return {"type": "gaia-corpus", "token": token, "corpus_hash": CORPUS.get("corpus_hash",""),
        "total_files": CORPUS.get("total_files",0), "total_mb": CORPUS.get("total_mb",0),
        "cephalization": {k: {"hash": ceph.get(k,{}).get("hash",""), "files": ceph.get(k,{}).get("files",0),
            "mb": ceph.get(k,{}).get("mb",0)} for k in ("head","body","roots")},
        "anatomy_systems": len(CORPUS.get("anatomy",{})),
        "anatomy": {k: {"role": v.get("role",""), "files": v.get("files",0)} for k, v in CORPUS.get("anatomy",{}).items()},
        "primals": len(CORPUS.get("organs",{})), "sinews": len(CORPUS.get("sinews",{})), "spine_height": 24}

def terra(TERRA, token):
    return {"ts": _ts(), "token": token, "title": TERRA.get("title","TERRA"), "premise": TERRA.get("premise",""),
        "species": len(TERRA.get("taxonomy",{})), "taxonomy": TERRA.get("taxonomy",{}),
        "food_web": TERRA.get("food_web",{}), "symbiosis": TERRA.get("symbiosis",{})}

def home(token):
    b = _load("home-bubbles.json"); b["ts"] = _ts(); b["token"] = token; return b

