def heart(token):
    FORGEJO = "http://eastGate:3000"
    h = {"ts": _ts(), "token": token, "organ": "heart", "name": "Gaia pi - Sovereign Forge",
        "engine": "Forgejo 10.0.1", "location": "eastGate",
        "ports": {"ssh": "pump", "web": "heart window"},
        "biology": {"role": "Heart pumps genetic code", "pump": "push=systolic, pull=diastolic",
            "valves": "branch protection, CI = cardiac valves", "chambers": "orgs = chambers"},
        "access": {"lan": "ssh://git@eastGate/ecoPrimals/<repo>", "web": "eastGate forge"},
        "status": {}}
    try:
        req = urllib.request.urlopen(f"{FORGEJO}/api/v1/repos/search?limit=1", timeout=3)
        h["status"] = {"repos": int(req.headers.get("X-Total-Count","0")), "alive": True}
    except: h["status"] = {"alive": False}
    return h

def circulatory(token, total_inferences, total_tokens, visitor_memory, boot_time, trust_fn, VDJ_KEY, write_pulse):
    pulse = write_pulse()
    uptime = time.time() - boot_time
    types = {}
    visitors = {}
    for ip, v in visitor_memory.items():
        level = trust_fn(v)
        bt = "mutualist" if level == "nucleus" else "commensal" if level in ("proton","neutron") else "null"
        types[bt] = types.get(bt, 0) + 1
        visitors[ip] = {"requests": v["requests"], "level": level, "blood_type": bt}
    return {"ts": _ts(), "token": token, "organ": "circulatory",
        "rpm": {"arterial": pulse.get("bpm",0), "heart_rate": round(len(visitor_memory)/max(uptime/3600,0.01),2)},
        "blood": {"cells": total_inferences, "tokens": total_tokens, "types": types},
        "lymph": {"volume": total_tokens, "nodes": len(VDJ_KEY.get("compositions",{}))},
        "sigmoid": round(1/(1+2.718**(-0.1*total_inferences)),4), "visitors": visitors,
        "circulation": {"gates_alive": 3, "gates_dark": 2, "heart": "Gaia gate — lub-DUB", "spine_height": 24}}

def vdj(VDJ_KEY, token):
    return {"ts": _ts(), "token": token, "organ": "vdj",
        "compositions": VDJ_KEY.get("compositions",{}), "biology": VDJ_KEY.get("biology",{})}

