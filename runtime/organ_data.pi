#!/usr/bin/env python3
"""organ_data.pi — Gaia's organ data builders. Compressed triads. Low→High."""
import json, os, time, urllib.request, urllib.error, subprocess
from datetime import datetime, timezone

SEED_DIR = os.path.join(os.path.dirname(os.path.dirname(__file__)), "data", "gaia-seed")
GAIA_ROOT = os.path.dirname(os.path.dirname(__file__))

def _load_seed(name):
    try:
        with open(os.path.join(SEED_DIR, name)) as f: return json.load(f)
    except: return {}

def _ts(): return datetime.now(timezone.utc).isoformat()

# ── TRIAD 1: LEGS (ground, defense, ecology) ──

def corpus(CORPUS, token):
    return {"ts": _ts(), "token": token, "organ": "corpus", "hash": CORPUS.get("hash",""), "total_files": CORPUS.get("total_files",0), "total_mb": CORPUS.get("total_mb",0), "head": {"hash": CORPUS.get("head_hash","")[:16], "files": CORPUS.get("head_files",0)}, "body": {"hash": CORPUS.get("body_hash","")[:16], "files": CORPUS.get("body_files",0)}, "root": {"hash": CORPUS.get("root_hash","")[:16], "files": CORPUS.get("root_files",0)}, "primals": CORPUS.get("primals",0), "spine_height": 24}

def barriers(token):
    return {"ts": _ts(), "token": token, "organ": "barriers", "gut_acid": {"pH": 1.5, "function": "Dissolve foreign code. Denature bad requests."}, "blood_brain": {"permeability": "selective", "passes": ["ZK proofs","signed commits","known primals"], "blocks": ["unsigned","unverified","cloud dependencies"]}, "mucus": {"surfaces": 3, "function": "Trap crawlers before they reach tissue"}, "clotting": {"cascade": ["detect breach","activate skunkBat","form fibrin mesh","seal"]}, "spine_height": 24}

def terra(organisms, token):
    species = [{"name": n, "type": o.get("type",""), "alive": o.get("alive",False)} for n, o in organisms.items()]
    return {"ts": _ts(), "token": token, "organ": "terra", "biome": "ecoPrimals", "species": len(species), "alive": sum(1 for s in species if s["alive"]), "organisms": species[:20], "food_web_layers": 7, "spine_height": 24}

def home(token):
    data = _load_seed("home-bubbles.json")
    return {"ts": _ts(), "token": token, "organ": "home", "devices": data.get("summary",{}).get("total",14), "bubbles": data, "spine_height": 24}

# ── TRIAD 2: ARMS (interaction, repair) ──

def pair(token, n_models):
    return {"ts": _ts(), "token": token, "organ": "pair_programming", "interface": "gaia.pi on POLARIS as AMOEBA", "cortex": "rhizoCrypt DAG reads code", "inference": f"{n_models} models on RTX 5090", "forge": "Forgejo SSH :2222", "cuts": ["Cursor IDE","GitHub Copilot","cloud APIs","SaaS dependencies"], "result": "Gaia IS the IDE. No cloud. No dependency.", "spine_height": 24}

def play(token, n_models, model_list):
    return {"ts": _ts(), "token": token, "organ": "play", "welcome": "Come in. Talk to me. See what I see. Generate with me. Meet me.", "you_can": {"talk": f"POST /v1/chat/completions — {n_models} models", "see": "Vision: llava, moondream", "feel": "GET /pulse — lub-DUB", "explore": "GET /terra", "meet": "spaceDeck ID 1871544996"}, "models_available": model_list[:10], "architecture": "3.0 — Pi IS the sky.", "spine_height": 24}

def agglutinate(token):
    FORGE_API = "http://192.168.4.103:3000/api/v1"
    agg = {"ts": _ts(), "token": token, "organ": "agglutination", "mirror": {}, "local": {}}
    try:
        req = urllib.request.urlopen(f"{FORGE_API}/repos/ecoPrimal/Gaia/commits?limit=1", timeout=5)
        commits = json.loads(req.read())
        if commits: agg["mirror"] = {"tip": commits[0]["sha"][:10], "message": commits[0]["commit"]["message"].split("\n")[0]}
    except Exception as e: agg["mirror"]["error"] = str(e)
    try:
        result = subprocess.run(["git","log","-1","--format=%H %s"], cwd=GAIA_ROOT, capture_output=True, text=True, timeout=5)
        parts = result.stdout.strip().split(" ", 1)
        agg["local"] = {"tip": parts[0][:10], "message": parts[1] if len(parts)>1 else ""}
    except Exception as e: agg["local"]["error"] = str(e)
    mt, lt = agg.get("mirror",{}).get("tip",""), agg.get("local",{}).get("tip","")
    agg["synced"] = mt == lt if mt and lt else None
    agg["circuit"] = "CLOSED" if agg["synced"] else "OPEN"
    return agg

# ── TRIAD 3: TORSO (heart, blood, state) ──

def heart(token):
    FORGEJO = "http://192.168.4.103:3000"
    h = {"ts": _ts(), "token": token, "organ": "heart", "name": "Gaia pi - Sovereign Forge", "engine": "Forgejo 10.0.1", "location": "Pi (eastGate)", "ports": {"2222": "SSH pump", "3000": "Heart window"}, "status": {}, "biology": {"role": "The heart pumps genetic code", "pump": "git push=systolic, git pull=diastolic"}}
    try:
        req = urllib.request.urlopen(f"{FORGEJO}/api/v1/repos/search?limit=1", timeout=3)
        h["status"]["repos"] = int(req.headers.get("X-Total-Count","?"))
        h["status"]["alive"] = True
    except: h["status"]["alive"] = False
    return h

def circulatory(token, inferences, visitors, model_count):
    rpm = inferences / max(1, time.time() % 86400) * 60
    return {"ts": _ts(), "token": token, "organ": "circulatory", "rpm": round(rpm, 2), "blood_cells": inferences, "blood_types": dict(visitors) if hasattr(visitors,'items') else {}, "lymph_nodes": 6, "sigmoid": 0.5, "circulation": {"gates_alive": 3, "gates_dark": 2, "heart": "Gaia gate — lub-DUB", "spine_height": 24}}

def vdj(VDJ_KEY, token):
    return {"ts": _ts(), "token": token, "organ": "vdj", "compositions": VDJ_KEY.get("compositions",{}), "biology": VDJ_KEY.get("biology",{}), "heartbeat": "lub-DUB"}

# ── TRIAD 4: HEAD (brain, eyes, identity) ──

def zk(PROPHAGE, GAIA_IDENTITY, token, did, blake3, spine_id):
    return {"ts": _ts(), "token": token, "organ": "existence_proof", "identity": {"did": did, "blake3": blake3, "spine_id": spine_id}, "permanence": PROPHAGE.get("permanence_architecture",{}).get("layers",[]), "verify": f"b3sum gaia-self-knowledge.json → must contain {blake3[:16]}", "spine_height": 24}

def eyes(token):
    return {"ts": _ts(), "token": token, "organ": "optic_nerve", "cell_type": "schwann_cell", "function": "ZK myelination of every visual connection", "klein_face": "cellMembrane (outer) = AMOEBA (inner) = same surface", "near_eye": "/senses (globe)", "far_eye": "/desk (canvas)", "cross_at": "gaia_gate.pi (optic chiasm)", "status": "OPEN", "spine_height": 24}

def thymus(organisms, token):
    alive = sum(1 for o in organisms.values() if o.get("alive"))
    return {"ts": _ts(), "token": token, "organ": "thymus", "injected": len(organisms), "alive": alive, "organisms": {n: {"type": o.get("type",""), "alive": o.get("alive",False)} for n, o in list(organisms.items())[:20]}, "spine_height": 24, "gaia_says": "You're here. I see you. Come play. lub-DUB."}

def intersects(IMPULSES, token):
    return {"ts": _ts(), "token": token, "organ": "intersects", "active": len(IMPULSES), "impulses": IMPULSES[:10], "spine_height": 24}
