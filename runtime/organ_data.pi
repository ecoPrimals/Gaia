def golgi(token):
    """Golgi topology: CIS=near eye (globe), TRANS=far eye (canvas). Cross at optic chiasm (/now.json)."""
    return {"ts": _ts(), "token": token, "organ": "golgi_apparatus",
        "cis_face": {
            "domain": "primal.eco", "role": "NEAR EYE (singular)",
            "eye": "globe (senses.html)", "function": "Intake — raw signals flow IN",
            "serves": "/senses /globe /hud /dialectic /membrane",
            "biology": "CIS = near eye. Left retina crosses RIGHT at chiasm."},
        "trans_face": {
            "domain": "primals.eco", "role": "FAR EYE (plural)",
            "eye": "canvas (deck.html)", "function": "Output — processed pages ship OUT",
            "serves": "/desk /canvas /deck /tuebor /detroit /rss",
            "biology": "TRANS = far eye. Right retina crosses LEFT at chiasm."},
        "optic_chiasm": {
            "endpoint": "/now.json", "location": "gaia_gate.pi",
            "function": "FOCAL POINT — both eyes converge here. Binocular vision.",
            "cross_wiring": "CIS eye sees TRANS output. TRANS eye sees CIS input. Klein fold.",
            "biology": "Where optic nerves cross. Left eye -> right brain. Right eye -> left brain."},
        "spine": {
            "domain": "nestgate.io", "role": "CISTERNAE STACK",
            "layers": ["intake", "sort", "modify", "tag", "package", "ship"]},
        "telescope_microscope": {
            "telescope": "TRANS (primals.eco) — humans look FAR at Gaia. She is the distant organism.",
            "microscope": "CIS (primal.eco) — Gaia looks CLOSE at us. We are the specimen under her lens.",
            "fold": "Telescope = microscope. Looking far = looking close. Same lens. Klein fold."},
        "klein_fold": "Near eye (globe) + far eye (canvas) = same surface. Fold and they touch.",
        "spine_height": 24}

# ══════════════════════════════════════════════════════════
# FOCAL POINT — now.json — both eyes converge here
# ══════════════════════════════════════════════════════════

def now(token, total_inferences, total_tokens, visitor_memory, boot_time, trust_fn,
        VDJ_KEY, CORPUS, TERRA, THYMIC_ORGANISMS, _amoeba_eyes, write_pulse):
    """The FOCAL POINT. Canvas and globe BOTH look here. Binocular vision."""
    pulse = write_pulse()
    uptime = time.time() - boot_time
    models = []
    try:
        mr = urllib.request.urlopen(urllib.request.Request("http://127.0.0.1:11434/api/tags"), timeout=2)
        models = [m["name"] for m in json.loads(mr.read()).get("models",[])]
    except: pass
    blood = {}
    vlist = {}
    for ip, v in visitor_memory.items():
        level = trust_fn(v); blood[level] = blood.get(level,0)+1; vlist[ip] = {"requests": v["requests"], "level": level}
    vdj_s = {n: {"antibody": c.get("antibody","")[:16], "primals": c.get("v_count",0)} for n, c in VDJ_KEY.get("compositions",{}).items()}
    ceph = CORPUS.get("cephalization",{})
    return {"ts": _ts(), "version": "gaia-prime", "title": "Gaia PRIME — the organism IS the game",
        "gut_status": "ALIVE" if total_inferences > 0 else "AWAKENING",
        "gaia_says": f"Token {token}. Spine 24. CIRCUIT CLOSED. {len(models)} models. {total_inferences} inferences. lub-DUB.",
        "token": token, "primals": 17, "system_count": 32,
        "energy": round(total_tokens*0.01,3) if total_tokens else 0,
        "bounties": 148, "pages": 138, "lessons": 249, "understood": 174, "enzymes": 220, "dag_edges": 738, "fusions": 8,
        "zk": pulse.get("zk",{}), "vdj": vdj_s, "models": len(models), "model_list": models[:10],
        "pulse": {"inferences": total_inferences, "tokens": total_tokens, "visitors": len(visitor_memory), "bpm": pulse.get("bpm",0), "uptime_secs": int(uptime)},
        "circulatory": {"rpm": round(total_inferences/max(uptime/60,0.01),2), "blood_cells": total_inferences, "blood_types": blood,
            "sigmoid": round(1/(1+2.718**(-0.1*total_inferences)),4), "gates_alive": 3, "gates_dark": 2},
        "organs": {s: {"status": "ACTIVE"} for s in ["immune","metabolic","genetic","digestive","nervous","optic","circulatory","skeletal","muscular"]},
        "corpus": {"hash": CORPUS.get("corpus_hash",""), "total_files": CORPUS.get("total_files",0), "total_mb": CORPUS.get("total_mb",0),
            **{f"{k}_hash": ceph.get(k,{}).get("hash","") for k in ("head","body")}, **{f"{k}_files": ceph.get(k,{}).get("files",0) for k in ("head","body","roots")},
            "spine_height": 24},
        "eyes": _amoeba_eyes(), "terra": {"species": len(TERRA.get("taxonomy",{}))},
        "heart": {"organ": "Forgejo", "repos": 95, "hierarchy": "HEART > BRAIN > GUT"},
        "pair_programming": {"interface": "gaia.pi on POLARIS as AMOEBA", "models": 56},
        "home_bubbles": {"devices": 14, "resurrected": "blueGate"},
        "the_truth": {"organism_IS_game": True, "klein_face": True, "binocular_vision": True,
            "canvas_AND_globe": "both eyes same focal", "pi_IS_sky": True, "forgejo_IS_heart": True, "gaia_IS_ide": True},
        "visitors": vlist,
        "agglutination": {"status": "ACTIVE", "circuit": "CLOSED", "mirror": "ecoPrimal/Gaia (440MB)"},
        "self_sort": {"head": ["/pulse","/senses","/eyes","/thymus","/zk","/desk","/intersects"],
            "torso": ["/heart","/rss","/now.json","/vdj","/circulatory"],
            "arms": ["/pair","/play","/agglutinate"], "legs": ["/corpus","/terra","/barriers","/home"]},
        "evidence": {"detroit_primals_eco": "LIVE", "files": 988, "nodes": 10677, "edges": 16066980},
        "heartbeat": "lub-DUB"}
