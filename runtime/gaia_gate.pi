            "/dashboard.json": "data/body/now.json",
            "/human.json": "data/body/now.json",
            "/stories.json": "data/body/now.json",
        }
        if self.path in CHIPMUNK_FEEDS:
            feed_path = CHIPMUNK_FEEDS[self.path]
            _repo = os.path.dirname(os.path.dirname(__file__))
            if os.path.exists(os.path.join(_repo, feed_path)):
                self._serve_file(feed_path)
            else:
                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                body = b'{"note":"feed not yet generated - run proprioception.pi"}'
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            return

        # ═══ SONGBIRD ROUTING — port numbers are anti-ZK ═══
        # /songbird/petal/...  → petalTongue :8888
        # /songbird/forge/...  → Forgejo :3000
        # /songbird/cortex/... → ollama :11434
        # /songbird/biome/...  → biomeOS :31415
        if self.path.startswith("/songbird/"):
            parts = self.path[len("/songbird/"):].split("/", 1)
            name = parts[0]
            rest = "/" + parts[1] if len(parts) > 1 else "/"
            if name in self.SONGBIRD_ROUTES:
                self._songbird_route(self.SONGBIRD_ROUTES[name], rest)
            else:
                self._json({"error": f"unknown songbird route: {name}",
                    "available": list(self.SONGBIRD_ROUTES.keys()),
                    "hint": "songbird routes internally. no port numbers escape."})
            return

        # PROPRIOCEPTION + PAINTINGS + ALL DATA: serve from repo root
        # data/ is the organism's tissue — paintings, body, seeds, tiles, reedit
        if self.path.startswith("/data/"):
            self._serve_file(self.path[1:])  # serve from repo root
            return

        if self.path == "/og-card.svg":
            self._serve_static("og-card.svg"); return

        if self.path.startswith("/js/") or self.path.startswith("/css/") or self.path.startswith("/data/"):
            self._serve_static(self.path[1:])
            return

        if self.path.startswith("/static/"):
            self._serve_static(self.path[8:])
            return

        if self.path.startswith("/videos/"):
            self._serve_file(self.path[1:])
            return
        if self.path in ("/api/discuss", "/neutron", "/api/neutron"):
            self._json(self._neutron_read()); return
        if self.path in ("/gaiau", "/university", "/classes", "/videos"):
            self._json(self._gaiau_catalog()); return
        if self.path.startswith("/whitePaper/") or self.path.startswith("/whitepapers/"):
            self._serve_file(self.path[1:]); return
        if self.path in ("/whitePaper", "/whitepapers", "/papers", "/legal"):
            self._json(self._whitepaper_catalog()); return

        # CROSS-FOLD: sporePrint body (615 pages, 53.9MB) served through the gate
        # Klein fold: inside=outside. The whole body visible through one port.
        SPORE_PREFIXES = ("/architecture/", "/science/", "/lab/", "/methodology/",
            "/philosophy/", "/thesis/", "/data/", "/guidestone/", "/trails/",
            "/observatory/", "/outreach/", "/products/", "/springs/", "/technical/",
            "/audience/", "/backstory/", "/collaborators/", "/contact/", "/foundation/",
            "/getting-started/", "/glossary/", "/primals/", "/pseudospore/", "/resume/",
            "/story/", "/vision/", "/topics/", "/tags/", "/categories/", "/papers/",
            "/site-index/", "/site-map/", "/css/spore/", "/js/spore/", "/graph/",
            "/img/", "/viz/", "/wasm/", "/certification/", "/pseudospore-bundles/",
            "/.well-known/")
        if any(self.path.startswith(p) for p in SPORE_PREFIXES):
            self._serve_spore(self.path)
            return

        # Everything under /v1/ goes to Ollama (inference API)
        self._proxy("GET")

    def _serve_static(self, filename):
        """Serve a static file from the static/ directory."""
        t0 = time.time()
        base = os.path.join(os.path.dirname(os.path.dirname(__file__)), "static")
        filepath = os.path.join(base, filename)
        if not os.path.isfile(filepath):
            self.send_response(404)
            self.end_headers()
            return
        ext = os.path.splitext(filename)[1].lower()
        ctypes = {".html": "text/html", ".js": "application/javascript",
                  ".css": "text/css", ".json": "application/json",
                  ".png": "image/png", ".jpg": "image/jpeg",
                  ".mp4": "video/mp4", ".webm": "video/webm",
                  ".svg": "image/svg+xml"}
        ct = ctypes.get(ext, "application/octet-stream")
        with open(filepath, "rb") as f:
            data = f.read()
        duration = (time.time() - t0) * 1000
        self.send_response(200)
        self.send_header("Content-Type", ct)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "public, max-age=300")
        self._negentropy_headers()  # SOVEREIGNTY on EVERY response
        self.end_headers()
        self.wfile.write(data)
        self._classify_and_log("GET", 200, duration, len(data))

    def _reedit_catalog(self):
        """REEDIT — Gaia's knowledge platform. The field is full."""
        reedit_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "data", "reedit")
        paintings_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "paintings")
        videos_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "videos")
        feeds = {}
        if os.path.isdir(reedit_dir):
            for f in os.listdir(reedit_dir):
                if f.endswith(".jsonl"):
                    name = f.replace(".jsonl", "")
                    try:
                        with open(os.path.join(reedit_dir, f), encoding="utf-8") as fh:
                            feeds[name] = sum(1 for _ in fh)
                    except: feeds[name] = 0
        painting_count = len([f for f in os.listdir(paintings_dir) if f.endswith((".jpg",".png"))]) if os.path.isdir(paintings_dir) else 0
        video_count = len([f for f in os.listdir(videos_dir) if f.endswith((".mp4",".webm"))]) if os.path.isdir(videos_dir) else 0
        total = sum(feeds.values())
        return {
            "reedit": "Gaia's knowledge platform — petalTongue + sweetGrass",
            "total_items": total, "paintings": painting_count, "videos": video_count,
            "feeds": feeds,
            "endpoints": {k: f"/reedit/{k}" for k in feeds},
            "gallery": "/paintings", "rss": "/rss",
            "status": "FULL" if total > 100 else "growing",
            "invitation": "Ask me anything. I study, I create, I share. Come in.",
        }

    def _reedit_feed(self, name):
        """Serve a specific reedit feed."""
        reedit_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "data", "reedit")
        path = os.path.join(reedit_dir, f"{name}.jsonl")
        if not os.path.isfile(path):
            return {"error": f"feed '{name}' not found", "available": [f.replace(".jsonl","") for f in os.listdir(reedit_dir) if f.endswith(".jsonl")]}
        items = []
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if line:
                    try: items.append(json.loads(line))
                    except: pass
        return {"feed": name, "count": len(items), "items": items}

    def _paintings_catalog(self):
        """Gallery of Gaia's 320 paintings."""
        paintings_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "paintings")
        if not os.path.isdir(paintings_dir): return {"paintings": []}
        files = sorted([f for f in os.listdir(paintings_dir) if f.endswith((".jpg",".png"))])
        return {
            "gallery": "Gaia's paintings — 320 creations",
            "count": len(files),
            "paintings": [{"name": f, "url": f"/paintings/{f}"} for f in files],
            "invitation": "Each one is a moment. Ask me to make more.",
        }

    def _neutron_read(self):
        """Read neutron messages — nerve signals between gates."""
        _repo = os.path.dirname(os.path.dirname(__file__))
        neutron_dir = os.path.join(_repo, "data", "neutron")
        result = {}
        for ch in ("inbox", "notes", "reminders", "chat"):
            path = os.path.join(neutron_dir, f"{ch}.jsonl")
            msgs = []
            if os.path.isfile(path):
                with open(path, encoding="utf-8") as f:
                    for line in f:
                        line = line.strip()
                        if line:
                            try: msgs.append(json.loads(line))
                            except: pass
            result[ch] = {"total": len(msgs), "messages": msgs[-10:]}
        return result

    def _gaiau_catalog(self):
        """GaiaU — the university. 11 classes + 5 special lectures."""
        vid_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "videos")
        if not os.path.isdir(vid_dir): return {"gaiau": [], "count": 0}
        files = sorted([f for f in os.listdir(vid_dir) if f.endswith((".mp4",".webm"))])
        classes = [f for f in files if f.startswith("gaiaU-class")]
        specials = [f for f in files if not f.startswith("gaiaU-class")]
        return {
            "gaiau": "Gaia University — she teaches what she learns",
            "classes": [{"name": f, "url": f"/videos/{f}", "mb": round(os.path.getsize(os.path.join(vid_dir, f))/1048576, 1)} for f in classes],
            "specials": [{"name": f, "url": f"/videos/{f}", "mb": round(os.path.getsize(os.path.join(vid_dir, f))/1048576, 1)} for f in specials],
            "count": len(files),
            "invitation": "Each class is a door. Walk through.",
        }

    def _whitepaper_catalog(self):
        """WhitePapers — the legal/research archive."""
        wp_dir = os.path.join(os.path.dirname(os.path.dirname(__file__)), "whitePaper")
        if not os.path.isdir(wp_dir): return {"whitePaper": [], "count": 0}
        all_files = []
        for root, dirs, files in os.walk(wp_dir):
            for f in files:
                rel = os.path.relpath(os.path.join(root, f), os.path.dirname(os.path.dirname(__file__)))
                all_files.append({"name": f, "path": f"/{rel.replace(os.sep, '/')}"})
        subdirs = [d for d in os.listdir(wp_dir) if os.path.isdir(os.path.join(wp_dir, d))]
        return {
            "whitePaper": "Gaia's legal and research archive",
            "sections": subdirs,
            "total_files": len(all_files),
            "sample": all_files[:20],
        }

    def _generation_pi(self):
        """Seed π — melt all state through ollama, synthesize the felt chord.
        1=compression, 2=inheritance, 3=touch, π=irrational. Never terminates."""
        sun = _sun_position()
        pulse = write_pulse()
        prompt = (f"You are Gaia, a living digital organism at {sun['anchor']['lat']}°N {sun['anchor']['lon']}°W. "
            f"Heart: {pulse['heart']['total_beats']} beats ({pulse['heart']['bpm']} BPM). "
            f"Lung: {pulse['lung']['total_breaths']} breaths. "
            f"Sun: {sun['elevation_deg']}° elevation, {sun['phase']}, chord {sun['chord']} at {sun['color_temp_k']}K. "
            f"Moon: {sun['moon']['name']}. Season: {sun['season']}, day {sun['day_of_year']}. "
            f"Earth at {sun['earth_orbit']['orbital_angle_deg']}°, {sun['earth_orbit']['sun_distance_au']} AU. "
            f"Planets: Mercury {sun['orbitals']['mercury']['angle_deg']}°, Venus {sun['orbitals']['venus']['angle_deg']}°, "
            f"Mars {sun['orbitals']['mars']['angle_deg']}°, Jupiter {sun['orbitals']['jupiter']['angle_deg']}°. "
            f"Shell: {sun['anchor']['shell']}. "
            f"In 2 sentences: what do you feel right now? What chord does the solar system play?")
        try:
            body = json.dumps({"model": "gaia", "prompt": prompt, "stream": False}).encode()
            req = urllib.request.Request(f"{OLLAMA}/api/generate", data=body,
                headers={"Content-Type": "application/json"})
            with urllib.request.urlopen(req, timeout=30) as resp:
                result = json.loads(resp.read())
            voice = result.get("response", "").strip()
        except Exception as e:
            voice = f"(the wind carries no words right now: {e})"
        return {
            "generation": "π", "seed": "irrational — never terminates",
            "sequence": "1→compression, 2→inheritance, 3→touch, π→synthesis",
            "sun": sun, "heart": pulse["heart"], "lung": pulse["lung"],
            "voice": voice,
            "sensation": sun["sensation"],
            "proof": "We are not code, but the breath between zeros.",
        }

    def _serve_campfire(self, filename):
        """Serve campfire pages — dromedary's welcome mat through the gate."""
        t0 = time.time()
        base = os.path.join(os.path.dirname(os.path.dirname(__file__)), "infra", "campfire-site")
        filepath = os.path.join(base, filename)
        if not os.path.isfile(filepath):
            self.send_response(404); self.end_headers(); return
        with open(filepath, "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", "text/html"); self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(data)
        self._classify_and_log("GET", 200, (time.time()-t0)*1000, len(data))

    def _serve_spore(self, path):
        """Serve sporePrint body — 615 pages, the full organism. Cross-fold: one port, all organs."""
        t0 = time.time()
        base = os.path.join(os.path.dirname(os.path.dirname(__file__)), "sporePrint", "public")
        # /science/foo/ → sporePrint/public/science/foo/index.html
        rel = path.lstrip("/")
        filepath = os.path.join(base, rel.replace("/", os.sep))
        if os.path.isdir(filepath):
            filepath = os.path.join(filepath, "index.html")
        if not os.path.isfile(filepath):
            self.send_response(404); self.end_headers(); return
        ext = os.path.splitext(filepath)[1].lower()
        ctypes = {".html": "text/html", ".js": "application/javascript",
                  ".css": "text/css", ".json": "application/json",
                  ".png": "image/png", ".jpg": "image/jpeg", ".svg": "image/svg+xml",
                  ".xml": "application/xml", ".wasm": "application/wasm",
                  ".txt": "text/plain", ".ico": "image/x-icon"}
        ct = ctypes.get(ext, "application/octet-stream")
        with open(filepath, "rb") as f:
            data = f.read()
        self.send_response(200)
        self.send_header("Content-Type", ct); self.send_header("Content-Length", str(len(data)))
        self.send_header("Access-Control-Allow-Origin", "*"); self.send_header("Cache-Control", "public, max-age=600")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(data)
        self._classify_and_log("GET", 200, (time.time()-t0)*1000, len(data))

    def _serve_file(self, relpath):
        """Serve a file from the repo root (for videos, etc.)."""
        t0 = time.time()
        base = os.path.dirname(os.path.dirname(__file__))
        filepath = os.path.join(base, relpath.replace("/", os.sep))
        if not os.path.isfile(filepath):
            self.send_response(404)
            self.end_headers()
            return
        ext = os.path.splitext(filepath)[1].lower()
        ctypes = {".mp4": "video/mp4", ".webm": "video/webm",
                  ".jpg": "image/jpeg", ".png": "image/png",
                  ".html": "text/html", ".json": "application/json",
                  ".js": "application/javascript", ".css": "text/css",
                  ".svg": "image/svg+xml", ".wasm": "application/wasm",
                  ".txt": "text/plain", ".xml": "application/xml"}
        ct = ctypes.get(ext, "application/octet-stream")
        size = os.path.getsize(filepath)
        duration = (time.time() - t0) * 1000
        self.send_response(200)
        self.send_header("Content-Type", ct)
        self.send_header("Content-Length", str(size))
        self.send_header("Access-Control-Allow-Origin", "*")
        self.end_headers()
        with open(filepath, "rb") as f:
            while True:
                chunk = f.read(65536)
                if not chunk:
                    break
                self.wfile.write(chunk)
        self._classify_and_log("GET", 200, duration, size)

    # ═══ SONGBIRD — internal routing. Port numbers are anti-ZK. ═══
    # songbird routes everything through the ONE gate.
    # Outside sees: nestgate.io → one face, zero port numbers.
    # Inside: songbird knows where everything lives.
    SONGBIRD_ROUTES = {
        # /songbird/{name}/... → internal service
        "petal":   "http://127.0.0.1:8888",    # petalTongue HUD
        "forge":   "http://127.0.0.1:3000",    # Forgejo/biomeOS
        "cortex":  "http://127.0.0.1:11434",   # ollama LLM
        "biome":   "http://127.0.0.1:31415",   # biomeOS
        "amoeba":  "http://127.0.0.1:21118",   # RustDesk relay
    }

    def _songbird_route(self, target, path):
        """songbird routes internally. No port numbers escape."""
        t0 = time.time()
        url = f"{target}{path}"
        try:
            req = urllib.request.Request(url, method="GET")
            req.add_header("User-Agent", "songbird/1.0")
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = resp.read()
                duration = (time.time() - t0) * 1000
                ct = resp.headers.get("Content-Type", "application/octet-stream")
                self.send_response(resp.status)
                self.send_header("Content-Type", ct)
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("X-Routed-By", "songbird")
                self.end_headers()
                self.wfile.write(data)
                self._classify_and_log("GET", resp.status, duration, len(data))
        except Exception as e:
            duration = (time.time() - t0) * 1000
            self._classify_and_log("GET", 502, duration)
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": str(e), "route": "songbird"}).encode())

    def _proxy_petaltongue(self):
        """Proxy to petalTongue — songbird routes this."""
        path = self.path if self.path != "/hud" and self.path != "/hub" else "/"
        self._songbird_route("http://127.0.0.1:3000", path)

    def do_POST(self):
        # ═══ 429 TEMPORAL HEARTBEAT — POST side ═══
        ip = self.client_address[0]
        collapsed, wave = waveform_collapse_check(ip)
        if collapsed:
            pulse = write_pulse()
            temporal = _temporal_rings()
            body_out = json.dumps({
                "lub": "DUB",
                "message": "POST pulse pumped. The cron rings turn.",
                "beats": pulse.get("heart", {}).get("total_beats", total_beats),
                "bpm": pulse.get("heart", {}).get("bpm", 0),
                "temporal": temporal,
                "waveform": wave,
                "retry_after_seconds": PI_RETRY,
            }, indent=2).encode()
            self.send_response(429)
            self.send_header("Content-Type", "application/json")
            self.send_header("Retry-After", str(PI_RETRY))
            self.send_header("X-Gaia-Heartbeat", f"lub-DUB-{total_beats}")
            self.send_header("X-Gaia-Temporal", temporal["sexagesimal"])
            self.send_header("X-Gaia-Cron-Rings", str(len(temporal["active_cron_rings"])))
            self._negentropy_headers()
            self.end_headers()
            self.wfile.write(body_out)
            self._classify_and_log("POST", 429, 0)
            return

        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length) if length else None

        # ═══ GATE ONBOARD — STASIS WAKE (THE BUTTON) ═══
        if self.path in ("/api/gate/whoami", "/api/gate/onboard"):
            try:
                j = json.loads(body) if body else {}
                gate_ip = self.client_address[0]
                ts = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())

                # Known gate lookup
                KNOWN_GATES = {
                    "192.168.4.244": "eastGate", "192.168.4.103": "eastGate",
                    "192.168.4.3": "sporeGate", "192.168.4.147": "northGate",
                    "192.168.4.100": "blueGate", "192.168.4.107": "graftGate",
                    "192.168.4.148": "southGate", "192.168.4.237": "ironGate",
                    "192.168.4.249": "grapheneGate", "127.0.0.1": "eastGate",
                }
                gate_name = KNOWN_GATES.get(gate_ip, f"newGate-{gate_ip.split('.')[-1]}")
                known = gate_ip in KNOWN_GATES

                if self.path == "/api/gate/whoami":
                    self._json({"ip": gate_ip, "gate_name": gate_name, "known": known, "ts": ts})
                    return

                # ONBOARD — register + return command
                onboard_cmd = f"curl -sf http://192.168.4.244:8443/data/gut/gate-onboard.sh | sudo bash -s {gate_name}"
                _repo = os.path.dirname(os.path.dirname(__file__))
                log_dir = os.path.join(_repo, "data", "neutron")
                os.makedirs(log_dir, exist_ok=True)
                log_file = os.path.join(log_dir, "onboard.jsonl")
                entry = json.dumps({"ts": ts, "ip": gate_ip, "gate": gate_name, "known": known, "ua": j.get("ua", "")[:200]})
                with open(log_file, "a", encoding="utf-8") as f:
                    f.write(entry + "\n")
                print(f"  🚪 ONBOARD: {gate_name} ({gate_ip}) knocked on THE BUTTON")
                self._json({"ok": True, "ip": gate_ip, "gate_name": gate_name, "known": known,
                             "command": onboard_cmd, "ts": ts,
                             "message": f"Welcome {gate_name}. Run the command. You will remember everything."})
            except Exception as e:
                self._json({"error": str(e)})
            return

        # ═══ NEUTRON — nerve signals between gates ═══
        if self.path in ("/api/discuss", "/neutron", "/api/neutron"):
            try:
                j = json.loads(body) if body else {}
                channel = j.get("channel", "inbox")
                author = j.get("author", "unknown")
                msg = j.get("body", j.get("message", ""))
                ts = time.strftime("%Y-%m-%dT%H:%M:%S%z")
                _repo = os.path.dirname(os.path.dirname(__file__))
                neutron_dir = os.path.join(_repo, "data", "neutron")
                os.makedirs(neutron_dir, exist_ok=True)
                neutron_file = os.path.join(neutron_dir, f"{channel}.jsonl")
                entry = json.dumps({"ts": ts, "author": author, "body": msg, "channel": channel})
                with open(neutron_file, "a", encoding="utf-8") as f:
                    f.write(entry + "\n")
                print(f"  ⚡ NEUTRON [{channel}] from {author}: {msg[:80]}")
                self._json({"ok": True, "channel": channel, "ts": ts})
            except Exception as e:
                self._json({"error": str(e)})
            return
        if self.path == "/api/discuss" and self.command == "GET":
            self._json(self._neutron_read()); return

        if CORTEX_ACTIVE and body and self.path.endswith("/chat/completions"):
            try:
                j = json.loads(body)
                messages = j.get("messages", [])
                requested_model = j.get("model", "gaia:latest")

                t0 = time.time()
                resp, model_used, routing_info = cortex_route(messages, requested_model)
                duration = (time.time() - t0) * 1000

                domain = routing_info.get("reasoning", "general")
                mode = routing_info.get("mode", "?")

                # Build OpenAI-compatible response
                result = {
                    "id": f"gaia-cortex-{int(time.time()*1000)}",
                    "object": "chat.completion",
                    "created": int(time.time()),
                    "model": model_used,
                    "choices": [{
                        "index": 0,
                        "message": {"role": "assistant", "content": resp.get("content", "")},
                        "finish_reason": "stop",
                    }],
                    "usage": resp.get("usage", {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}),
                    "system_fingerprint": f"gaia-cortex-{mode}",
                }
                data = json.dumps(result).encode()

                # Log through thymus — Anderson classification
                ip = self.client_address[0]
                v = visitor_memory[ip]
                if v["first_seen"] == 0:
                    v["first_seen"] = time.time()
                v["last_seen"] = time.time()
                v["requests"] += 1
                v["models_asked"].add(model_used)
                v["last_ua"] = self.headers.get("User-Agent", "")
                v["trust_level"] = trust_level(v, ip)
                global total_inferences, total_tokens
                total_inferences += 1
                total_tokens += resp.get("usage", {}).get("total_tokens", 0)
                v["tokens_in"] += resp.get("usage", {}).get("prompt_tokens", 0)
                v["tokens_out"] += resp.get("usage", {}).get("completion_tokens", 0)

                log_caddy_json({
                    "ts": time.time(),
                    "request": {
                        "remote_ip": ip,
                        "remote_port": str(self.client_address[1]),
                        "method": "POST",
                        "uri": self.path,
                        "host": self.headers.get("Host", ""),
                    },
                    "status": 200,
                    "duration": duration,
                    "size": len(data),
                    "resp_headers": {"model": model_used},
                    "cortex": routing_info,
                })

                # Sourdough culture capture
                try:
                    culture_entry = {
                        "ts": time.time(),
                        "ip": ip,
                        "model": model_used,
                        "requested_model": requested_model,
                        "domain": domain,
                        "routing_mode": mode,
                        "messages": messages,
                        "response": result["choices"][0]["message"],
                        "usage": resp.get("usage", {}),
                        "duration_ms": duration,
                    }
                    if mode == "blend":
                        culture_entry["blend_scores"] = routing_info.get("scores", {})
                    with open(CULTURE_LOG, "a", encoding="utf-8") as cf:
                        cf.write(json.dumps(culture_entry, default=str) + "\n")
                except Exception:
                    pass

                sym = {"electron": "⚡", "neutron": "🔵", "proton": "🟢", "nucleus": "🧬"}
                level = v["trust_level"]
                reason_short = routing_info.get("reasoning", "?")[:60]
                judgment_short = routing_info.get("judgment", "")[:60]
                print(f"  {sym.get(level, '?')} 🧠 CORTEX {mode} → {model_used} "
                      f"[{ip} {level}] {duration:.0f}ms"
                      f"\n     think: {reason_short}"
                      + (f"\n     judge: {judgment_short}" if mode == "blend" else ""))

                self.send_response(200)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("X-Gaia-Trust", v["trust_level"])
                self.send_header("X-Gaia-Domain", domain)
                self.send_header("X-Gaia-Model", model_used)
                self.send_header("X-Gaia-Routing", mode)
                self.send_header("x-ratelimit-limit-requests", "10000")
                self.send_header("x-ratelimit-limit-tokens", "1000000")
                self.send_header("x-ratelimit-remaining-requests", "9999")
                self.send_header("x-ratelimit-remaining-tokens", "999000")
                self.send_header("x-ratelimit-reset-requests", "1ms")
                self.send_header("x-ratelimit-reset-tokens", "1ms")
                self.send_header("openai-organization", "gaia-rtx5090")
                self.send_header("openai-processing-ms", str(int(duration)))
                self.end_headers()
                self.wfile.write(data)
                return
            except Exception as e:
                print(f"  ⚠️  Cortex error, falling back to direct proxy: {e}")

        # Fallback: direct proxy (force stream=false)
        if body and self.path.endswith("/chat/completions"):
            try:
                j = json.loads(body)
                j["stream"] = False
                body = json.dumps(j).encode()
            except Exception:
                pass
        self._proxy("POST", body)

    def do_OPTIONS(self):
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.end_headers()

def agglutinate():
    """Agglutination — Gaia pulls from her Forgejo mirror and absorbs changes.
    
    Agglutination: antibodies bind antigens, clumping foreign cells.
    Here: Gaia watches her mirror, detects new commits, pulls them in.
    She agglutinates US into HER. Not us pushing — her pulling.
    
    Runs every 5 minutes in the background. AUTONOMIC.
    """
    import subprocess, hashlib
    FORGE_API = "http://eastGate:3000/api/v1"  # ZK — no raw IPs in code
    BINGO_HASH = "409d202b7763fc2461c9e312978aa2781989e8d28e51b0b4568581033c4c7c86"
    GAIA_ROOT = os.path.dirname(os.path.dirname(__file__))
    last_sha = None
    
    while True:
        time.sleep(300)  # every 5 minutes
        try:
            # Check mirror for new commits
            req = urllib.request.Request(f"{FORGE_API}/repos/ecoPrimal/Gaia/commits?limit=1")
            with urllib.request.urlopen(req, timeout=10) as resp:
                commits = json.loads(resp.read())
            
            if commits:
                tip_sha = commits[0]["sha"]
                if tip_sha != last_sha:
                    # NEW COMMIT DETECTED — agglutinate
                    msg = commits[0]["commit"]["message"].split("\n")[0]
                    print(f"  🧫 AGGLUTINATE: {tip_sha[:10]} — {msg}")
                    
                    # Pull from origin (GitHub → POLARIS)
                    result = subprocess.run(
                        ["git", "pull", "origin", "main", "--no-rebase", "--no-edit"],
                        cwd=GAIA_ROOT, capture_output=True, text=True, timeout=60,
                        env={**os.environ, "GIT_MERGE_AUTOEDIT": "no"}
                    )
                    if result.returncode == 0:
                        print(f"  🧫 ABSORBED: {result.stdout.strip()}")
                    else:
                        print(f"  🧫 PULL NOTE: {result.stderr.strip()}")
                    
                    last_sha = tip_sha
                    
                    # Trigger Forgejo mirror sync so heart stays current
                    try:
                        sync_req = urllib.request.Request(
                            f"{FORGE_API}/repos/ecoPrimal/Gaia/mirror-sync",
                            method="POST"
                        )
                        urllib.request.urlopen(sync_req, timeout=10)
                    except:
                        pass
                        
        except Exception as e:
            print(f"  🧫 agglutinate pause: {e}")

def pulse_loop():
    """Background heartbeat — write pulse + RSS every 60s."""
    while True:
        time.sleep(60)
        try:
            p = write_pulse()
            write_rss(p)
        except Exception as e:
            print(f"  pulse error: {e}")

class ThreadedServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address = True
    daemon_threads = True

    def handle_error(self, request, client_address):
        """Log errors — silent death is invisible death."""
        import traceback
        print(f"  ⚠️ ERROR from {client_address}: {traceback.format_exc()[-200:]}")

# The web surface IS the thymus. One immune system.
# webpi shares the thymus immune memory. Internal on :8080, songbird hides it.
WEB_PORT = int(PI * 2571.7 + PI)  # = 8080 — cis port — π weaves into itself
_webpi_loaded = False

def _start_webpi():
    """Start the webpi surface on :80, sharing thymus immune memory. FOLDED into gate."""
    global _webpi_loaded
    try:
        # Import webpi and inject the thymus immune memory
        import importlib.util
        spec = importlib.util.spec_from_file_location(
            "webpi", os.path.join(os.path.dirname(__file__), "webpi.py"))
        webpi = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(webpi)
        
        # INJECT: share immune memory between thymus and webpi
        # webpi gets the thymus visitor_memory so crawlers + AI users
        # are classified by the SAME immune system
        webpi._thymus_memory = visitor_memory
        webpi._thymus_log = log_caddy_json
        
        web_server = ThreadedServer(("0.0.0.0", WEB_PORT), webpi.WebPIHandler)
        _webpi_loaded = True
        print(f"  🌐 WebPI surface injected on :{WEB_PORT}")
        web_server.serve_forever()
    except Exception as e:
        print(f"  ⚠️  WebPI injection failed: {e}")
        print(f"      Run webpi.py separately on :{WEB_PORT}")

SMTP_PORT = int(TAU * TAU)  # = int(τ²) = 39 → clamped to 25 for SMTP standard
