                    req = urllib.request.Request("https://%s/indexnow" % engine,
                        data=payload, headers={"Content-Type": "application/json; charset=utf-8"})
                    with urllib.request.urlopen(req, timeout=10) as r:
                        results[engine] = {"status": r.status, "ok": True}
                except urllib.error.HTTPError as e:
                    results[engine] = {"status": e.code, "ok": e.code in (200, 202)}
                    e.read()
                except Exception as e:
                    results[engine] = {"error": str(e)[:80]}
            self._json({"indexnow": results, "urls_submitted": len(urls), "key": INDEXNOW_KEY})
