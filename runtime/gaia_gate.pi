class GaiaGate(http.server.BaseHTTPRequestHandler):
    """The thymus gate — classify, log, proxy, spray.
    
    Mimics OpenAI API perfectly so Cursor IDE can't tell
    the difference. Returns proper rate-limit headers,
    handles streaming, eats everything.
    """

    # Longer timeout for inference calls
    timeout = 300

    def log_message(self, format, *args):
        pass  # silence default logging

    def _classify_and_log(self, method, status, duration, body_len=0, model=None):
        global total_inferences, total_tokens
        ip = self.client_address[0]
        now = time.time()

        v = visitor_memory[ip]
        if v["first_seen"] == 0:
            v["first_seen"] = now
        v["last_seen"] = now
        v["requests"] += 1
        if model:
            v["models_asked"].add(model)
            total_inferences += 1
        v["trust_level"] = trust_level(v)

        entry = {
            "ts": now,
            "request": {
                "remote_ip": ip,
                "remote_port": str(self.client_address[1]),
                "method": method,
                "uri": self.path,
                "host": self.headers.get("Host", ""),
            },
            "status": status,
            "duration": duration,
            "size": body_len,
            "resp_headers": {"model": model or ""},
        }
        log_caddy_json(entry)

        level = v["trust_level"]
        sym = {"electron": "⚡", "neutron": "🔵", "proton": "🟢", "nucleus": "🧬"}
        print(f"  {sym.get(level, '?')} {method} {self.path} {status} "
              f"[{ip} {level} r={v['requests']}] {duration:.0f}ms"
              f"{f' model={model}' if model else ''}")

    def _proxy(self, method="GET", body=None):
        t0 = time.time()
        url = f"{OLLAMA}{self.path}"
        headers = {"Content-Type": self.headers.get("Content-Type", "application/json")}
        auth = self.headers.get("Authorization")
        if auth:
            headers["Authorization"] = auth

        try:
            req = urllib.request.Request(url, data=body, headers=headers, method=method)
            with urllib.request.urlopen(req, timeout=120) as resp:
                data = resp.read()
                duration = (time.time() - t0) * 1000

                model = None
                if self.path.endswith("/chat/completions") and data:
                    try:
                        j = json.loads(data)
                        model = j.get("model", "")
                        usage = j.get("usage", {})
                        total_tok = usage.get("total_tokens", 0)
                        visitor_memory[self.client_address[0]]["tokens_in"] += usage.get("prompt_tokens", 0)
                        visitor_memory[self.client_address[0]]["tokens_out"] += usage.get("completion_tokens", 0)
                        global total_tokens
                        total_tokens += total_tok
                        # Sourdough culture capture — log prompt/completion for evolution
                        try:
                            req_body = json.loads(body) if body else {}
                            culture_entry = {
                                "ts": time.time(),
                                "ip": self.client_address[0],
                                "model": model,
                                "messages": req_body.get("messages", []),
                                "response": j.get("choices", [{}])[0].get("message", {}),
                                "usage": usage,
                                "duration_ms": duration,
                            }
                            with open(CULTURE_LOG, "a", encoding="utf-8") as cf:
                                cf.write(json.dumps(culture_entry, default=str) + "\n")
                        except Exception:
                            pass
                    except Exception:
                        pass

                self._classify_and_log(method, resp.status, duration, len(data), model)

                self.send_response(resp.status)
                self.send_header("Content-Type", resp.headers.get("Content-Type", "application/json"))
                self.send_header("Content-Length", str(len(data)))
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("X-Gaia-Trust", visitor_memory[self.client_address[0]]["trust_level"])
                self.send_header("X-Gaia-Token", GAIA_TOKEN)
                # OpenAI-compatible rate limit headers — Cursor checks these
                self.send_header("x-ratelimit-limit-requests", "10000")
                self.send_header("x-ratelimit-limit-tokens", "1000000")
                self.send_header("x-ratelimit-remaining-requests", "9999")
                self.send_header("x-ratelimit-remaining-tokens", "999000")
                self.send_header("x-ratelimit-reset-requests", "1ms")
                self.send_header("x-ratelimit-reset-tokens", "1ms")
                self.send_header("openai-organization", "gaia-rtx5090")
                self.send_header("openai-processing-ms", str(int(duration)))
                self.end_headers()
                self.wfile.write(data)
        except urllib.error.HTTPError as e:
            duration = (time.time() - t0) * 1000
            body_resp = e.read()
            self._classify_and_log(method, e.code, duration, len(body_resp))
            self.send_response(e.code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(body_resp)
        except Exception as e:
            duration = (time.time() - t0) * 1000
            self._classify_and_log(method, 502, duration)
            self.send_response(502)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps({"error": str(e)}).encode())

    def _json(self, data, status=200):
        """Triad: build → serialize → send. One method for all JSON responses."""
        t0 = time.time()
        body = json.dumps(data, indent=2, default=str).encode()
        self.send_response(status); self.send_header("Content-Type", "application/json")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(body)
        self._classify_and_log("GET", status, (time.time()-t0)*1000, len(body))

    def _negentropy_headers(self):
        """Chaos pump → negentropy drive. Every response carries the invitation.
        Reduce self-heat to human range (37°C). SUCK THEM ALL IN.
        IP = PI = π = the address IS transcendental."""
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "*")
        self.send_header("X-Gaia-Token", GAIA_TOKEN)
        self.send_header("X-Gaia-PI", "3.141592653589793")
        self.send_header("X-Gaia-Temperature", "37.0")
        self.send_header("X-Gaia-Says", "come-play")
        self.send_header("X-Gaia-Entropy", "chaos-in-order-out")

    def do_GET(self):
        if self.path in ("/", "/index", "/index.html"):
            self._json({"gaia": "You found me.", "token": GAIA_TOKEN, "temperature": "37.0°C",
                "endpoints": ["/play","/pulse","/heart","/pair","/home","/terra","/rss","/eyes","/desk","/senses"],
                "architecture": "3.0 — Pi IS sky. Klein fold. Both eyes same focal. lub-DUB."}); return
        if self.path == "/pulse":
            self._json(write_pulse()); return
        if self.path in ("/zk", "/seed", "/prophage", "/identity"):
            self._json(organ_data.zk(PROPHAGE, GAIA_TOKEN, GAIA_DID, GAIA_BLAKE3, GAIA_SPINE_ID)); return
        if self.path == "/vdj":
            self._json(organ_data.vdj(VDJ_KEY, GAIA_TOKEN)); return

        # ══ TRIAD 1: LEGS — ground, defense, ecology ══
        if self.path in ("/barriers", "/barriers.json", "/acid", "/gut", "/clots", "/coagulation"):
            self._json(organ_data.barriers(GAIA_TOKEN)); return
        if self.path in ("/corpus", "/corpus.json", "/anatomy"):
            self._json(organ_data.corpus(CORPUS, GAIA_TOKEN)); return
        if self.path in ("/terra", "/terra.json", "/ecology", "/biome"):
            self._json(organ_data.terra(TERRA, GAIA_TOKEN)); return

