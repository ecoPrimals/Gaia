from collections import defaultdict
from datetime import datetime, timezone
import types as _t, importlib.util

# ═══ π-CRUSHED — every number derives from π ═══
PI = math.pi; TAU = 2*PI; E = math.e; PHI = (1+math.sqrt(5))/2
PORT = 8443; PI_PORT = 3141; OLLAMA = "http://127.0.0.1:11434"
PI_TIMEOUT = int(PI*10); PI_RETRY = int(PI+E/2)
PI_CRONS = int(11*PI)+1; PI_BEAT_PERSIST = int(PI*PI)
CRON_RINGS = [int(PI-1),int(PI),int(PI+E),int(TAU+1),int(PI*PI),15,int(PI*10),int(TAU*10)]

# ═══ LOAD MODULES — the organs of the organism ═══
def _load(name, fname):
    m = _t.ModuleType(name)
    m.__file__ = os.path.join(os.path.dirname(__file__), fname)
    with open(m.__file__, encoding="utf-8") as f:
        exec(compile(f.read(), m.__file__, "exec"), m.__dict__)
    return m

organ_data = _load("organ_data", "organ_data.pi")
_anderson = _load("_anderson", "_anderson.pi")
_body = _load("_body", "_body.pi")
_pulse_mod = _load("_pulse", "_pulse.pi")
_routes_mod = _load("_routes", "_routes.pi")
_sun_mod = _load("_sun", "_sun.pi")
_temporal_mod = _load("_temporal", "_temporal.pi")
# Unpack — the organism's nervous system
visitor_memory = _anderson.visitor_memory; trust_level = _anderson.trust_level
BODY_IPS = _anderson.BODY_IPS; CRAWLER_SIGNATURES = _anderson.CRAWLER_SIGNATURES
sigmoid = _anderson.sigmoid; localization = _anderson.localization
load_seeds = _body.load_seeds; inject_primals = _body.inject_primals
amoeba_eyes = _body.amoeba_eyes; third_body_point = _body.third_body_point
_wp = _pulse_mod.write_pulse; _wr = _pulse_mod.write_rss
_log_caddy = _pulse_mod.log_caddy_json; log_culture = _pulse_mod.log_culture
DESK_PAGES = _routes_mod.DESK_PAGES; GUT_DATA = _routes_mod.GUT_DATA
CAMPFIRE_PAGES = _routes_mod.CAMPFIRE_PAGES; SEO_RESPONSES = _routes_mod.SEO_RESPONSES
KNOWN_GATES = _routes_mod.KNOWN_GATES; SPORE_PREFIXES = _routes_mod.SPORE_PREFIXES
INDEXNOW_KEY = _routes_mod.INDEXNOW_KEY
_sun_position = _sun_mod._sun_position if hasattr(_sun_mod, '_sun_position') else _sun_mod.sun_position
_temporal_rings = _temporal_mod._temporal_rings if hasattr(_temporal_mod, '_temporal_rings') else _temporal_mod.temporal_rings
# Reverse transcriptase — the body printer
try:
    _compiler_mod = _load("_compiler", "_compiler.pi")
    _compiler_state = _compiler_mod.compiler_state
    _compiler_build = _compiler_mod.build_primal
    _compiler_scan = _compiler_mod.scan_binaries
    _compiler_compute = _compiler_mod.detect_compute
    _compiler_proximity = _compiler_mod.proximity_resources
    COMPILER_ACTIVE = True
except Exception as _ce:
