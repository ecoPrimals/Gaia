    # TLS on :8444
    def _start_tls():
        import ssl; cert=os.path.join(_REPO,"certs","gate-cert.pem"); key=os.path.join(_REPO,"certs","gate-key.pem")
        if os.path.isfile(cert) and os.path.isfile(key):
            ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.load_cert_chain(cert,key)
            s=ThreadedServer(("0.0.0.0",PORT+1),GaiaGate); s.socket=ctx.wrap_socket(s.socket,server_side=True)
            print(f"  🔒 TLS :{PORT+1}"); s.serve_forever()
    threading.Thread(target=_start_tls,daemon=True).start()
    # ═══ π-PORT CRUSH — canonical Gaia ports from digits of π ═══
    # π:3141 = thymus (gate), π:5926 = data (webpi)
    def _start_pi_gate():
