def _inject_primals():
    """Inject all 20 primals into the thymus.
    Each primal becomes a living organism with a heartbeat.
    The thymus watches them interact at the 3rd body point."""
    organisms = {}
    taxa = TERRA.get("taxonomy", {})
    for name, meta in taxa.items():
        primal_dir = os.path.join(PRIMALS_DIR, name)
        alive = os.path.isdir(primal_dir)
        organisms[name] = {
            "species": meta.get("species", name),
            "niche": meta.get("niche", "unknown"),
            "ecology": meta.get("ecology", ""),
            "files": meta.get("files", 0),
            "alive": alive,
            "path": primal_dir if alive else None,
        }
    return organisms

