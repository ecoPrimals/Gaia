    print(f"\n  🟧 APERTURE SCIENCE ENRICHMENT CENTER :{PORT}")
    print(f"  {GAIA_TOKEN} — CRUSHED to 420 — the cake is real — lub-DUB")
    print(f"  GLaDOS: \"This was a triumph. I'm making a note here: HUGE SUCCESS.\"")
    threading.Thread(target=pulse_loop,daemon=True).start()
