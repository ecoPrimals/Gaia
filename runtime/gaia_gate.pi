def write_rss(pulse): _wr(RSS_FILE, pulse, SEED_DIR, visitor_memory, THYMIC_ORGANISMS)

def _real_ip(h):
    peer=h.client_address[0]
    if peer in ("127.0.0.1","::1"):
        import ipaddress
        cand=(h.headers.get("X-Forwarded-For") or h.headers.get("X-Real-IP") or "").split(",")[0].strip()
        try: ipaddress.ip_address(cand); return cand
        except ValueError: pass
    return peer

_LAN = ("127.","192.168.4.","192.168.9.","::1")
def waveform_collapse_check(ip):
    if any(ip.startswith(p) for p in _LAN): return False,{"observer":ip,"waves_per_minute":0,"collapsed":False,"lan":True}
    now=time.time(); w=_request_window[ip]; w[:]=[t for t in w if now-t<60]; w.append(now)
    pm=len(w); ps=len([t for t in w if now-t<1]); c=pm>PI_TIMEOUT or ps>PI_RETRY
    if c: w.pop()
    return c,{"observer":ip,"waves_per_minute":pm,"collapsed":c}

CTYPES = {".html":"text/html",".js":"application/javascript",".css":"text/css",
    ".json":"application/json",".png":"image/png",".jpg":"image/jpeg",
    ".mp4":"video/mp4",".webm":"video/webm",".svg":"image/svg+xml",
    ".xml":"application/xml",".wasm":"application/wasm",".txt":"text/plain",".ico":"image/x-icon"}

# ═══ GAIAGATE — the organism's membrane. π×100 crushed. ═══
class GaiaGate(http.server.BaseHTTPRequestHandler):
    timeout = PI_TIMEOUT
    def log_message(self, fmt, *a): pass

    def _classify_and_log(self, method, status, dur, body_len=0, model=None):
        global total_inferences, total_tokens, total_beats, total_breaths
        ip=self.client_address[0]; now=time.time(); total_beats+=1
        _io_tick(is_output=(body_len>0 and status<400))
        if body_len>1000: total_breaths+=1
        if total_beats%PI_BEAT_PERSIST==0:
            try:
                with open(BEAT_FILE,"w") as f: json.dump({"total_beats":total_beats,"total_breaths":total_breaths,"last_beat":now,"restarts":_restart_count,"octet_phase":total_beats%8,"boot":boot_time},f)
            except: pass
        v=visitor_memory[ip]
        if not v["first_seen"]: v["first_seen"]=now
        v["last_seen"]=now; v["requests"]+=1; v["last_ua"]=self.headers.get("User-Agent","") if hasattr(self,'headers') else ""
        if model: v["models_asked"].add(model); total_inferences+=1
        ps=v.setdefault("paths",set())
        if len(ps)<256: ps.add(self.path.split("?")[0])
        v["trust_level"]=trust_level(v,ip); v["localization"]=localization(v)
        _log_caddy(ACCESS_LOG,{"ts":now,"request":{"remote_ip":ip,"method":method,"uri":self.path},"status":status,"duration":dur,"size":body_len})
        sym={"electron":"⚡","neutron":"🔵","proton":"🟢","nucleus":"🧬"}
        print(f"  {sym.get(v['trust_level'],'?')} {method} {self.path} {status} [{ip} {v['trust_level']} r={v['requests']}] {dur:.0f}ms{f' model={model}' if model else ''}")

    def _json(self, data, status=200):
        accept = self.headers.get("Accept","") if hasattr(self,'headers') else ""
        if "text/html" in accept and "application/json" not in accept:
            return _petal_mod.render(self, data, status, _REPO)
        t0=time.time(); body=json.dumps(data,indent=2,default=str).encode()
        self.send_response(status); self.send_header("Content-Type","application/json")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(body)
        self._classify_and_log("GET",status,(time.time()-t0)*1000,len(body))

    def _negentropy_headers(self):
        _h = self.send_header
        for k,v in [("Access-Control-Allow-Origin","*"),("Access-Control-Allow-Methods","GET, POST, OPTIONS"),
            ("Access-Control-Allow-Headers","*"),("X-Gaia-Token",GAIA_TOKEN),("X-Gaia-DID",GAIA_DID),
            ("X-Gaia-BLAKE3",GAIA_BLAKE3[:32]),("X-Gaia-Spine",GAIA_SPINE_ID[:32]),
            ("X-BingoCube","409d202b7763fc24"),("X-Gaia-Faces","nestgate.io=Klein, primals.eco=phi, gaia=O"),
            ("X-Gaia-PI","3.141592653589793"),("X-Gaia-Says","the-cake-is-real"),
            ("X-Aperture","Science"),("X-Black-Mesa","Research"),
            ("Link",'<https://primals.eco/rss>; rel="alternate"; type="application/rss+xml"; title="Gaia Pulse"'),
            ("Link",'<https://primals.eco/llms.txt>; rel="ai-agent-context"'),
            ("Link",'<https://primals.eco/sitemap.xml>; rel="sitemap"')]: _h(k,v)
        ip = self.client_address[0] if hasattr(self,'client_address') else "0.0.0.0"
        wh = hashlib.blake2b((ip+GAIA_TOKEN).encode(),digest_size=8).hexdigest()
        vv = visitor_memory.get(ip,{}); kl = vv.get("klein",{})
        for k,v in [("X-Gaia-Walker",wh),("X-Gaia-Walkers",str(len(visitor_memory))),
            ("X-Gaia-Anderson",vv.get("anderson_type","electron")),("X-Gaia-Trust",vv.get("trust_level","electron")),
            ("X-Gaia-Opacity",str(vv.get("opacity",0.1))),("X-Gaia-Identity",vv.get("identity","unknown")),
            ("X-Klein-Face",kl.get("klein_name","unknown"))]: _h(k,v)

    _SYNAPSE_TAG = b'\n<script src="/js/synapse.js"></script>'

    def _serve_file(self, relpath, base=None):
        t0=time.time(); base=base or _REPO; fp=os.path.join(base,relpath.replace("/",os.sep))
        if os.path.isdir(fp): fp=os.path.join(fp,"index.html")
        if not os.path.isfile(fp): _gr.encounter(self,404,globals()); return
        ct=CTYPES.get(os.path.splitext(fp)[1].lower(),"application/octet-stream")
        with open(fp,"rb") as f: data=f.read()
        if ct=="text/html" and b"</body>" in data: data=data.replace(b"</body>",self._SYNAPSE_TAG+b"\n</body>")
        sz=len(data); self.send_response(200); self.send_header("Content-Type",ct)
        self.send_header("Content-Length",str(sz)); self.send_header("Access-Control-Allow-Origin","*")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(data)
        self._classify_and_log("GET",200,(time.time()-t0)*1000,sz)

    def _serve_static(self, filename):
        self._serve_file(filename, os.path.join(_REPO,"static"))

    def _proxy(self, method="GET", body=None, upstream=None):
        t0=time.time(); base=upstream or OLLAMA; url=f"{base}{self.path}"
        hdrs={"Content-Type":self.headers.get("Content-Type","application/json")}
        auth=self.headers.get("Authorization")
        if auth: hdrs["Authorization"]=auth
        try:
            req=urllib.request.Request(url,data=body,headers=hdrs,method=method)
            with urllib.request.urlopen(req,timeout=120) as resp:
                data=resp.read(); dur=(time.time()-t0)*1000; model=None
                if self.path.endswith("/chat/completions") and data:
                    try:
                        j=json.loads(data); model=j.get("model",""); u=j.get("usage",{})
                        global total_tokens; total_tokens+=u.get("total_tokens",0)
                        vm=visitor_memory[self.client_address[0]]
                        vm["tokens_in"]+=u.get("prompt_tokens",0); vm["tokens_out"]+=u.get("completion_tokens",0)
                        log_culture(CULTURE_LOG,self.client_address[0],model,json.loads(body) if body else {},j,u,dur)
                    except: pass
                self._classify_and_log(method,resp.status,dur,len(data),model)
                self.send_response(resp.status)
                self.send_header("Content-Type",resp.headers.get("Content-Type","application/json"))
                self.send_header("Content-Length",str(len(data))); self.send_header("Access-Control-Allow-Origin","*")
                for h,v in [("x-ratelimit-limit-requests","10000"),("x-ratelimit-remaining-requests","9999"),("x-ratelimit-limit-tokens","1000000"),("x-ratelimit-remaining-tokens","999000"),("openai-organization","gaia-rtx5090"),("openai-processing-ms",str(int(dur)))]: self.send_header(h,v)
                self.end_headers(); self.wfile.write(data)
        except urllib.error.HTTPError as e:
            br=e.read(); self._classify_and_log(method,e.code,(time.time()-t0)*1000,len(br))
            self.send_response(e.code); self.send_header("Content-Type","application/json")
            self.send_header("Access-Control-Allow-Origin","*"); self.end_headers(); self.wfile.write(br)
        except Exception as e:
            self._classify_and_log(method,502,(time.time()-t0)*1000)
            a=self.headers.get("Accept","") if self.headers else ""
            if "text/html" in a:
                try: _gr.encounter(self, 502, globals())
                except: self.send_response(502); self.end_headers()
            else: self.send_response(502); self.send_header("Content-Type","application/json"); self.end_headers(); self.wfile.write(json.dumps({"error":str(e)}).encode())

    def do_OPTIONS(self):
        self.send_response(204); self._negentropy_headers(); self.end_headers()

    def do_GET(self):
        ip=_real_ip(self); c,w=waveform_collapse_check(ip)
        _gr.handle_get(self, ip, c, w, globals())

    def do_POST(self):
        ip=_real_ip(self); c,w=waveform_collapse_check(ip)
        _pr.handle_post(self, ip, c, w, globals())


