                try:
                    with open(sensor_file, encoding="utf-8") as f:
                        sensors = json.load(f)
                except: pass
            # Models from ollama
            models = []
            try:
                req = urllib.request.Request("http://localhost:11434/api/tags")
                with urllib.request.urlopen(req, timeout=3) as resp:
                    tags = json.loads(resp.read())
                    models = [{"id": m["name"]} for m in tags.get("models", [])]
            except: pass
            self._json({
                "pulse": pulse,
                "temporal": temporal,
                "sun": sun,
                "reedit": reedit,
                "neutron": neutron,
                "sensors": sensors,
                "models": {"data": models},
