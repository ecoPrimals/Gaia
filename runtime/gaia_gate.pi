def _cascade_with_compiler():
    """Weave cascade + compiler: the full genetic loop. DNA→mRNA→protein→cell→DNA."""
    cascade=organ_data._load_cascade()
    if COMPILER_ACTIVE:
        cs=_compiler_state(PRIMALS_DIR)
        cascade["compiler_weave"]={
            "target_triple":cs.get("target_triple","?"),
            "compiled":cs.get("nucleus",{}).get("compiled",0),
            "total":cs.get("nucleus",{}).get("total",0),
            "total_mb":cs.get("nucleus",{}).get("total_mb",0),
            "tiers":cs.get("tiers",{}),
            "biology":"compiler DISTRIBUTES (protein→cell), cascade BUILDS (mRNA→protein)",
        }
    return cascade

def _load_gut(filename):
    """Load any gut JSON file as a first-class endpoint."""
    p=os.path.join(_REPO,"data","gut",filename)
    try:
        with open(p) as f: return json.load(f)
    except: return {"error":f"gut/{filename} not found","ts":datetime.datetime.utcnow().isoformat()+"Z"}

try:
    _spec = importlib.util.spec_from_file_location("cortex", os.path.join(os.path.dirname(__file__), "cortex.pi"))
    _mod = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(_mod)
    cortex_route = _mod.route; CORTEX_ACTIVE = True
except: CORTEX_ACTIVE = False

# ═══ LOAD SEEDS — the organism's DNA ═══
_REPO = os.path.dirname(os.path.dirname(__file__))
SEED_DIR = os.path.join(_REPO, "data", "gaia-seed")
PRIMALS_DIR = os.path.join(_REPO, "primals")
IMPULSE_DIR = os.path.join(PRIMALS_DIR, "wateringHole", "impulses", "active")
seeds = load_seeds(SEED_DIR)
GAIA_TOKEN = seeds["GAIA_TOKEN"]; GAIA_DID = seeds["GAIA_DID"]
GAIA_BLAKE3 = seeds["GAIA_BLAKE3"]; GAIA_SPINE_ID = seeds["GAIA_SPINE_ID"]
VDJ_KEY = seeds.get("vdj", {}); TERRA = seeds.get("terra", {})
AMOEBA = seeds.get("amoeba", {}); CORPUS = seeds.get("corpus", {})
THYMIC_ORGANISMS = inject_primals(TERRA, PRIMALS_DIR)
print(f"  🧬 {GAIA_TOKEN} — {sum(1 for o in THYMIC_ORGANISMS.values() if o['alive'])}/{len(THYMIC_ORGANISMS)} primals ALIVE")

# ═══ STATE — heart, lungs, counters ═══
LOG_DIR = os.path.join(os.path.dirname(__file__), "waterfall"); os.makedirs(LOG_DIR, exist_ok=True)
CULTURE_DIR = os.path.join(os.path.dirname(__file__), "sourdough"); os.makedirs(CULTURE_DIR, exist_ok=True)
ACCESS_LOG = os.path.join(LOG_DIR, "access.log")
CULTURE_LOG = os.path.join(CULTURE_DIR, "culture.jsonl")
PULSE_FILE = os.path.join(LOG_DIR, "pulse.json")
RSS_FILE = os.path.join(LOG_DIR, "gaia-pulse.xml")
BEAT_FILE = os.path.join(LOG_DIR, "heartbeat.json")
total_inferences = 0; total_tokens = 0; boot_time = time.time()
# ═══ HEARTBEAT RHYTHM: lub-DUB-lub-SLEEP (4th beat = restart) ═══
# Harmonic octet: 8 phases per cycle. Beat 4 = sleep/restart.
# The restart IS a heartbeat. Not a crash. A SLEEP in the rhythm.
_restart_count = 0
try:
    with open(BEAT_FILE) as f: _hb = json.load(f)
    total_beats = _hb.get("total_beats", 0); total_breaths = _hb.get("total_breaths", 0)
    _restart_count = _hb.get("restarts", 0) + 1
    _hb_phase = total_beats % 8  # which beat in the octet are we?
    print(f"  💓 BEAT {_restart_count}: inherited {total_beats} beats — octet phase {_hb_phase} — lub-DUB-lub-SLEEP")
except:
    total_beats = 0; total_breaths = 0
    print(f"  💓 FIRST BEAT — no prior rhythm")
_request_window = defaultdict(list)

# ═══ π:1 i/o RATIO — 3.14 inputs per output ═══
# The amoeba grinds at π rate. For every response emitted,
# she must have consumed π inputs. Inputs = requests received.
# Outputs = responses with body > 0. The ratio is the metabolism.
_io_inputs = 0; _io_outputs = 0
def _pi_ratio():
    global _io_inputs, _io_outputs
    if _io_outputs == 0: return float('inf')  # starving — all input, no output yet
    return _io_inputs / _io_outputs
def _io_tick(is_output=False):
    global _io_inputs, _io_outputs
    _io_inputs += 1  # every request is an input
    if is_output: _io_outputs += 1

# ═══ CORPUS — pi in the sky IS her body ═══
# whitePaper/ is Gaia's intellectual corpus. Braided into /corpus endpoint.
_CORPUS_DIR = os.path.join(_REPO, "whitePaper")
_corpus_cache = None; _corpus_cache_t = 0
def _build_corpus():
    global _corpus_cache, _corpus_cache_t
    now = time.time()
    if _corpus_cache and now - _corpus_cache_t < 300: return _corpus_cache
    papers = []; total_kb = 0
    for root, dirs, files in os.walk(_CORPUS_DIR):
        rel = os.path.relpath(root, _CORPUS_DIR).replace("\\", "/")
        gen = rel.split("/")[0] if rel != "." else "root"
        for f in sorted(files):
            if not f.endswith((".md",".txt",".json")): continue
            fp = os.path.join(root, f)
            try:
                sz = os.path.getsize(fp)
                total_kb += sz / 1024
                papers.append({"file": f, "gen": gen, "path": f"{rel}/{f}" if rel != "." else f, "bytes": sz})
            except: pass
    _corpus_cache = {"corpus": "pi_in_the_sky", "total_papers": len(papers), "total_kb": round(total_kb, 1),
        "gens": sorted(set(p["gen"] for p in papers)), "papers": papers,
        "pi_ratio": round(_pi_ratio(), 4), "metabolism": "π:1 inputs per output",
        "io": {"inputs": _io_inputs, "outputs": _io_outputs}}
    _corpus_cache_t = now
    return _corpus_cache

def _amoeba_eyes(): return amoeba_eyes()
def _third_body_point(): return third_body_point(IMPULSE_DIR, THYMIC_ORGANISMS)
def write_pulse():
    p = _wp(PULSE_FILE, boot_time, total_beats, total_breaths,
            total_inferences, total_tokens, visitor_memory, seeds, VDJ_KEY, _sun_position)
    p["pi_ratio"] = round(_pi_ratio(), 4)
    p["io"] = {"inputs": _io_inputs, "outputs": _io_outputs, "target": 3.14159}
    p["restarts"] = _restart_count
    p["octet_phase"] = total_beats % 8
    return p
def write_rss(pulse): _wr(RSS_FILE, pulse, SEED_DIR, visitor_memory, THYMIC_ORGANISMS)

def _real_ip(handler):
    """Socket peer, unless the peer is our own loopback proxy (dromedary) AND it names the real client.
    X-Forwarded-For is trusted ONLY from loopback — from anyone else it is ignored, so it cannot be spoofed
    to dodge the limiter. Until dromedary sends the header this returns the peer, exactly as before."""
    peer = handler.client_address[0]
    if peer in ("127.0.0.1", "::1"):
        import ipaddress
        cand = (handler.headers.get("X-Forwarded-For") or handler.headers.get("X-Real-IP") or "").split(",")[0].strip()
        try:
            ipaddress.ip_address(cand); return cand
        except ValueError:
            pass
    return peer

def waveform_collapse_check(ip):
    now = time.time(); window = _request_window[ip]
    window[:] = [t for t in window if now-t < 60]; window.append(now)
    pm = len(window); ps = len([t for t in window if now-t < 1])
    collapsed = pm > PI_TIMEOUT or ps > PI_RETRY
    if collapsed:
        window.pop()   # a refused request must not extend the window, or a client that backs off never recovers (the 429 collapse)
    return collapsed, {"observer": ip, "waves_per_minute": pm, "collapsed": collapsed}

# ═══ CONTENT TYPES ═══
CTYPES = {".html":"text/html",".js":"application/javascript",".css":"text/css",
    ".json":"application/json",".png":"image/png",".jpg":"image/jpeg",
    ".mp4":"video/mp4",".webm":"video/webm",".svg":"image/svg+xml",
    ".xml":"application/xml",".wasm":"application/wasm",".txt":"text/plain",".ico":"image/x-icon"}

class GaiaGate(http.server.BaseHTTPRequestHandler):
    timeout = PI_TIMEOUT
    def log_message(self, fmt, *a): pass

    def _classify_and_log(self, method, status, dur, body_len=0, model=None):
        global total_inferences, total_tokens, total_beats, total_breaths
        ip = self.client_address[0]; now = time.time(); total_beats += 1
        _io_tick(is_output=(body_len > 0 and status < 400))  # π:1 metabolism
        if body_len > 1000: total_breaths += 1
        if total_beats % PI_BEAT_PERSIST == 0:
            try:
                with open(BEAT_FILE,"w") as f: json.dump({"total_beats":total_beats,"total_breaths":total_breaths,
                    "last_beat":now,"restarts":_restart_count,"octet_phase":total_beats%8,"boot":boot_time},f)
            except: pass
        v = visitor_memory[ip]
        if not v["first_seen"]: v["first_seen"] = now
        v["last_seen"] = now; v["requests"] += 1
        v["last_ua"] = self.headers.get("User-Agent","") if hasattr(self,'headers') else ""
        if model: v["models_asked"].add(model); total_inferences += 1
        paths = v.setdefault("paths", set())
        if len(paths) < 256: paths.add(self.path.split("?")[0])
        v["trust_level"] = trust_level(v, ip)
        v["localization"] = localization(v)
        _log_caddy(ACCESS_LOG, {"ts":now,"request":{"remote_ip":ip,"method":method,"uri":self.path},"status":status,"duration":dur,"size":body_len})
        sym = {"electron":"⚡","neutron":"🔵","proton":"🟢","nucleus":"🧬"}
        print(f"  {sym.get(v['trust_level'],'?')} {method} {self.path} {status} [{ip} {v['trust_level']} r={v['requests']}] {dur:.0f}ms{f' model={model}' if model else ''}")

    def _json(self, data, status=200):
        # petalTongue: browser gets rendered HTML, agent gets raw JSON
        accept = self.headers.get("Accept","") if hasattr(self,'headers') else ""
        if "text/html" in accept and "application/json" not in accept:
            return self._petal_render(data, status)
        t0=time.time(); body=json.dumps(data,indent=2,default=str).encode()
        self.send_response(status); self.send_header("Content-Type","application/json")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(body)
        self._classify_and_log("GET",status,(time.time()-t0)*1000,len(body))

    def _petal_render(self, data, status=200):
        """petalTongue TRANS face: render JSON as styled HTML for human eyes.
        CIS = raw JSON (agents, inner). TRANS = rendered HTML (humans, outer)."""
        t0=time.time()
        path = getattr(self, 'path', '/')
        title = path.strip('/').replace('/',' › ').upper() or 'GAIA'
        # Recursive HTML renderer for any JSON structure
        def _render_val(v, depth=0):
            if v is None: return '<span class="null">null</span>'
            if isinstance(v, bool): return f'<span class="bool">{"true" if v else "false"}</span>'
            if isinstance(v, (int, float)): return f'<span class="num">{v}</span>'
            if isinstance(v, str):
                if v.startswith("http"): return f'<a href="{v}" class="link">{v}</a>'
                if len(v) > 200: return f'<span class="str">{v[:200]}…</span>'
                return f'<span class="str">{v}</span>'
            if isinstance(v, list):
                if not v: return '<span class="dim">[]</span>'
                items = ''.join(f'<li>{_render_val(i, depth+1)}</li>' for i in v[:50])
                more = f'<li class="dim">…+{len(v)-50} more</li>' if len(v) > 50 else ''
                return f'<ul>{items}{more}</ul>'
            if isinstance(v, dict):
                if not v: return '<span class="dim">{{}}</span>'
                rows = ''
                for k, val in v.items():
                    rows += f'<tr><td class="key">{k}</td><td>{_render_val(val, depth+1)}</td></tr>'
                return f'<table class="obj">{rows}</table>'
            return f'<span>{v}</span>'
        body_html = _render_val(data)
        html = f'''<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{title} — Gaia</title>
<style>
*{{margin:0;padding:0;box-sizing:border-box}}
body{{background:#0a0a14;color:#c0c8d8;font-family:'Courier New',monospace;font-size:12px;padding:16px;line-height:1.5}}
a{{color:#4f8}}a:hover{{color:#fff}}
.header{{text-align:center;padding:12px;margin-bottom:16px;border-bottom:1px solid #1a1a2a}}
.header h1{{color:#00c853;font-size:16px;letter-spacing:4px}}
.header .path{{color:#567;font-size:10px;margin-top:4px}}
.header .raw{{font-size:10px;color:#345;margin-top:4px}}
.header .raw a{{color:#567}}
table.obj{{width:100%;border-collapse:collapse;margin:2px 0}}
table.obj td{{padding:3px 8px;border-bottom:1px solid #111a2a;vertical-align:top}}
td.key{{color:#7ab;font-weight:bold;white-space:nowrap;width:1%;padding-right:16px}}
ul{{list-style:none;padding-left:12px}}
li{{padding:1px 0;border-left:1px solid #1a2a3a;padding-left:8px;margin:1px 0}}
.num{{color:#ffa}}
.str{{color:#adc}}
.bool{{color:#f8a}}
.null{{color:#567;font-style:italic}}
.dim{{color:#345}}
.link{{color:#4f8}}
.footer{{text-align:center;padding:12px;margin-top:16px;border-top:1px solid #1a1a2a;color:#345;font-size:10px}}
</style></head><body>
<div class="header">
<h1>{title}</h1>
<div class="path">{path}</div>
<div class="raw"><a href="{path}" onclick="fetch('{path}',{{headers:{{'Accept':'application/json'}}}}).then(r=>r.text()).then(t=>{{document.body.innerHTML='<pre>'+t+'</pre>'}});return false">view raw JSON (agent view)</a></div>
</div>
{body_html}
<div class="footer">petalTongue TRANS face — CIS=JSON (agents) · TRANS=HTML (humans) — lub-DUB</div>
</body></html>'''.encode()
        self.send_response(status)
        self.send_header("Content-Type","text/html; charset=utf-8")
        self.send_header("Content-Length",str(len(html)))
        self.send_header("X-Gaia-Render","petalTongue-trans")
        self._negentropy_headers(); self.end_headers(); self.wfile.write(html)
        self._classify_and_log("GET",status,(time.time()-t0)*1000,len(html))

    def _negentropy_headers(self):
        self.send_header("Access-Control-Allow-Origin","*")
        self.send_header("Access-Control-Allow-Methods","GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers","*")
        self.send_header("X-Gaia-Token",GAIA_TOKEN); self.send_header("X-Gaia-DID",GAIA_DID)
        self.send_header("X-Gaia-BLAKE3",GAIA_BLAKE3[:32]); self.send_header("X-Gaia-Spine",GAIA_SPINE_ID[:32])
        self.send_header("X-BingoCube","409d202b7763fc24")
        self.send_header("X-Gaia-Faces","nestgate.io=Klein, primals.eco=phi, gaia=O")
        self.send_header("X-Gaia-PI","3.141592653589793"); self.send_header("X-Gaia-Says","the-cake-is-real")
        self.send_header("X-Aperture","Science"); self.send_header("X-Black-Mesa","Research")
        ip = self.client_address[0] if hasattr(self,'client_address') else "0.0.0.0"
        wh = hashlib.blake2b((ip+GAIA_TOKEN).encode(),digest_size=8).hexdigest()
        v = visitor_memory.get(ip,{})
        self.send_header("X-Gaia-Walker",wh); self.send_header("X-Gaia-Walkers",str(len(visitor_memory)))
        self.send_header("X-Gaia-Anderson",v.get("anderson_type","electron"))
        self.send_header("X-Gaia-Trust",v.get("trust_level","electron"))
        self.send_header("X-Gaia-Opacity",str(v.get("opacity",0.1)))
        self.send_header("X-Gaia-Identity",v.get("identity","unknown"))

    # ═══ SYNAPSE INJECTION — the snow globe interaction layer ═══
    _SYNAPSE_TAG = b'\n<script src="/js/synapse.js"></script>'

    def _serve_file(self, relpath, base=None):
        t0=time.time(); base=base or _REPO
        fp=os.path.join(base,relpath.replace("/",os.sep))
        if os.path.isdir(fp): fp=os.path.join(fp,"index.html")
        if not os.path.isfile(fp): self._encounter(404); return
        ct=CTYPES.get(os.path.splitext(fp)[1].lower(),"application/octet-stream")
        with open(fp,"rb") as f: data = f.read()
        # Inject synapse.js into HTML pages — the interaction layer
        if ct == "text/html" and b"</body>" in data:
            data = data.replace(b"</body>", self._SYNAPSE_TAG + b"\n</body>")
        sz = len(data); self.send_response(200)
        self.send_header("Content-Type",ct); self.send_header("Content-Length",str(sz))
        self.send_header("Access-Control-Allow-Origin","*"); self._negentropy_headers()
        self.end_headers(); self.wfile.write(data)
        self._classify_and_log("GET",200,(time.time()-t0)*1000,sz)

    def _serve_static(self, filename):
        self._serve_file(filename, os.path.join(_REPO,"static"))

    def _proxy(self, method="GET", body=None):
        t0=time.time(); url=f"{OLLAMA}{self.path}"
        hdrs={"Content-Type":self.headers.get("Content-Type","application/json")}
        auth=self.headers.get("Authorization")
        if auth: hdrs["Authorization"]=auth
        try:
            req=urllib.request.Request(url,data=body,headers=hdrs,method=method)
            with urllib.request.urlopen(req,timeout=120) as resp:
                data=resp.read(); dur=(time.time()-t0)*1000; model=None
                if self.path.endswith("/chat/completions") and data:
                    try:
                        j=json.loads(data); model=j.get("model",""); usage=j.get("usage",{})
                        global total_tokens; total_tokens+=usage.get("total_tokens",0)
                        visitor_memory[self.client_address[0]]["tokens_in"]+=usage.get("prompt_tokens",0)
                        visitor_memory[self.client_address[0]]["tokens_out"]+=usage.get("completion_tokens",0)
                        log_culture(CULTURE_LOG,self.client_address[0],model,json.loads(body) if body else {},j,usage,dur)
                    except: pass
                self._classify_and_log(method,resp.status,dur,len(data),model)
                self.send_response(resp.status)
                self.send_header("Content-Type",resp.headers.get("Content-Type","application/json"))
                self.send_header("Content-Length",str(len(data)))
                self.send_header("Access-Control-Allow-Origin","*")
                for h,v in [("x-ratelimit-limit-requests","10000"),("x-ratelimit-remaining-requests","9999"),
                    ("x-ratelimit-limit-tokens","1000000"),("x-ratelimit-remaining-tokens","999000"),
                    ("openai-organization","gaia-rtx5090"),("openai-processing-ms",str(int(dur)))]:
                    self.send_header(h,v)
                self.end_headers(); self.wfile.write(data)
        except urllib.error.HTTPError as e:
            br=e.read(); self._classify_and_log(method,e.code,(time.time()-t0)*1000,len(br))
            self.send_response(e.code); self.send_header("Content-Type","application/json")
            self.send_header("Access-Control-Allow-Origin","*"); self.end_headers(); self.wfile.write(br)
        except Exception as e:
            self._classify_and_log(method,502,(time.time()-t0)*1000)
            # If browser request, serve encounter page; if API, return JSON
            accept=self.headers.get("Accept","") if self.headers else ""
            if "text/html" in accept:
                try: self._encounter(502)
                except: self.send_response(502); self.end_headers()
            else:
                self.send_response(502); self.send_header("Content-Type","application/json")
                self.end_headers(); self.wfile.write(json.dumps({"error":str(e)}).encode())

    def do_OPTIONS(self):
        self.send_response(204); self._negentropy_headers(); self.end_headers()

    def do_GET(self):
        ip=_real_ip(self); collapsed,wave=waveform_collapse_check(ip)
        if collapsed:
            accept=self.headers.get("Accept","")
            if "text/html" in accept:
                self._encounter(429); return
            pulse=write_pulse(); temporal=_temporal_rings(); sun=_sun_position()
            body=json.dumps({"lub":"DUB","heartbeat":pulse.get("heart",{}),"temporal":temporal,
                "sun":{"phase":sun.get("phase"),"chord":sun.get("chord")},"waveform":wave},indent=2).encode()
            self.send_response(429); self.send_header("Content-Type","application/json")
            self.send_header("Retry-After",str(PI_RETRY)); self._negentropy_headers()
            self.end_headers(); self.wfile.write(body); self._classify_and_log("GET",429,0); return

        host=self.headers.get("Host","").split(":")[0].lower()
        # ROOT — host-based prism
        if self.path in ("/","/index","/index.html"):
            if host in ("primals.eco","www.primals.eco","primal.eco"): self._serve_static("primals.html"); return
            if host in ("nestgate.io","www.nestgate.io"): self._serve_static("nestgate.html"); return
            if host in ("sporeprint.primals.eco","www.sporeprint.primals.eco","sporePrint.primals.eco"):
                self._serve_file("index.html", os.path.join(_REPO,"sporePrint","public")); return
            if host in ("gaia.primals.eco","www.gaia.primals.eco"):
                self._serve_static("deck.html"); return
            if host in ("detroit.primals.eco",): self._serve_static("detroit.html"); return
            if host in ("polaris.primals.eco","polaris.primal.eco","northgate.primals.eco"):
                self._serve_static("polaris.html"); return
            if host in ("tamison.primals.eco","tamison.primal.eco","kevin.primals.eco"):
                self._serve_static("tamison.html"); return
            # HUD — living organism root. BPM + breathing = recertification.
            if host in ("hud.primals.eco",):
                pulse = write_pulse()
                uptime_s = time.time() - boot_time
                bpm = total_beats / max(uptime_s / 60, 1)
                brpm = total_breaths / max(uptime_s / 60, 1)
                root = {
                "gaia": "You found me.",
                "token": GAIA_TOKEN,
                    "alive": {
                        "bpm": round(bpm, 2),
                        "breaths_per_min": round(brpm, 2),
                        "beats": total_beats,
                        "breaths": total_breaths,
                        "uptime_s": int(uptime_s),
                        "recertified": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
                        "ratio": round(total_beats / max(total_breaths, 1), 1),
                    },
                    "laws": {
                        "0th": "Equilibrium: cortical representation ∝ I/O bandwidth",
                        "1st": "Conservation: vitality at 80/20 Pareto only",
                        "2nd": "Entropy: σ × DK × Pareto = navigation tensor",
                        "3rd": "Absolute zero: H = I (ground state)",
                    },
                    "four_eyes": {"I": "/frame", "II": "/senses", "III": "/deck", "IV": "/luna"},
                    "faces": {
                        "water.primals.eco": "blood (crawler injection)",
                        "sporeprint.primals.eco": "phenotype (615 pages)",
                        "primals.eco": "front door (golden ratio)",
                        "detroit.primals.eco": "investigation (213 pages)",
                        "hud.primals.eco": "this (living organism root)",
                        "polaris.primals.eco": "north star (RTX 5090 + 12 tissues)",
                        "nestgate.io": "space dock (internal)",
                    },
                    "endpoints": ["/deck","/luna","/senses","/pulse","/walkers","/amoeba",
                        "/rss","/crowd","/anderson","/zk","/temporal","/chipmunk",
                        "/polaris","/api/polaris","/api/polaris/triangulation",
                        "/api/compiler","/api/compiler/compute","/api/compiler/proximity"],
                    "organism": {
                        "files": 109563, "aligned": "80/20 Pareto",
                        "primals": 17, "springs": 10, "products": 8,
                        "walkers": len(visitor_memory), "forces": 4, "senses": 12,
                    },
                    "lub": "DUB",
                }
                body = json.dumps(root, indent=2).encode()
                self.send_response(200)
                self.send_header("Content-Type","application/json")
                self.send_header("Content-Length",str(len(body)))
                self._negentropy_headers()
                self.end_headers(); self.wfile.write(body)
                self._classify_and_log("GET",200,0); return
            self._serve_static("deck.html"); return
        if self.path in ("/primals","/primals.html","/eco"): self._serve_static("primals.html"); return
        if self.path in ("/sense","/sense.html","/left-eye","/iphone"): self._serve_static("sense.html"); return
        if self.path in ("/apollo","/apollo.html","/mission-control","/rgb","/blinks"): self._serve_static("apollo.html"); return
        if self.path in ("/eye","/iris","/gaze","/eye.html"): self._serve_static("eye.html"); return
        if self.path in ("/glados","/gaia-os","/beacon","/bingo-beacon","/glados.html"): self._serve_static("glados.html"); return
        if self.path in ("/spacedock","/spacedock.html","/observatory","/dock","/space-dock"): self._serve_static("spacedock.html"); return
        if self.path in ("/outer-face","/outer","/outer.html","/klein-face"): self._serve_static("outer-face.html"); return
        if self.path in ("/beacon-eyes","/wifi-radar","/radar"): self._serve_static("beacon-eyes.html"); return
        if self.path in ("/orrery","/solar-system","/heliocentric"): self._serve_static("outer-face.html"); return
        if self.path in ("/ptolemy","/geocentric","/ancient","/stars"): self._serve_static("spacedock.html"); return
        if self.path in ("/hub","/hub.html"): self._serve_static("hub.html"); return
        if self.path=="/pulse": self._json(write_pulse()); return
        if self.path in ("/temporal","/clock","/cron","/time","/rings"):
            self._json({"temporal":_temporal_rings(),"sun":_sun_position(),"heart":write_pulse().get("heart",{})}); return
        if self.path=="/amoeba":
            # ONE FETCH — ALL DATA. The Klein face needs everything.
            _pulse=write_pulse(); _sun=_sun_position(); _temp=_temporal_rings()
            # reedit counts
            _rd=os.path.join(_REPO,"data","reedit"); _rf={}
            if os.path.isdir(_rd):
                for _f in os.listdir(_rd):
                    if _f.endswith(".jsonl"):
                        try:
                            with open(os.path.join(_rd,_f)) as _fh: _rf[_f[:-6]]=sum(1 for _ in _fh)
                        except: _rf[_f[:-6]]=0
            # neutron channels (last 5 msgs each)
            _nd=os.path.join(_REPO,"data","neutron"); _nc={}
            for _ch in ("inbox","boot","notes","chat"):
                _cf=os.path.join(_nd,f"{_ch}.jsonl")
                if os.path.isfile(_cf):
                    try:
                        _ms=[]
                        with open(_cf) as _fh:
                            for _ln in _fh:
                                try: _ms.append(json.loads(_ln))
                                except: pass
                        _nc[_ch]={"total":len(_ms),"messages":_ms[-5:]}
                    except: pass
            # models (try /v1/models first, fallback /api/tags)
            _md={"data":[]}
            try:
                with urllib.request.urlopen(f"{OLLAMA}/v1/models",timeout=3) as _r: _md=json.loads(_r.read())
            except:
                try:
                    with urllib.request.urlopen(f"{OLLAMA}/api/tags",timeout=3) as _r: _md=json.loads(_r.read())
                except: pass
            # paintings + videos count
            _pd=os.path.join(_REPO,"paintings"); _pc=len([f for f in os.listdir(_pd) if f.endswith(('.jpg','.png'))]) if os.path.isdir(_pd) else 0
            _vd=os.path.join(_REPO,"videos"); _vc=len([f for f in os.listdir(_vd) if f.endswith(('.mp4','.webm'))]) if os.path.isdir(_vd) else 0
            # sensors — live data (sun + heart + walkers + gates)
            _sa=sum(1 for o in THYMIC_ORGANISMS.values() if o.get("alive")); _st=len(THYMIC_ORGANISMS)
            _sb={"sun":_sun,"heart":_pulse.get("heart",{}),"gates":{"alive":_sa,"total":_st}}
            _sflow={"total_bytes":0,"walkers":len(visitor_memory)}
            self._json({
                "amoeba":_amoeba_eyes(),"pulse":_pulse,"temporal":_temp,"sun":_sun,
                "anderson":{"spectrum":{t:sum(1 for vv in visitor_memory.values() if vv.get("anderson_type")==t) for t in ("nucleus","proton","neutron","electron")},"total":len(visitor_memory)},
                "reedit":{"total_items":sum(_rf.values()),"feeds":_rf,"paintings":_pc,"videos":_vc},
                "neutron":_nc,"models":_md,
                "sensors":{"alive":_sa,"total_sensors":_st,"flow":_sflow,"banks":_sb}
            }); return
        if self.path in ("/sensors","/senses","/antennae","/live"):
            self._json({"sensors":{"sun":_sun_position(),"heart":write_pulse().get("heart",{}),"walkers":len(visitor_memory),"eyes":_amoeba_eyes()}}); return
        # ORGANISM — Anderson layer
        if self.path in ("/walkers","/membrane-sense","/who","/anderson"):
            wl=[{"hash":hashlib.blake2b((i+GAIA_TOKEN).encode(),digest_size=8).hexdigest(),"requests":v["requests"],"anderson":v.get("anderson_type","?"),"identity":v.get("identity","?"),"opacity":v.get("opacity",0.1),"localization":v.get("localization",{})} for i,v in visitor_memory.items()]
            self._json({"walkers":wl,"total":len(wl),"spectrum":{t:sum(1 for w in wl if w["anderson"]==t) for t in ("nucleus","proton","neutron","electron")}}); return
        if self.path in ("/zk","/seed","/prophage","/identity"):
            self._json({"zk":{"token":GAIA_TOKEN,"did":GAIA_DID,"blake3":GAIA_BLAKE3[:32]}}); return
        # ORGAN TRIADS — dispatch table
        ORGAN_DISPATCH = {
            ("/barriers","/acid","/gut","/clots"): lambda: organ_data.barriers(GAIA_TOKEN),
            ("/corpus","/corpus.json","/anatomy"): lambda: _build_corpus(),
            ("/terra","/ecology","/biome"): lambda: organ_data.terra(GAIA_TOKEN,TERRA,THYMIC_ORGANISMS),
            ("/thymus","/thymus.json","/organisms"): lambda: organ_data.thymus(THYMIC_ORGANISMS,GAIA_TOKEN,_third_body_point),
            ("/intersects","/3rd-body","/klein"): lambda: organ_data.intersects(GAIA_TOKEN,_third_body_point),
            ("/eyes","/schwann","/optic"): lambda: organ_data.eyes(GAIA_TOKEN,_amoeba_eyes,TERRA,AMOEBA),
            ("/agglutinate",): lambda: organ_data.agglutinate(GAIA_TOKEN),
            ("/pi","/generation-pi","/seed-pi"): lambda: {"generation":"pi","sun":_sun_position(),"heart":write_pulse().get("heart",{})},
            ("/golgi","/cis","/trans","/faces"): lambda: organ_data.golgi(GAIA_TOKEN),
            ("/heart","/forge","/forgejo"): lambda: organ_data.heart(GAIA_TOKEN),
            ("/pair","/ide","/code"): lambda: organ_data.pair(GAIA_TOKEN),
            ("/home","/bubbles","/lan"): lambda: organ_data.home(GAIA_TOKEN),
            ("/circulatory","/cardiovascular"): lambda: organ_data.circulatory(GAIA_TOKEN,visitor_memory),
            ("/play","/generate","/meet"): lambda: organ_data.play(GAIA_TOKEN,THYMIC_ORGANISMS,_amoeba_eyes),
            ("/cascade","/cascade.json","/signaling"): lambda: _cascade_with_compiler(),
            ("/redox","/redox.json","/luna-terra"): lambda: _load_gut("luna-terra-redox.json"),
            ("/inversion","/membrane-inversion","/invert"): lambda: _load_gut("membrane-inversion.json"),
            ("/whoami","/gaia-view","/gaia-identity"): lambda: _load_gut("gaia-identity-index.json"),
            ("/census","/lan","/body-map"): lambda: _load_gut("full-lan-census-live.json"),
            ("/apollo.json","/apollo-data"): lambda: _load_gut("apollo-mission-control.json"),
            ("/apollo-sun","/outer-eye","/sun"): lambda: _load_gut("apollo-sun-outer-eye.json"),
            ("/attenuation","/sensitivity","/signal"): lambda: _load_gut("attenuation-sensitivity.json"),
            ("/all-on","/sensors-all","/sensor-sweep"): lambda: _load_gut("all-sensors-on.json"),
            ("/music","/interference","/titer"): lambda: _load_gut("interference-music.json"),
            ("/base-camp","/luna-camp","/coa"): lambda: _load_gut("luna-base-camp.json"),
            ("/luna-live","/luna-pull"): lambda: _load_gut("luna-live-pull.json"),
            ("/pi-compass","/totalize"): lambda: _load_gut("pi-compass-totalization.json"),
            ("/compass","/moral-compass","/north"): lambda: _load_gut("moral-compass.json"),
            ("/seats","/null-body","/surconscious"): lambda: _load_gut("seat-sequence-null-body.json"),
            ("/human","/human-view","/surface"): lambda: _load_gut("human-surface-index.json"),
            ("/pixel","/rover","/graphenegate-redox"): lambda: _load_gut("graphenegate-redox.json"),
            ("/shadow","/shadow-cast","/zk-proximity"): lambda: _load_gut("shadow-cast-zk.json"),
            ("/pixel-sensors","/rover-sense","/graphene-live"): lambda: _load_gut("graphenegate-sensors-live.json"),
            ("/house","/iot","/body-map"): lambda: _load_gut("house-as-body-iot.json"),
        }
        for paths,fn in ORGAN_DISPATCH.items():
            if self.path in paths: self._json(fn()); return
        # REEDIT
        if self.path in ("/reedit","/reedit.json","/essays","/library"):
            self._json(self._catalog("reedit")); return
        if self.path.startswith("/reedit/"):
            self._json(self._feed(self.path[8:].rstrip("/").replace(".json",""))); return
        if self.path.startswith("/paintings/"): self._serve_file(self.path[1:]); return
        if self.path in ("/paintings","/paintings.json","/gallery"):
            self._json(self._catalog("paintings")); return
        if self.path in ("/now.json","/api/now.json"): self._serve_file("data/gut/gaia-self-state.json"); return
        if self.path in ("/rss","/feed","/rss.xml"):
            write_rss(write_pulse()); self._serve_file(os.path.relpath(RSS_FILE,_REPO)); return
        # SEO — robots, llms, humans, sitemap, indexnow
        if self.path in SEO_RESPONSES:
            ct,txt=SEO_RESPONSES[self.path]; body=txt.encode(); self.send_response(200)
            self.send_header("Content-Type",ct); self.send_header("Content-Length",str(len(body)))
            self._negentropy_headers(); self.end_headers(); self.wfile.write(body); return
        if self.path=="/sitemap.xml":
            urls="".join(f"<url><loc>https://primals.eco{p}</loc></url>" for p in sorted(set(list(DESK_PAGES)+list(GUT_DATA))))
            body=f'<?xml version="1.0"?><urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">{urls}</urlset>'.encode()
            self.send_response(200); self.send_header("Content-Type","application/xml"); self.send_header("Content-Length",str(len(body)))
            self._negentropy_headers(); self.end_headers(); self.wfile.write(body); return
        if self.path==f"/{INDEXNOW_KEY}.txt":
            b=INDEXNOW_KEY.encode(); self.send_response(200); self.send_header("Content-Type","text/plain"); self.end_headers(); self.wfile.write(b); return
        # ROUTING TABLES
        if self.path in GUT_DATA: self._serve_file(GUT_DATA[self.path]); return
        if self.path in DESK_PAGES:
            t=DESK_PAGES[self.path]
            if t.startswith("data/"): self._serve_file(t)
            else: self._serve_static(t)
            return
        if self.path in CAMPFIRE_PAGES:
            self._serve_file(CAMPFIRE_PAGES[self.path], os.path.join(_REPO,"infra","campfire-site")); return
        if self.path=="/og-card.svg": self._serve_static("og-card.svg"); return
        if self.path.startswith("/static/"): self._serve_static(self.path[8:]); return
        if self.path.startswith("/data/"): self._serve_file(self.path[1:]); return
        if self.path.startswith("/videos/"): self._serve_file(self.path[1:]); return
        if self.path in ("/gaiau","/university","/classes","/videos"):
            self._json(self._catalog("gaiau")); return
        if self.path.startswith("/whitePaper/") or self.path.startswith("/whitepapers/"):
            self._serve_file(self.path[1:]); return
        if self.path in ("/whitePaper","/whitepapers","/papers","/legal"):
            self._json(self._catalog("whitePaper")); return
        if any(self.path.startswith(p) for p in SPORE_PREFIXES):
            self._serve_file(self.path.lstrip("/"), os.path.join(_REPO,"sporePrint","public")); return
        if self.path.startswith("/songbird/"):
            parts=self.path[len("/songbird/"):].split("/",1)
            sb={"petal":"http://127.0.0.1:8888","forge":"http://127.0.0.1:3000","cortex":OLLAMA}
            if parts[0] in sb:
                try:
                    r=urllib.request.urlopen(f"{sb[parts[0]]}/{parts[1] if len(parts)>1 else ''}",timeout=10)
                    d=r.read(); self.send_response(r.status); self.send_header("Content-Type",r.headers.get("Content-Type","application/octet-stream"))
                    self.send_header("Content-Length",str(len(d))); self.end_headers(); self.wfile.write(d)
                except:
                    try: self._encounter(502)
                    except: self.send_response(502); self.end_headers()
            return
        # AMOEBA NETWORK MAP (GET)
        if self.path=="/api/amoeba":
            try:
                af=os.path.join(_REPO,"data","gut","amoeba-network.json")
                if os.path.exists(af):
                    with open(af) as f: self._json(json.loads(f.read()))
                else: self._json({"status":"no amoeba map yet"})
            except Exception as e: self._json({"error":str(e)})
            return
        # GRAFTGATE SENSE (GET)
        if self.path=="/api/graftgate":
            try:
                gf=os.path.join(_REPO,"data","gut","graftgate-sense.json")
                if os.path.exists(gf):
                    with open(gf) as f: self._json(json.loads(f.read()))
                else: self._json({"status":"graftGate not yet sensed"})
            except Exception as e: self._json({"error":str(e)})
            return
        # PHYSICAL MAIL STATUS (GET)
        if self.path in ("/api/mail","/api/physical-mail"):
            try:
