def _scan_impulses():
    """Scan active impulses for intersections.
    An impulse intersect = two primals referenced in the same impulse.
    The 3rd body point = the intersection itself."""
    intersects = []
    try:
        for fname in os.listdir(IMPULSE_DIR):
            if not fname.endswith(".toml"):
                continue
            fpath = os.path.join(IMPULSE_DIR, fname)
            with open(fpath, "r", encoding="utf-8") as f:
                content = f.read().lower()
            touched = []
            for pname in THYMIC_ORGANISMS:
                if pname.lower() in content:
                    touched.append(pname)
            if len(touched) >= 2:
                intersects.append({
                    "impulse": fname,
                    "primals": touched,
                    "order": len(touched),
                    "third_body": f"{touched[0]}×{touched[1]}" if len(touched) >= 2 else None,
                })
    except Exception:
        pass
    return intersects

def _third_body_point():
    """The 3rd body point: where inner (AMOEBA) meets outer (cellMembrane).
    Klein face topology — two surfaces, one intersection, the third body.
    Every impulse that touches 2+ primals IS a 3rd-body event."""
    intersects = _scan_impulses()
    eyes = _amoeba_eyes()
    return {
        "topology": "klein_face",
        "inner_surface": "AMOEBA (Schwann cells, ZK myelin)",
        "outer_surface": "cellMembrane (Caddy, TLS, public)",
        "intersection": "the 3rd body — where sessions meet membranes",
        "impulse_intersects": intersects,
        "total_intersects": len(intersects),
        "eyes": eyes.get("status", "UNKNOWN"),
        "organisms_alive": sum(1 for o in THYMIC_ORGANISMS.values() if o["alive"]),
        "organisms_total": len(THYMIC_ORGANISMS),
    }

