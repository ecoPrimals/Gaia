                else: self._json({"error":"polaris-ferment.json not yet generated","hint":"run runtime/sourdough/polaris_ferment.pi on northGate"})
            except Exception as e: self._json({"error":str(e)})
            return
        if self.path in ("/api/polaris/triangulation","/api/polaris/field","/api/triangulate"):
