        if self.path in ("/api/compiler","/api/plasmid","/api/body-printer"):
            if COMPILER_ACTIVE:
                state=_compiler_state(PRIMALS_DIR)
                try:
                    with open(os.path.join(_REPO,"data","gut","cascade-state.json")) as f: cascade=json.load(f)
                    state["cascade_weave"]={
                        "forge":"sporeGate","sync":cascade.get("cascade_phases",{}).get("temporal_sync",{}).get("repos_synced",0),
                        "harvest_built":cascade.get("cascade_phases",{}).get("harvest",{}).get("primals_built",0),
                        "rootpulse":cascade.get("cascade_phases",{}).get("rootpulse_commit",{}).get("status","unknown"),
                        "membrane_services":cascade.get("membrane_health",{}).get("total_running",0),
                        "biology":"cascade BUILDS (mRNA→protein), compiler DISTRIBUTES (protein→cell)",
                    }
                except: state["cascade_weave"]={"status":"cascade state unavailable"}
                self._json(state)
            else:
                self._json({"error":"compiler organ not loaded","compiled":False})
            return
