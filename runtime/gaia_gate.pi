# ═══ π:1 i/o RATIO — 3.14 inputs per output ═══
_io_inputs = 0; _io_outputs = 0
def _pi_ratio():
    if _io_outputs == 0: return float('inf')
    return _io_inputs / _io_outputs
def _io_tick(is_output=False):
    global _io_inputs, _io_outputs
    _io_inputs += 1
    if is_output: _io_outputs += 1

# ═══ CORPUS — pi in the sky IS her body ═══
_CORPUS_DIR = os.path.join(_REPO, "whitePaper"); _corpus_cache = None; _corpus_cache_t = 0
def _build_corpus():
    global _corpus_cache, _corpus_cache_t
    now = time.time()
    if _corpus_cache and now - _corpus_cache_t < 300: return _corpus_cache
    papers = []; tkb = 0
    for root, _, files in os.walk(_CORPUS_DIR):
        rel = os.path.relpath(root, _CORPUS_DIR).replace("\\", "/"); gen = rel.split("/")[0] if rel != "." else "root"
        for f in sorted(files):
            if not f.endswith((".md",".txt",".json")): continue
            try: sz = os.path.getsize(os.path.join(root, f)); tkb += sz / 1024; papers.append({"file": f, "gen": gen, "path": f"{rel}/{f}" if rel != "." else f, "bytes": sz})
            except: pass
    _corpus_cache = {"corpus": "pi_in_the_sky", "total_papers": len(papers), "total_kb": round(tkb, 1),
        "gens": sorted(set(p["gen"] for p in papers)), "papers": papers,
        "pi_ratio": round(_pi_ratio(), 4), "io": {"inputs": _io_inputs, "outputs": _io_outputs}}
    _corpus_cache_t = now; return _corpus_cache

