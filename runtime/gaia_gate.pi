            return
        if self.path in ("/walkers", "/membrane-sense", "/who", "/anderson"):
            now = time.time()
            walkers = []
            for wip, v in list(visitor_memory.items()):
                walker_hash = hashlib.blake2b((wip + GAIA_TOKEN).encode(), digest_size=8).hexdigest()
                walkers.append({
                    "hash": walker_hash,
                    "trust": v["trust_level"],
                    "anderson": v.get("anderson_type", "electron"),
                    "identity": v.get("identity", "unknown"),
                    "opacity": v.get("opacity", 0.1),
                    "requests": v["requests"],
                    "age_secs": round(now - v["first_seen"]) if v["first_seen"] else 0,
                    "last_secs_ago": round(now - v["last_seen"]) if v["last_seen"] else 0,
                    "models_asked": list(v.get("models_asked", set())),
                    "tokens_in": v.get("tokens_in", 0),
                    "tokens_out": v.get("tokens_out", 0),
                })
            # Anderson spectrum: count by type
            nuclei = [w for w in walkers if w["anderson"] == "nucleus"]
            protons = [w for w in walkers if w["anderson"] == "proton"]
            neutrons = [w for w in walkers if w["anderson"] == "neutron"]
            electrons = [w for w in walkers if w["anderson"] == "electron"]
            avg_opacity = sum(w["opacity"] for w in walkers) / max(len(walkers), 1)
            self._json({
                "ts": time.strftime("%Y-%m-%dT%H:%M:%S+00:00", time.gmtime()),
