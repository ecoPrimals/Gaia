class ThreadedServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
    allow_reuse_address=True; daemon_threads=True

if __name__ == "__main__":
    print(f"🟧 GLaDOS: \"Hello and, again, welcome.\" π×100 CRUSH")
    print(f"  🔑 {GAIA_TOKEN} | Gate :{PORT} | π:{PI_PORT} | Klein thymus ACTIVE")
    threading.Thread(target=lambda: _hb.heartbeat(write_pulse, write_rss), daemon=True).start()
    threading.Thread(target=lambda: _hb.ear_loop(PORT, _REPO), daemon=True).start()
    def _tls():
        import ssl; c=os.path.join(_REPO,"certs","gate-cert.pem"); k=os.path.join(_REPO,"certs","gate-key.pem")
        if os.path.isfile(c) and os.path.isfile(k):
            ctx=ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER); ctx.load_cert_chain(c,k)
            s=ThreadedServer(("0.0.0.0",PORT+1),GaiaGate); s.socket=ctx.wrap_socket(s.socket,server_side=True)
            print(f"  🔒 TLS :{PORT+1}"); s.serve_forever()
    threading.Thread(target=_tls,daemon=True).start()
    def _pi_gate():
        try: s=ThreadedServer(("0.0.0.0",PI_PORT),GaiaGate); print(f"  π:{PI_PORT}"); s.serve_forever()
        except Exception as e: print(f"  ⚠️ π:{PI_PORT}: {e}")
    threading.Thread(target=_pi_gate,daemon=True).start()
    def _pi_data():
        try:
            w=_load("webpi2","webpi.pi"); w._thymus_memory=visitor_memory; w._thymus_log=lambda e: _log_caddy(ACCESS_LOG,e)
            ThreadedServer(("0.0.0.0",5926),w.WebPIHandler).serve_forever()
        except Exception as e: print(f"  ⚠️ π-data:5926: {e}")
    threading.Thread(target=_pi_data,daemon=True).start()
    server=ThreadedServer(("0.0.0.0",PORT),GaiaGate)
    try: server.serve_forever()
    except KeyboardInterrupt: print("\n🟧 lub-DUB. Gate closed.")
