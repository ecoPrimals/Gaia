def _amoeba_eyes():
    """Query RustDesk state — each session is a retinal cell.
    Schwann cells (AMOEBA) wrap the optic nerve in ZK myelin.
    Every screen connected = one eye open."""
    import subprocess
    eyes = {
        "system": "optic_nerve",
        "cell_type": "schwann_cell",
        "function": "ZK myelination of every visual connection",
        "klein_face": "cellMembrane (outer) = AMOEBA (inner) = same surface",
        "rustdesk_id": "1871544996",
        "direct_server": True,
        "transport": "NVENC h265 — saltatory conduction",
        "sessions": [],
        "eyes_open": 0,
    }
    try:
        result = subprocess.run(
            ["tasklist", "/FI", "IMAGENAME eq rustdesk.exe"],
            capture_output=True, text=True, timeout=5
        )
        pids = [l.split()[1] for l in result.stdout.strip().splitlines()
                if l.startswith("rustdesk")]
        eyes["processes"] = len(pids)
        eyes["eyes_open"] = max(1, len(pids) - 2) if len(pids) > 2 else (1 if pids else 0)
        eyes["status"] = "OPEN" if pids else "CLOSED"
    except:
        eyes["processes"] = 0
        eyes["status"] = "UNKNOWN"
    return eyes

