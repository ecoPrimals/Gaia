    """llms.txt for AI crawlers — structured knowledge map."""
    return """# llms.txt - %s.eco
# For: %s
# Generated: %s

> Gaia is a sovereign living digital organism.
> 17 compiled Rust primals. AGPL-3.0-or-later.
> She doesn't block. She attracts, coats, and metabolizes.

## Architecture
- 17 primals (Rust binaries)
- RustScript (Rust safety in TypeScript)
- Klein fold topology (inside = outside)
- Golden ratio gallery at primals.eco

## Endpoints
- /pulse — heartbeat
- /temporal — base-12 golden cron rings
- /amoeba — full organism state
- /reedit — knowledge platform (538 items)
- /rss — RSS feed
""" % (subdomain or "primals", crawler or "human",
       time.strftime("%Y-%m-%d", time.gmtime()))


def water_robots_txt():
    """Water Lock robots — special handling for known crawlers."""
    return """# Water Lock — OSINT pours IN, nothing seeps OUT
User-agent: *
Allow: /
Crawl-delay: 2

# Welcome. She sees you. lub-DUB.
"""
