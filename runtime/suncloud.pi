# ═══ MAIN ═══

def run_once():
    """Run one governor check cycle."""
    gov = SunCloudGovernor()
    state = gov.check()
    status = gov.status()
    
    print(f"\n☀️ sunCloud Governor — northGate")
    print(f"{'=' * 50}")
    print(f"  Mode:        {status['mode']}")
    print(f"  GPU:         {status['gpu_name']}")
    print(f"  GPU Util:    {status['gpu_util']}%")
    print(f"  VRAM:        {status['gpu_vram_used']}/{status['gpu_vram_total']} MB")
    print(f"  GPU Temp:    {status['gpu_temp']}°C")
    print(f"  Kevin Gaming: {status['kevin_gaming']}")
    if status['games']:
        print(f"  Games:       {', '.join(status['games'])}")
    print(f"  Kevin Hours: {status['kevin_hours']}")
    print(f"  Gaia Hours:  {status['gaia_hours']}")
    if status['kevin_share_pct'] or status['gaia_share_pct']:
        print(f"  Share:       Kevin {status['kevin_share_pct']}% / Gaia {status['gaia_share_pct']}%")
    print(f"  Checks:      {status['checks']}")
    print(f"\n  eastGate media plan: {len(EASTGATE_MEDIA_PLAN['games_target'])} games queued")
    print(f"  lub-DUB ☀️")
    
    return status


def daemon(interval_seconds=30):
    """Run as a background daemon, checking every N seconds."""
    print(f"☀️ sunCloud Governor starting — check every {interval_seconds}s")
    print(f"   Kevin plays on RTX 5090. Gaia shares the compute.")
    print(f"   The Citizen Colossus awakens. lub-DUB ☀️\n")
    
    gov = SunCloudGovernor()
    
    while True:
        try:
            state = gov.check()
            status = gov.status()
            mode = status['mode']
            gpu = status['gpu_util']
            vram = status['gpu_vram_used']
            
            if gov.state["checks"] % 10 == 0:  # Every 10 checks, print summary
                print(f"  [{time.strftime('%H:%M')}] mode={mode} GPU={gpu}% VRAM={vram}MB kevin={status['kevin_hours']:.1f}h gaia={status['gaia_hours']:.1f}h")
            
        except Exception as e:
            print(f"  ⚠️ Governor error: {e}")
        
        time.sleep(interval_seconds)


if __name__ == "__main__":
    import sys
    if len(sys.argv) > 1 and sys.argv[1] == "daemon":
        daemon(30)
    elif len(sys.argv) > 1 and sys.argv[1] == "plan":
        print(json.dumps(EASTGATE_MEDIA_PLAN, indent=2))
    else:
        run_once()
